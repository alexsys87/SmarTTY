<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.LocalRepoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="Local OpenWrt Repository" Width="660" Height="600" MinWidth="520" MinHeight="480" WindowStartupLocation="CenterOwner">
  <Grid Margin="8">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="Margin" Value="3" />
          <Setter Property="Padding" Value="8 3 8 3" />
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0 0 0 8" Text="Serves OpenWrt packages built on this computer to the device of this SSH connection. The server listens on this computer only; the device reaches it through a reverse SSH tunnel as http://127.0.0.1:PORT and gets the feeds in /etc/opkg/customfeeds.conf (opkg) or /etc/apk/repositories.d/customfeeds.list (apk, OpenWrt 25.12 and newer). After starting, open the package manager, press Refresh and install the packages as usual." />
    <TextBlock Grid.Row="1" TextWrapping="Wrap" Text="Package folders: the build output with the feeds, e.g. bin/packages/&lt;arch&gt; (base, packages, luci ...; .ipk with a Packages index for opkg, .apk with packages.adb for apk) and bin/targets/&lt;target&gt;/&lt;subtarget&gt;/packages. For a build in WSL use a path like \\wsl.localhost\Ubuntu\home\user\openwrt\bin\packages\arm_cortex-a9_neon." />
    <Grid Grid.Row="2" Margin="0 4 0 0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="FolderBox" Grid.Column="0" Margin="3" VerticalContentAlignment="Center" KeyDown="FolderBox_KeyDown" ToolTip="Type or paste a folder, then press Add (Enter), e.g. D:\openwrt\bin\packages\arm_cortex-a9_neon or \\wsl.localhost\Ubuntu-24.04\home\alex\openwrt\bin\targets\zynq\generic\packages. Quotes around the path (Explorer's Copy as path) are fine. Esc stops editing an entry of the list." />
      <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Click="Browse_Click" ToolTip="Pick a folder in the tree. The tree does not show WSL distributions: type that path into the box instead." />
      <Button x:Name="AddButton" Grid.Column="2" Content="Add" Click="Add_Click" ToolTip="Add the folder in the box to the list; while an entry is being edited this replaces it" />
      <Button x:Name="EditButton" Grid.Column="3" Content="Edit selected" Click="Edit_Click" ToolTip="Put the selected folder into the box to change it (double click or F2 in the list); Add then replaces it" />
      <Button x:Name="RemoveButton" Grid.Column="4" Content="Remove selected" Click="Remove_Click" />
    </Grid>
    <ListBox x:Name="FoldersList" Grid.Row="3" Height="90" Margin="3" SelectionMode="Extended" MouseDoubleClick="FoldersList_MouseDoubleClick" KeyDown="FoldersList_KeyDown" SelectionChanged="FoldersList_SelectionChanged" />
    <WrapPanel Grid.Row="4" Orientation="Horizontal" Margin="0 4 0 0">
      <TextBlock Text="TCP port:" VerticalAlignment="Center" Margin="3 0 6 0" />
      <TextBox x:Name="PortBox" Width="70" VerticalContentAlignment="Center" Margin="3" MaxLength="5" />
      <Button x:Name="StartButton" Content="Start" Click="Start_Click" Margin="14 3 3 3" MinWidth="70" />
      <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" MinWidth="70" />
      <Button x:Name="ApplyButton" Content="Restart with these folders" Click="Apply_Click" Visibility="Collapsed" ToolTip="The list of folders was changed while the server runs: stop it and start it again with the new list (the same port and options)" />
      <Button x:Name="CleanButton" Content="Remove feeds from device" Click="Clean_Click" ToolTip="Takes the lines of this server out of the repository list of the device (customfeeds.conf / customfeeds.list), e.g. if SmarTTY was closed while the server was running" />
      <Button x:Name="EditFeedsButton" Content="Edit feeds file" Click="EditFeeds_Click" ToolTip="Opens the repository list of the device (customfeeds.conf for opkg, customfeeds.list for apk) in the editor of SmarTTY, e.g. to add feeds of your own. Write your lines outside the block between &quot;# smartty-local-begin&quot; and &quot;# smartty-local-end&quot;: SmarTTY rewrites that block when the server starts and removes it when the server stops. This window closes; the server keeps running." />
      <CheckBox x:Name="AllowUnsignedBox" Content="Allow unsigned feeds (opkg)" VerticalAlignment="Center" Margin="10 0 0 0" ToolTip="When opkg on the device checks signatures (option check_signature in /etc/opkg.conf), it drops every feed without a trusted Packages.sig, and an index that SmarTTY generates has none. This comments the option out for the time the server runs; Stop and Remove feeds from device turn the check on again." />
      <CheckBox x:Name="TargetPackagesBox" Content="Add kernel modules of the build" VerticalAlignment="Center" Margin="10 0 0 0" ToolTip="For a folder bin/packages/&lt;arch&gt; of an OpenWrt build, also serve bin/targets/&lt;target&gt;/&lt;subtarget&gt;/packages of the same tree: the kernel modules (kmod-*) and the kernel package, which bin/packages does not have. With several targets built, the ones for the architecture of the folder are taken. The folder is listed in the log; you can also add it by hand." />
      <CheckBox x:Name="SignGeneratedBox" Content="Sign generated indexes (opkg)" VerticalAlignment="Center" Margin="10 0 0 0" ToolTip="When opkg on the device checks signatures (option check_signature in /etc/opkg.conf), a package index that SmarTTY generates (new or changed .ipk files that the index of the build does not describe) has no Packages.sig, and opkg update fails with &quot;Signature file download failed&quot;. This has the device make a temporary key with its own usign, trust it in /etc/opkg/keys and sign the generated indexes with it; Stop and Remove feeds from device delete the key again. Needs root and usign on the device; not used when unsigned feeds are allowed." />
      <CheckBox x:Name="TrustKeyBox" Content="Trust the build key (apk)" VerticalAlignment="Center" Margin="10 0 0 0" ToolTip="Adds public-key.pem of the OpenWrt tree (found above the selected folders) to /etc/apk/keys for the time the server runs. Needed only if the firmware of the device was not built from this tree; a firmware built from it already trusts the key." />
    </WrapPanel>
    <TextBlock x:Name="StatusText" Grid.Row="5" TextWrapping="Wrap" Margin="3 6 3 3" />
    <TextBox x:Name="LogBox" Grid.Row="6" Margin="3" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 4 0 0">
      <Button x:Name="PackagesButton" Content="Open package manager" Click="Packages_Click" ToolTip="Closes this window and opens Tools &gt; Manage Linux Packages" />
      <Button Content="Close" MinWidth="70" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
