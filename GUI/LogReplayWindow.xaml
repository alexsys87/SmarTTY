<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.LogReplayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="Replay log" Width="503" Height="124" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0 0 8 0">
      <Button Name="PauseButton" Content="Pause" MinWidth="75" Margin="0 0 0 4" Click="Pause_Click" />
      <Button Name="ResetButton" Content="Reset" MinWidth="75" Click="Reset_Click" />
    </StackPanel>
    <StackPanel Grid.Row="0" Grid.Column="1">
      <TextBlock Text="Replay speed:" Margin="0 0 0 4" />
      <Slider Name="SpeedSlider" Minimum="1" Maximum="100" Value="50" TickFrequency="5" IsSnapToTickEnabled="True" />
    </StackPanel>
  </Grid>
</Window>
