<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.CommandHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="Command history" Width="760" Height="540" MinWidth="440" MinHeight="300" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" SnapsToDevicePixels="True" FocusManager.FocusedElement="{Binding ElementName=SearchBox}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The search: every word, in any order and case. -->
    <DockPanel Grid.Row="0" Margin="0 0 0 8">
      <TextBlock DockPanel.Dock="Left" Text="Search:" VerticalAlignment="Center" Margin="0 0 6 0" />
      <TextBox Name="SearchBox" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" ToolTip="Shows the commands that contain every word typed here, in any order and case. Down moves to the list, Enter puts the selected command into the terminal." />
    </DockPanel>

    <!-- The commands, the newest first. -->
    <ListBox Name="CommandList" Grid.Row="1" SelectionMode="Extended" FontFamily="Consolas, Courier New" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="CommandList_SelectionChanged" MouseDoubleClick="CommandList_MouseDoubleClick" KeyDown="CommandList_KeyDown" />

    <TextBlock Name="StatusText" Grid.Row="2" Margin="0 6 0 0" TextWrapping="Wrap" />
    <TextBlock Name="NoteText" Grid.Row="3" Margin="0 4 0 0" TextWrapping="Wrap" Visibility="Collapsed" />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
      <Button Name="InsertButton" Content="_Insert" MinWidth="90" Padding="8 2 8 2" Margin="0 0 6 0" IsDefault="True" IsEnabled="False" Click="Insert_Click" ToolTip="Put the selected command into the command line of the terminal (Enter, double click). Nothing runs until you press Enter there." />
      <Button Name="DeleteButton" Content="_Delete" MinWidth="90" Padding="8 2 8 2" Margin="0 0 6 0" IsEnabled="False" Click="Delete_Click" ToolTip="Delete the selected commands from the history (Del)" />
      <Button Content="Close" MinWidth="90" Padding="8 2 8 2" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
