<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.XServerLaunchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:SmarTTY.GUI" Style="{DynamicResource SecondaryWindowStyle}" Title="X Server Required" Width="400" SizeToContent="Height" WindowStartupLocation="CenterOwner">
  <StackPanel Orientation="Vertical" Margin="5">
    <TextBlock Text="A remote application has initiated a connection to the X server that is used to display GUI for Linux programs. SmarTTY can start vcxsrv automatically to handle this." TextWrapping="Wrap" />
    <Grid Margin="0 10 0 5">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Grid}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Width="16" Height="16" Source="../icons/err16.png" VerticalAlignment="Center" Margin="0 0 5 0" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ErrorText}" />
    </Grid>
    <StackPanel Orientation="Vertical" Margin="0 10 0 0">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type StackPanel}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding ProgressText}" Value="{x:Null}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="5 3 5 3" />
            <Setter Property="Padding" Value="5 3 5 3" />
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <Button Content="Start vcxsrv (recommended)" Click="VCXSRV_Click" />
      <Button Content="Select an X server manually" Click="Manual_Click" />
      <Button Content="Cancel" Click="Cancel_Click" />
      <CheckBox Margin="5 5 0 10" IsChecked="{Binding SaveSettings}">
        <TextBlock Text="Remember my choice and don't ask again" />
      </CheckBox>
    </StackPanel>
    <Grid Margin="5">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Grid}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ProgressText}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Margin="0 0 5 0" Text="{Binding ProgressText}" />
      <ProgressBar IsIndeterminate="True" Grid.Column="1" />
      <Button Content="Cancel" Grid.Column="2" Margin="5 0 0 0" Click="Cancel_Click" />
    </Grid>
  </StackPanel>
</Window>