<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.RawConnectionSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:SmarTTY.GUI" xmlns:coll="clr-namespace:System.Collections;assembly=mscorlib" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:ports="clr-namespace:System.IO.Ports;assembly=System" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True" Title="Raw Terminal Settings" FocusManager.FocusedElement="{Binding ElementName=txtHost}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <VisualBrush x:Key="TcpHint" Stretch="None" AlignmentX="Left">
        <VisualBrush.Visual>
          <TextBlock FontStyle="Italic" Opacity="0.5" Text="&lt;hostname or IP address&gt;:&lt;port&gt;" Margin="2 1 0 0" Padding="5,0,1000,0" VerticalAlignment="Center" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        </VisualBrush.Visual>
      </VisualBrush>
      <local:ColorWrapperConverter x:Key="ColorWrapperConverter" />
      <Style x:Key="LargeSelectableLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Margin" Value="5 0 5 0" />
      </Style>
      <Style x:Key="HeaderText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Margin" Value="5" />
      </Style>
      <Style x:Key="PaddedHeaderText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Margin" Value="30 5 5 5" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Margin="10 0 10 10">
    <local:SettingsGroupBox Text="Raw TCP connection settings" ImageSource="../icons/net16.png" Visibility="{Binding TCPSettingsVisibility}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Connect to: " VerticalAlignment="Center" />
        <TextBox Name="txtHost" Grid.Column="2" Margin="2" VerticalContentAlignment="Center" Padding="2 1 2 2" Text="{Binding TCPEndpoint, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsChecked, ElementName=rbTCP}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBox}">
              <Style.Triggers>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="Text" Value="" />
                  </MultiTrigger.Conditions>
                  <Setter Property="Background" Value="{StaticResource TcpHint}" />
                </MultiTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBox>
        <Button Style="{StaticResource HyperlinkButton}" HorizontalAlignment="Left" Grid.Row="1" Grid.ColumnSpan="2" Click="Test_Click">
          <StackPanel Orientation="Horizontal">
            <Image Width="16" Height="16" Source="..\icons\PlayHS.png" Margin="0 0 5 0" />
            <TextBlock Text="Test connection now" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </local:SettingsGroupBox>
    <local:SettingsGroupBox ImageSource="../icons/com16.png" Text="{Binding SerialSettingsHeader}" Visibility="{Binding SerialSettingsVisibility}">
      <StackPanel Orientation="Vertical">
        <Grid Margin="0 0 0 0" IsEnabled="{Binding IsChecked, ElementName=rbCOM}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type ListBox}" TargetType="{x:Type ListBox}" BasedOn="{StaticResource LightHorizontalListBox}">
                <Style.Resources>
                  <ResourceDictionary>
                    <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LargeSelectableLabel}" />
                  </ResourceDictionary>
                </Style.Resources>
                <Setter Property="Margin" Value="0 2 0 2" />
                <EventSetter Event="SelectionChanged" Handler="ListBox_SelectionChanged" />
              </Style>
              <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Margin" Value="0 2 0 2" />
                <EventSetter Event="SelectionChanged" Handler="ListBox_SelectionChanged" />
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Bits per second:" Style="{StaticResource HeaderText}" />
          <ComboBox Grid.Column="1" IsEditable="True" Text="{Binding Path=SerialSettings.AdvancedSettings.BaudRate}" TextBoxBase.TextChanged="ComboBox_TextChanged">
            <ItemsControl.ItemsSource>
              <coll:ArrayList>
                <sys:Int32>1200</sys:Int32>
                <sys:Int32>2400</sys:Int32>
                <sys:Int32>4800</sys:Int32>
                <sys:Int32>9600</sys:Int32>
                <sys:Int32>19200</sys:Int32>
                <sys:Int32>38400</sys:Int32>
                <sys:Int32>57600</sys:Int32>
                <sys:Int32>115200</sys:Int32>
              </coll:ArrayList>
            </ItemsControl.ItemsSource>
          </ComboBox>
          <TextBlock Text="Data bits:" Style="{StaticResource HeaderText}" Grid.Row="1" />
          <ListBox Grid.Column="1" Grid.Row="1" SelectedItem="{Binding Path=SerialSettings.AdvancedSettings.DataBits}">
            <ItemsControl.ItemsSource>
              <coll:ArrayList>
                <sys:Int32>5</sys:Int32>
                <sys:Int32>6</sys:Int32>
                <sys:Int32>7</sys:Int32>
                <sys:Int32>8</sys:Int32>
              </coll:ArrayList>
            </ItemsControl.ItemsSource>
          </ListBox>
          <TextBlock Text="Parity:" Style="{StaticResource HeaderText}" Grid.Row="2" />
          <ListBox Grid.Column="1" Grid.Row="2" SelectedItem="{Binding Path=SerialSettings.AdvancedSettings.Parity}">
            <ItemsControl.ItemsSource>
              <coll:ArrayList>
                <ports:Parity>None</ports:Parity>
                <ports:Parity>Odd</ports:Parity>
                <ports:Parity>Even</ports:Parity>
                <ports:Parity>Mark</ports:Parity>
                <ports:Parity>Space</ports:Parity>
              </coll:ArrayList>
            </ItemsControl.ItemsSource>
          </ListBox>
          <TextBlock Text="Stop bits:" Style="{StaticResource HeaderText}" Grid.Row="3" />
          <ListBox Grid.Column="1" Grid.Row="3" SelectedItem="{Binding Path=SerialSettings.AdvancedSettings.StopBits}">
            <ItemsControl.ItemsSource>
              <coll:ArrayList>
                <ports:StopBits>None</ports:StopBits>
                <ports:StopBits>One</ports:StopBits>
                <ports:StopBits>OnePointFive</ports:StopBits>
                <ports:StopBits>Two</ports:StopBits>
              </coll:ArrayList>
            </ItemsControl.ItemsSource>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock>
                  <FrameworkElement.Style>
                    <Style BasedOn="{StaticResource LargeSelectableLabel}" TargetType="{x:Type TextBlock}">
                      <Style.Triggers>
                        <DataTrigger Value="None" Binding="{Binding}">
                          <Setter Property="Text" Value="0" />
                        </DataTrigger>
                        <DataTrigger Value="One" Binding="{Binding}">
                          <Setter Property="Text" Value="1" />
                        </DataTrigger>
                        <DataTrigger Value="OnePointFive" Binding="{Binding}">
                          <Setter Property="Text" Value="1.5" />
                        </DataTrigger>
                        <DataTrigger Value="Two" Binding="{Binding}">
                          <Setter Property="Text" Value="2" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
          <TextBlock Text="Flow control:" Style="{StaticResource HeaderText}" Grid.Row="4" />
          <ListBox Grid.Column="1" Grid.Row="4" SelectedItem="{Binding Path=SerialSettings.AdvancedSettings.FlowControl}">
            <ItemsControl.ItemsSource>
              <coll:ArrayList>
                <ports:Handshake>None</ports:Handshake>
                <ports:Handshake>RequestToSend</ports:Handshake>
                <ports:Handshake>XOnXOff</ports:Handshake>
                <ports:Handshake>RequestToSendXOnXOff</ports:Handshake>
              </coll:ArrayList>
            </ItemsControl.ItemsSource>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock>
                  <FrameworkElement.Style>
                    <Style BasedOn="{StaticResource LargeSelectableLabel}" TargetType="{x:Type TextBlock}">
                      <Style.Triggers>
                        <DataTrigger Value="None" Binding="{Binding}">
                          <Setter Property="Text" Value="None" />
                        </DataTrigger>
                        <DataTrigger Value="RequestToSend" Binding="{Binding}">
                          <Setter Property="Text" Value="Software (XON/XOFF)" />
                        </DataTrigger>
                        <DataTrigger Value="RequestToSendXOnXOff" Binding="{Binding}">
                          <Setter Property="Text" Value="Both" />
                        </DataTrigger>
                        <DataTrigger Value="XOnXOff" Binding="{Binding}">
                          <Setter Property="Text" Value="Hardware (CTS/RTS)" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="1" Margin="0 5 0 5">
            <TextBlock Text="Maximum speed:" Margin="0 0 5 0" />
            <TextBlock FontWeight="Bold" Text="{Binding MaximumSpeed}" />
          </StackPanel>
        </Grid>
        <Button Style="{StaticResource HyperlinkButton}" HorizontalAlignment="Left" Click="Test_Click">
          <StackPanel Orientation="Horizontal">
            <Image Width="16" Height="16" Source="..\icons\PlayHS.png" Margin="0 0 5 0" />
            <TextBlock Text="Test connection now" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </local:SettingsGroupBox>
    <local:SettingsGroupBox Text="Terminal colors" ImageSource="..\icons\color16.png">
      <Grid DataContext="{Binding Path=Settings}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
              <Setter Property="Margin" Value="5 2 5 2" />
            </Style>
            <Style x:Key="{x:Type Border}" TargetType="{x:Type Border}">
              <Setter Property="Margin" Value="5 2 5 2" />
              <EventSetter Event="MouseDown" Handler="Border_MouseDown" />
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <TextBlock Text="Background color:" />
        <Border Width="40" Grid.Column="1" BorderBrush="#FF000000" BorderThickness="1" HorizontalAlignment="Left" Background="{Binding Path=Colors.Background, Converter={StaticResource ColorWrapperConverter}}" />
        <TextBlock Text="Received text color:" Grid.Column="3" />
        <Border Width="40" Grid.Column="4" BorderBrush="#FF000000" BorderThickness="1" HorizontalAlignment="Left" Background="{Binding Path=Colors.Text, Converter={StaticResource ColorWrapperConverter}}" />
        <TextBlock Text="Background color (disconnected):" Grid.Column="0" Grid.Row="1" />
        <Border Width="40" Grid.Column="1" BorderBrush="#FF000000" BorderThickness="1" HorizontalAlignment="Left" Grid.Row="1" Background="{Binding Path=Colors.Disconnected, Converter={StaticResource ColorWrapperConverter}}" />
        <TextBlock Text="Echoed characters color:" Grid.Column="3" Grid.Row="1" />
        <Border Width="40" Grid.Column="4" BorderBrush="#FF000000" BorderThickness="1" HorizontalAlignment="Left" Grid.Row="1" Background="{Binding Path=Colors.Echo, Converter={StaticResource ColorWrapperConverter}}" />
      </Grid>
    </local:SettingsGroupBox>
    <local:SettingsGroupBox Text="Terminal settings" ImageSource="..\Icons\term16.png">
      <Grid>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type ListBox}" TargetType="{x:Type ListBox}" BasedOn="{StaticResource LightHorizontalListBox}">
              <Style.Resources>
                <ResourceDictionary>
                  <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LargeSelectableLabel}" />
                </ResourceDictionary>
              </Style.Resources>
              <Setter Property="Margin" Value="0 2 0 2" />
              <EventSetter Event="SelectionChanged" Handler="ListBox_SelectionChanged" />
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CheckBox VerticalContentAlignment="Center" Grid.ColumnSpan="2" IsChecked="{Binding Path=Settings.EchoTypedCharacters}" Checked="RaiseSettingsChangedEvent" Unchecked="RaiseSettingsChangedEvent">
          <TextBlock Text="Echo back typed characters (with different color)" />
        </CheckBox>
        <TextBlock Text="Line ending style:" Grid.Row="1" Style="{StaticResource HeaderText}" />
        <ListBox Grid.Column="1" Grid.Row="1" ItemsSource="{Binding LineEndings}" SelectedItem="{Binding Path=Settings.LineEnding}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource LargeSelectableLabel}" TargetType="{x:Type TextBlock}">
                    <Style.Triggers>
                      <DataTrigger Value="CR" Binding="{Binding}">
                        <Setter Property="Text" Value="CR (\r)" />
                      </DataTrigger>
                      <DataTrigger Value="LF" Binding="{Binding}">
                        <Setter Property="Text" Value="LF (\n)" />
                      </DataTrigger>
                      <DataTrigger Value="CRLF" Binding="{Binding}">
                        <Setter Property="Text" Value="CRLF (\r\n)" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
        <CheckBox Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center" IsChecked="{Binding Path=Settings.TreatLFAsCRLF}" Checked="RaiseSettingsChangedEvent" Unchecked="RaiseSettingsChangedEvent">
          <TextBlock Text="Treat incoming LF as CRLF when in text mode" />
        </CheckBox>
        <TextBlock Text="Display mode:" Grid.Row="3" Style="{StaticResource HeaderText}" />
        <ListBox Grid.Column="1" Grid.Row="3" SelectedItem="{Binding Path=EffectiveDisplayMode}">
          <ItemsControl.ItemsSource>
            <coll:ArrayList>
              <local:EffectiveDisplayMode>Text</local:EffectiveDisplayMode>
              <local:EffectiveDisplayMode>Hex</local:EffectiveDisplayMode>
              <local:EffectiveDisplayMode>Both</local:EffectiveDisplayMode>
            </coll:ArrayList>
          </ItemsControl.ItemsSource>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource LargeSelectableLabel}" TargetType="{x:Type TextBlock}">
                    <Style.Triggers>
                      <DataTrigger Value="Text" Binding="{Binding}">
                        <Setter Property="Text" Value="Text only" />
                      </DataTrigger>
                      <DataTrigger Value="Hex" Binding="{Binding}">
                        <Setter Property="Text" Value="Hex only" />
                      </DataTrigger>
                      <DataTrigger Value="Both" Binding="{Binding}">
                        <Setter Property="Text" Value="Text and hex" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
        <TextBlock Text="Send data:" Grid.Row="4" Style="{StaticResource PaddedHeaderText}" IsEnabled="{Binding HexModeEnabled}" />
        <ListBox Grid.Column="1" Grid.Row="4" SelectedItem="{Binding Path=Settings.HexSettings.AutoSend}" IsEnabled="{Binding HexModeEnabled}">
          <ItemsControl.ItemsSource>
            <coll:ArrayList>
              <sys:Boolean>true</sys:Boolean>
              <sys:Boolean>false</sys:Boolean>
            </coll:ArrayList>
          </ItemsControl.ItemsSource>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource LargeSelectableLabel}" TargetType="{x:Type TextBlock}">
                    <Style.Triggers>
                      <DataTrigger Value="true" Binding="{Binding}">
                        <Setter Property="Text" Value="As you type it" />
                      </DataTrigger>
                      <DataTrigger Value="false" Binding="{Binding}">
                        <Setter Property="Text" Value="When Enter or 'Send' is pressed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
        <TextBlock Text="Interpret typed data as:" Grid.Row="5" Style="{StaticResource PaddedHeaderText}" IsEnabled="{Binding HexModeEnabled}" />
        <ListBox Grid.Column="1" Grid.Row="5" SelectedItem="{Binding Path=Settings.HexSettings.SendAsHex}" IsEnabled="{Binding HexModeEnabled}">
          <ItemsControl.ItemsSource>
            <coll:ArrayList>
              <sys:Boolean>false</sys:Boolean>
              <sys:Boolean>true</sys:Boolean>
            </coll:ArrayList>
          </ItemsControl.ItemsSource>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource LargeSelectableLabel}" TargetType="{x:Type TextBlock}">
                    <Style.Triggers>
                      <DataTrigger Value="true" Binding="{Binding}">
                        <Setter Property="Text" Value="Hexadecimal numbers" />
                      </DataTrigger>
                      <DataTrigger Value="false" Binding="{Binding}">
                        <Setter Property="Text" Value="Characters" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
        <TextBlock Text="Maximum bytes per line:" Grid.Row="6" Style="{StaticResource PaddedHeaderText}" IsEnabled="{Binding HexModeEnabled}" />
        <TextBox Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Path=Settings.HexSettings.MaximumBytesPerLine}" IsEnabled="{Binding HexModeEnabled}" TextChanged="ComboBox_TextChanged" />
        <TextBlock Text="Additional line breaks" Grid.Row="7" Style="{StaticResource PaddedHeaderText}" Grid.ColumnSpan="2" IsEnabled="{Binding HexModeEnabled}" />
        <CheckBox Grid.Row="8" Grid.ColumnSpan="2" Margin="60 5 0 5" VerticalContentAlignment="Center" IsChecked="{Binding Path=Settings.HexSettings.BreaksAroundEcho}" IsEnabled="{Binding HexModeEnabled}" Checked="RaiseSettingsChangedEvent" Unchecked="RaiseSettingsChangedEvent">
          <TextBlock Text="Between echoed and received data" />
        </CheckBox>
        <CheckBox Name="cbInactivity" Grid.Row="9" Grid.ColumnSpan="2" Margin="60 5 0 5" VerticalContentAlignment="Center" IsEnabled="{Binding HexModeEnabled}" Checked="RaiseSettingsChangedEvent" Unchecked="RaiseSettingsChangedEvent">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="After " VerticalAlignment="Center" />
            <TextBox Width="60" VerticalAlignment="Center" Text="{Binding Path=Settings.HexSettings.TimeoutForAutoBreak}" TextChanged="ComboBox_TextChanged" />
            <TextBlock Text=" msec of inactivity " VerticalAlignment="Center" />
          </StackPanel>
        </CheckBox>
      </Grid>
    </local:SettingsGroupBox>
    <CheckBox Margin="0 5 0 0" Visibility="{Binding SaveCheckboxVisibility}" IsChecked="{Binding SaveSettings}">
      <TextBlock Text="Save connection settings in the connection list" />
    </CheckBox>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Grid.Column="3" Grid.Row="2" Margin="5 0 5 0" IsDefault="True" MinWidth="75" MinHeight="26" AutomationProperties.AutomationId="OK" Click="OK_Click">
        <AccessText Text="_OK" />
      </Button>
      <Button Grid.Column="4" Grid.Row="2" Margin="5 0 5 0" IsCancel="True" MinWidth="75" MinHeight="26" AutomationProperties.AutomationId="Cancel" Click="Cancel_Click">
        <AccessText Text="_Cancel" />
      </Button>
    </StackPanel>
  </StackPanel>
</Window>