<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.SettingsArchiveSelectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="SmarTTY settings" Width="560" SizeToContent="Height" MinWidth="480" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen">
  <Grid Margin="10">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="Margin" Value="3" />
          <Setter Property="Padding" Value="8 3 8 3" />
          <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
          <Setter Property="Margin" Value="4 3 4 3" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="IntroText" Grid.Row="0" TextWrapping="Wrap" Margin="3 0 3 8" />
    <GroupBox Grid.Row="1" Header="Settings" Margin="3">
      <StackPanel Margin="4">
        <CheckBox x:Name="MainSettingsBox" Content="Main settings (Settings.xml)" ToolTip="Global SmarTTY settings: terminal, SSH, file transfer and other options of the Settings window." />
        <CheckBox x:Name="KnownHostsBox" Content="Trusted server keys (KnownHosts.xml)" ToolTip="Fingerprints of the SSH servers you have already trusted." />
        <CheckBox x:Name="GuiPreferencesBox" Content="Interface preferences (GUIPreferences.xml)" ToolTip="Window layout and the preferences of the connection selection window. Fully applied after SmarTTY is restarted." />
        <CheckBox x:Name="SshProfilesBox" Content="SSH connection profiles" />
        <CheckBox x:Name="RawProfilesBox" Content="COM / TCP / Telnet connection profiles" />
        <CheckBox x:Name="PasswordsBox" Margin="26 3 4 3" Content="Saved passwords inside the profiles" ToolTip="Saved passwords are encrypted with a key that belongs to your Windows account, so on another computer they work only together with the password protection key (see below)." />
        <CheckBox x:Name="CompletionsBox" Content="Command completions (CommandCompletions.xml or .xml.gz)" ToolTip="The command completion database that is kept next to SmarTTY.exe, as CommandCompletions.xml or as the compressed CommandCompletions.xml.gz. It is replaced as a whole, in the form of the archive. Applied after SmarTTY is restarted." />
      </StackPanel>
    </GroupBox>
    <GroupBox Grid.Row="2" Header="Authentication keys" Margin="3">
      <StackPanel Margin="4">
        <CheckBox x:Name="SshKeyBox" Content="SmarTTY SSH key (public key authentication)" ToolTip="The RSA key that SmarTTY uses to log in to servers where its public key is installed (key manager). Stored in a key container of your Windows account." />
        <CheckBox x:Name="PasswordKeyBox" Content="Password protection key (decrypts saved passwords)" ToolTip="The key that encrypts the saved passwords. Together with the saved passwords it lets them work on another computer." />
        <CheckBox x:Name="OpenSshKeysBox" Content="OpenSSH keys from the .ssh folder (id_ed25519, id_ecdsa, id_rsa)" ToolTip="Private and public key files of the default names from the .ssh folder of your Windows account. Keys that profiles reference with an explicit path are not included: copy them yourself." />
        <TextBlock x:Name="OpenSshFilesText" Margin="26 0 4 3" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextSecondary}" Visibility="Collapsed" />
      </StackPanel>
    </GroupBox>
    <TextBlock x:Name="WarningText" Grid.Row="3" TextWrapping="Wrap" Margin="3 6 3 0" Foreground="{DynamicResource Theme.Error}" Visibility="Collapsed" />
    <DockPanel Grid.Row="4" Margin="0 10 0 0" LastChildFill="False">
      <Button x:Name="AllButton" DockPanel.Dock="Left" Content="Select all" Click="SelectAll_Click" />
      <Button x:Name="NoneButton" DockPanel.Dock="Left" Content="Select none" Click="SelectNone_Click" />
      <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" />
      <Button x:Name="OkButton" DockPanel.Dock="Right" Content="OK" IsDefault="True" Click="Ok_Click" />
    </DockPanel>
  </Grid>
</Window>
