<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.RemoteOpenFileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="Download a File with SCP" Width="484" Height="320" MinWidth="340" MinHeight="218" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0">
      <Button DockPanel.Dock="Right" Name="UpButton" Margin="4 0 0 0" Padding="4 2" ToolTip="Go to the parent directory" Click="Up_Click">
        <Image Source="pack://application:,,,/icons/MainWindow/updir.png" Width="16" Height="16" />
      </Button>
      <ComboBox Name="DirectoryCombo" IsEditable="True" MinWidth="120" SelectionChanged="DirectoryCombo_SelectionChanged" KeyDown="DirectoryCombo_KeyDown" />
    </DockPanel>
    <ListBox Grid.Row="1" Name="FileList" MinHeight="100" Margin="0 6 0 0" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="FileList_SelectionChanged" MouseDoubleClick="FileList_MouseDoubleClick" KeyDown="FileList_KeyDown" />
    <StackPanel Grid.Row="2" Name="BusyPanel" Visibility="Collapsed" Margin="0 6 0 0">
      <ProgressBar Height="18" IsIndeterminate="True" />
      <DockPanel Margin="0 4 0 0">
        <Button DockPanel.Dock="Right" Name="BusyCancelButton" Content="Cancel" MinWidth="75" Click="BusyCancel_Click" />
        <TextBlock Text="Waiting to complete..." VerticalAlignment="Center" Margin="0 0 8 0" />
      </DockPanel>
    </StackPanel>
    <TextBlock Grid.Row="3" Name="ErrorText" Foreground="{DynamicResource Theme.Error}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0 6 0 0" />
    <DockPanel Grid.Row="4" Margin="0 6 0 0">
      <TextBlock DockPanel.Dock="Left" Text="File name:" VerticalAlignment="Center" Margin="0 0 6 0" />
      <TextBox Name="FileNameBox" KeyDown="FileNameBox_KeyDown" />
    </DockPanel>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
      <Button Name="OpenButton" Content="_Open" IsDefault="True" MinWidth="75" Margin="0 0 5 0" Click="Open_Click" />
      <Button Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="75" />
    </StackPanel>
  </Grid>
</Window>
