<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:SmarTTY.GUI" Width="800" Height="600" ResizeMode="CanResizeWithGrip" SnapsToDevicePixels="True" AllowDrop="True" Style="{DynamicResource SecondaryWindowStyle}" Title="{Binding Path=ActiveSession.TitleWithStatus, StringFormat=SmarTTY - {0}}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="TabHeaderImage" TargetType="{x:Type Image}">
          <Setter Property="Margin" Value="0 0 5 0" />
          <Style.Triggers>
            <DataTrigger Value="VirtualTerminal" Binding="{Binding Icon}">
              <Setter Property="Source" Value="../icons/term16v.png" />
            </DataTrigger>
            <DataTrigger Value="Terminal" Binding="{Binding Icon}">
              <Setter Property="Source" Value="../icons/term16.png" />
            </DataTrigger>
            <DataTrigger Value="Add" Binding="{Binding Icon}">
              <Setter Property="Source" Value="../icons/MainWindow/add16.png" />
            </DataTrigger>
            <DataTrigger Value="New" Binding="{Binding Icon}">
              <Setter Property="Source" Value="../icons/MainWindow/new16.png" />
            </DataTrigger>
            <DataTrigger Value="Editor" Binding="{Binding Icon}">
              <Setter Property="Source" Value="../icons/MainWindow/editor.png" />
            </DataTrigger>
            <DataTrigger Value="Open" Binding="{Binding Icon}">
              <Setter Property="Source" Value="../icons/MainWindow/open16.png" />
            </DataTrigger>
            <DataTrigger Value="AddVirtual" Binding="{Binding Icon}">
              <Setter Property="Source" Value="../icons/event16.png" />
            </DataTrigger>
            <DataTrigger Value="Serial" Binding="{Binding Icon}">
              <Setter Property="Source" Value="../icons/com16.png" />
            </DataTrigger>
            <DataTrigger Value="Network" Binding="{Binding Icon}">
              <Setter Property="Source" Value="../icons/net16.png" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
              <Setter Property="Margin" Value="0" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="TabCloseButton" TargetType="{x:Type Button}">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate>
                <Image Name="Image" Width="8" Height="8" Source="../icons/MainWindow/close8.png" />
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="Image" Property="Image.Source" Value="../icons/MainWindow/close8red.png" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="FrameworkElement.ToolTip" Value="Close" />
                    <EventSetter Event="Click" Handler="CloseTabButton_Click" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="TabMinimizeButton" TargetType="{x:Type Button}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Border Name="Glyph" Width="8" Height="8" Background="Transparent">
                                    <Rectangle Name="Bar" Width="8" Height="2" VerticalAlignment="Center" Fill="{DynamicResource Theme.TextSecondary}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                                        <Setter TargetName="Bar" Property="Rectangle.Fill" Value="{DynamicResource Theme.Error}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FrameworkElement.ToolTip" Value="Collapse" />
                    <EventSetter Event="Click" Handler="MinimizeDeviceTabWindow_Click" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDevice}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

        <Style x:Key="TitleText" TargetType="{x:Type TextBlock}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Menu Grid.Row="0" Padding="0 2 0 2" Visibility="{Binding MainMenuVisibility}">
      <MenuItem Header="_File">
        <MenuItem Header="_New Tab" Click="NewTab_Click" Visibility="{Binding Path=ActiveSession.SshOnlyVisibility, FallbackValue=Visible}">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/add16.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Open a remote file" Click="OpenFile_Click" Visibility="{Binding Path=ActiveSession.SshOnlyVisibility, FallbackValue=Visible}">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/open16.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{Binding RemoteFileSaveHeader}" Visibility="{Binding SaveCommandVisibility}" Click="SaveFile_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/save16.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Open _another session" Click="NewSession_Click">
          <MenuItem.Icon>
            <Image Source="../icons/term16.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Back to launcher" ToolTip="Close this window and its sessions and return to the start window" Click="BackToLauncher_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/go16.png" RenderTransformOrigin="0.5,0.5">
              <Image.RenderTransform>
                <ScaleTransform ScaleX="-1" />
              </Image.RenderTransform>
            </Image>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Close current tab" Click="CloseTab_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/closetab.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Replay log" Visibility="{Binding ReplayVisibility}" Click="ReplayLog_Click">
          <MenuItem.Icon>
            <Image Source="../icons/PlayHS.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Log all terminal output to a file" Visibility="{Binding DebugVisibility}" Click="MakeLog_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/document_flat.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="E_xit" Click="Exit_Click">
          <MenuItem.Icon>
            <Image Source="../icons/delete16.png" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Copy" Click="Copy_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/copy.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Paste" Click="Paste_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/paste.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Find" InputGestureText="Ctrl+F" Click="Find_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/FindHS.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Copy _All" Click="CopyAll_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/copy.png" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_SCP Transfers" Click="SCPTransfers_Click" Visibility="{Binding Path=ActiveSession.SshOnlyVisibility, FallbackValue=Visible}">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/transfers.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_File List" IsCheckable="True" IsChecked="{Binding Path=MenuCommandHandlers.FileListVisible}" Visibility="{Binding Path=ActiveSession.FileListMenuVisibility, FallbackValue=Collapsed}" />
        <MenuItem Header="_Close tab when shell exits" IsCheckable="True" IsChecked="{Binding Path=MenuCommandHandlers.AutoCloseTabs}" />
        <MenuItem Header="Auto-_wrap lines" IsCheckable="True" IsChecked="{Binding Path=MenuCommandHandlers.AutoWrapLines}" />
        <MenuItem Header="_Minimalistic mode" IsCheckable="True" IsChecked="{Binding Path=MenuCommandHandlers.MinimalisticMode}" />
        <MenuItem Header="_Full-screen mode" IsCheckable="True" IsChecked="{Binding Path=MenuCommandHandlers.FullScreenMode}" />
      </MenuItem>
      <MenuItem Header="S_CP" Visibility="{Binding Path=ActiveSession.SshOnlyVisibility, FallbackValue=Visible}">
        <MenuItem Header="_Download a file" Click="Download_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/download.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_One-click download" Click="QuickDownload_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/qdownload.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Upload a file" Click="Upload_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/upload.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Download a directory" Click="DownloadDir_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/getdir.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Upload a directory" Click="UploadDir_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/updir.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Copy a directory between hosts..." Click="CopyDirBetweenHosts_Click">
          <MenuItem.Icon>
            <Image Source="../icons/dialog-scp-download.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Synchronize folders..." Click="Synchronize_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/refresh16.png" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="Manage Linux _Packages" Click="ManagePackages_Click" Visibility="{Binding Path=ActiveSession.SshOnlyVisibility, FallbackValue=Visible}">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/archive16.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Process _manager..." Click="ProcessManager_Click" ToolTip="Lists the processes of the server with their processor and memory use, and ends or kills the selected one; works with any Linux, OpenWrt included" Visibility="{Binding Path=ActiveSession.SshOnlyVisibility, FallbackValue=Visible}">
          <MenuItem.Icon>
            <Image Source="../icons/chip.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Local OpenWrt _repository server..." Click="LocalRepo_Click" ToolTip="Serve OpenWrt packages built on this computer to the device and install them with the package manager" Visibility="{Binding Path=ActiveSession.LocalRepoMenuVisibility, FallbackValue=Collapsed}">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/archive16.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="S_OCKS5 proxy over SSH..." Click="SocksProxy_Click" ToolTip="Starts a SOCKS5 proxy on this computer (127.0.0.1:1080 by default) that carries the connections of other programs through this SSH connection, like ssh -N -D 127.0.0.1:1080 -o ServerAliveInterval=30" Visibility="{Binding Path=ActiveSession.SshOnlyVisibility, FallbackValue=Visible}">
          <MenuItem.Icon>
            <Image Source="../icons/net16.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Public key authentication" Click="PublicKey_Click" Visibility="{Binding Path=ActiveSession.SshOnlyVisibility, FallbackValue=Visible}">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/pubkey.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Run _script..." Click="RunScript_Click" ToolTip="Uploads a shell script (bash or ash) to /tmp on the server, makes it executable, runs it in the terminal and removes it afterwards" Visibility="{Binding Path=ActiveSession.SshOnlyVisibility, FallbackValue=Visible}">
          <MenuItem.Icon>
            <Image Source="../icons/terminal.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Check _X11 forwarding..." Click="CheckX11_Click" ToolTip="Shows whether X11 forwarding works for this connection: the server's answer, xauth and libX11 on the remote host, and VcXsrv on this computer" Visibility="{Binding Path=ActiveSession.SshOnlyVisibility, FallbackValue=Visible}">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/x11.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_TFTP server / U-Boot upload..." Click="TftpFirmware_Click" Visibility="{Binding Path=ActiveSession.DeviceOnlyVisibility, FallbackValue=Collapsed}">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/upload.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Command _completions..." Click="CommandCompletionsEditor_Click" ToolTip="Edit or create the options that the Smart Terminal suggests for commands (CommandCompletions.xml); can store the file compressed">
          <MenuItem.Icon>
            <Image Source="../icons/edit16.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Settings" Click="Settings_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/settings.png" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About..." Click="About_Click">
          <MenuItem.Icon>
            <Image Source="../icons/MainWindow/help.png" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
    </Menu>
    <Grid Row="1">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="DockedContentWithHeader" TargetType="{x:Type ContentControl}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{DynamicResource DockHeaderStyle}" Margin="1">
                      <Grid Margin="5 1 5 1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" />
                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                          <Button Style="{StaticResource TabCloseButton}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <ContentControl Grid.Row="1" Content="{Binding Path=Content, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ContentControl}}}" />
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <DataTrigger Value="true" Binding="{Binding IsVisible}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Name="FilesColumn" Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Name="SCPRow" Height="Auto" />
      </Grid.RowDefinitions>
      <ContentControl Name="FileDock" Style="{StaticResource DockedContentWithHeader}" Margin="0 0 0 2" DataContext="{Binding Path=ActiveSession.ActiveTab.FileExplorer}" IsVisibleChanged="FilesVisibleChanged">
        <local:FileListControl FileActionRequested="FileListControl_FileActionRequested" FocusRequested="FileListControl_FocusRequested" />
      </ContentControl>
      <GridSplitter Width="2" VerticalAlignment="Stretch" HorizontalAlignment="Right" Panel.ZIndex="1" ResizeDirection="Columns" Visibility="{Binding Path=Visibility, ElementName=FileDock}" />
      <TabControl Name="OuterTabControl" Grid.Column="1" Grid.Row="0" Style="{DynamicResource MainWindowOuterTabControl}" TabStripPlacement="{Binding SessionHeaderLocation}" ItemsSource="{Binding AllSessions}" SelectedIndex="{Binding ActiveSessionIndex}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid Margin="10 2 10 2">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Grid}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Image Width="16" Height="16" Style="{StaticResource TabHeaderImage}" />
                <Image Width="9" Height="9" Margin="0 0 5 0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Source="../icons/MainWindow/err9.png">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Image}">
                      <Style.Triggers>
                        <DataTrigger Value="false" Binding="{Binding IsInactive}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </Image>
                <Button Grid.Column="3" Margin="2 0 0 0" Style="{StaticResource TabMinimizeButton}" />
                <Button Grid.Column="2" Style="{StaticResource TabCloseButton}" />
                <TextBlock Grid.Column="1" Style="{StaticResource TitleText}" Text="{Binding Title}" />
              </Grid>
              <ToggleButton Checked="ToggleButton_Checked" Unchecked="ToggleButton_Unchecked">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type ToggleButton}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <Control.Template>
                  <ControlTemplate>
                    <Image Width="16" Height="16" Source="../icons/MainWindow/new16.png" Margin="5 0 5 0" ToolTip="Connect to another target" />
                  </ControlTemplate>
                </Control.Template>
              </ToggleButton>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate>
            <Grid>
              <ContentControl>
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type ContentControl}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Fixer}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TabControl Panel.ZIndex="0" Style="{DynamicResource MainWindowInnerTabControl}" TabStripPlacement="{Binding Path=DataContext.TabHeaderLocation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding ActiveTabIndex}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ToolTip="{Binding ToolTip}" ContextMenuOpening="TabHeader_ContextMenuOpening">
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Copy _path" Tag="CopyPath" Click="TabContextMenu_CopyPath">
                              <MenuItem.Icon>
                                <Image Source="../icons/MainWindow/copy.png" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Close _others" Tag="CloseOthers" Click="TabContextMenu_CloseOthers">
                              <MenuItem.Icon>
                                <Image Source="../icons/MainWindow/closetab.png" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Save a_ll" Tag="SaveAll" Click="TabContextMenu_SaveAll">
                              <MenuItem.Icon>
                                <Image Source="../icons/MainWindow/save16.png" />
                              </MenuItem.Icon>
                            </MenuItem>
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <Grid Margin="10 2 10 2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                          </Grid.ColumnDefinitions>
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type Grid}">
                              <Style.Triggers>
                                <DataTrigger Value="true" Binding="{Binding IsNewSessionShortcut}">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                          <Image Width="16" Height="16" Style="{StaticResource TabHeaderImage}" />
                          <TextBlock Grid.Column="1" Margin="0 0 10 0" Style="{StaticResource TitleText}" Text="{Binding Title}" />
                          <Button Grid.Column="2" Style="{StaticResource TabCloseButton}" />
                        </Grid>
                        <ToggleButton Checked="ToggleButton_Checked" Unchecked="ToggleButton_Unchecked">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type ToggleButton}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Value="true" Binding="{Binding IsNewSessionShortcut}">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                          <Control.Template>
                            <ControlTemplate>
                              <Image Width="16" Height="16" Source="../icons/MainWindow/new16.png" Margin="5 0 5 0" />
                            </ControlTemplate>
                          </Control.Template>
                        </ToggleButton>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                  <TabControl.ContentTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.RowDefinitions>
                          <!-- Tool bar above the WinForms host: WPF scales it for high-DPI monitors. -->
                          <RowDefinition Height="Auto" />
                          <!-- Find/replace bar, shown above the editor while it is open. -->
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                          <RowDefinition Height="Auto" />
                          <!-- Status bar below the horizontal scroll bar (file editor tabs). -->
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Grid.ColumnSpan="2" HorizontalContentAlignment="Stretch" Content="{Binding ToolBar}" />
                        <Border Grid.Row="1" Grid.ColumnSpan="2" FocusManager.FocusedElement="{Binding ElementName=txtSearch}" IsVisibleChanged="Border_IsVisibleChanged">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type Border}">
                              <Style.Triggers>
                                <DataTrigger Value="false" Binding="{Binding Searcher.IsVisible, FallbackValue=false}">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                          <Grid Margin="2" DataContext="{Binding Searcher}" Style="{DynamicResource ToolBarGridStyle}" TextBlock.Foreground="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}">
                            <Grid.Resources>
                              <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Find: " VerticalAlignment="Center" />
                            <TextBox Name="txtSearch" Grid.Column="1" VerticalContentAlignment="Center" VerticalAlignment="Center" Text="{Binding SearchedText, UpdateSourceTrigger=PropertyChanged}" KeyDown="txtSearch_KeyDown">
                              <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasQueryError}" Value="True">
                                      <Setter Property="Background" Value="#FFFFC8C8" />
                                      <Setter Property="Foreground" Value="Black" />
                                      <Setter Property="ToolTip" Value="{Binding QueryError}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBox.Style>
                            </TextBox>
                            <ToggleButton Grid.Column="2" ToolTip="Case-sensitive search" IsChecked="{Binding CaseSensitive}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}">
                              <TextBlock Text="Aa" />
                            </ToggleButton>
                            <ToggleButton Grid.Column="3" ToolTip="Whole word" IsChecked="{Binding WholeWord}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}">
                              <TextBlock Text="W" FontWeight="Bold" />
                            </ToggleButton>
                            <ToggleButton Grid.Column="4" ToolTip="Regular expression (the replacement may use $1, ${name})" IsChecked="{Binding UseRegex}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}">
                              <TextBlock Text=".*" />
                            </ToggleButton>
                            <ToggleButton Grid.Column="5" ToolTip="Search only in the text that is selected now (file editor tabs)" IsChecked="{Binding InSelection}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Visibility="{Binding CanReplace, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Text="Sel" />
                            </ToggleButton>
                            <Button Grid.Column="6" Click="SearchUp_Click">
                              <Image Width="16" Height="16" Source="../icons/MainWindow/go-up-search.png" />
                            </Button>
                            <Button Grid.Column="7" Click="SearchDown_Click">
                              <Image Width="16" Height="16" Source="../icons/MainWindow/go-down-search.png" />
                            </Button>
                            <Button Grid.Column="8" Margin="5 0 0 0" Click="CloseSearch_Click">
                              <Image Width="16" Height="16" Source="../icons/delete16.png" />
                            </Button>
                            <!-- Replace row: file editor tabs only, shown with Ctrl+H. -->
                            <TextBlock Grid.Row="1" Text="Replace: " VerticalAlignment="Center" Visibility="{Binding IsReplaceVisible, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox Name="txtReplace" Grid.Row="1" Grid.Column="1" Margin="0 2 0 0" VerticalContentAlignment="Center" VerticalAlignment="Center" Text="{Binding ReplacementText, UpdateSourceTrigger=PropertyChanged}" KeyDown="txtReplace_KeyDown" Visibility="{Binding IsReplaceVisible, Converter={StaticResource BoolToVisibility}}" />
                            <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" Margin="0 2 0 0" Padding="4 0" Content="Replace" ToolTip="Replace the current match and find the next one (Enter)" Click="Replace_Click" Visibility="{Binding IsReplaceVisible, Converter={StaticResource BoolToVisibility}}" />
                            <Button Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="3" Margin="2 2 0 0" Padding="4 0" Content="All" ToolTip="Replace all matches in the file (one undo step)" Click="ReplaceAll_Click" Visibility="{Binding IsReplaceVisible, Converter={StaticResource BoolToVisibility}}" />
                            <!-- What the last search or replace found (replaces the "Cannot find" boxes in file editor tabs). -->
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="9" Margin="0 2 0 0" TextWrapping="Wrap" Text="{Binding ResultText}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />
                          </Grid>
                        </Border>
                        <ContentControl Grid.Row="2" Content="{Binding Control}" />
                        <!-- The vertical scroll bar belongs to the editor row only, not to the tool bar above it. -->
                        <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding VerticalScrollBar}" />
                        <ContentControl Grid.Row="3" Grid.ColumnSpan="2" Content="{Binding HorizontalScrollBar}" />
                        <ContentControl Grid.Row="4" Grid.ColumnSpan="2" HorizontalContentAlignment="Stretch" Content="{Binding StatusBar}" />
                      </Grid>
                    </DataTemplate>
                  </TabControl.ContentTemplate>
                </TabControl>
              </ContentControl>
              <local:ConnectionClosedPopup VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1" DataContext="{Binding Fixer}" TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type local:ConnectionClosedPopup}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </local:ConnectionClosedPopup>
            </Grid>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
      <GridSplitter Grid.Row="1" Grid.ColumnSpan="2" Height="2" VerticalAlignment="Top" Panel.ZIndex="1" ResizeDirection="Rows" HorizontalAlignment="Stretch" Visibility="{Binding Path=Visibility, ElementName=TransferDock}" />
      <ContentControl Name="TransferDock" Style="{StaticResource DockedContentWithHeader}" Grid.Row="1" Grid.ColumnSpan="2" Margin="0 2 0 0" DataContext="{Binding Path=ActiveSession.SCPController}" IsVisibleChanged="SCPVisibleChanged">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ToolBar>
            <ToggleButton ToolTip="Pause All" Style="{DynamicResource DynamicToggleButtonStyle}" IsChecked="{Binding IsPaused}">
              <Image Width="16" Height="16" Source="../icons/transfers/pause16.png" />
            </ToggleButton>
            <Button ToolTip="Remove completed" Style="{DynamicResource DynamicButton}" Click="RemoveCompleted_Click">
              <Image Width="16" Height="16" Source="../icons/transfers/removecomp.png" />
            </Button>
            <Button ToolTip="Remove all (cancels the transfers that are not finished)" Style="{DynamicResource DynamicButton}" Click="RemoveAll_Click">
              <Image Width="16" Height="16" Source="../icons/transfers/removeall.png" />
            </Button>
            <Button ToolTip="Retry all (also transfers the completed ones again)" Style="{DynamicResource DynamicButton}" Click="RetryAll_Click">
              <Image Width="16" Height="16" Source="../icons/transfers/retryall.png" />
            </Button>
          </ToolBar>
          <!-- Free disk space of the SSH host (df -h every 10 s), hidden until the first reading arrives. -->
          <Border Grid.Row="2" Padding="4 2 4 2" DataContext="{Binding Path=DataContext.ActiveSession.DiskSpace, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" ToolTip="{Binding ToolTipText}" TextBlock.Foreground="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Border}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsStale}" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel Orientation="Horizontal">
              <ProgressBar Width="200" Height="12" Minimum="0" Maximum="100" VerticalAlignment="Center" Value="{Binding UsedPercent, Mode=OneWay}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type ProgressBar}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsLow}" Value="True">
                        <Setter Property="Foreground" Value="Firebrick" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </ProgressBar>
              <TextBlock Margin="8 0 0 0" VerticalAlignment="Center" Text="{Binding Text}" />
            </StackPanel>
          </Border>
          <ListView Name="TransferList" Grid.Row="1" ItemsSource="{Binding ActiveTransfers}" KeyDown="ListView_KeyDown" SelectionChanged="TransferList_SelectionChanged">
            <FrameworkElement.ContextMenu>
              <ContextMenu Name="xferMenu" Visibility="Collapsed">
                <MenuItem Name="cmdCancel" Header="_Cancel transfer(s)" Click="SelectedXfers_Cancel">
                  <MenuItem.Icon>
                    <Image Source="../icons/delete16.png" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Name="cmdRetry" Header="_Retry transfer(s)" Click="SelectedXfers_Retry">
                  <MenuItem.Icon>
                    <Image Source="../icons/MainWindow/refresh16.png" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Name="cmdRetryAgain" Header="Retry _again (also if completed)" Click="SelectedXfers_RetryAgain">
                  <MenuItem.Icon>
                    <Image Source="../icons/MainWindow/refresh16.png" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Retry all _failed" Click="RetryFailed_Click">
                  <MenuItem.Icon>
                    <Image Source="../icons/transfers/retryall.png" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Open local file" Click="SelectedXfers_OpenLocal">
                  <MenuItem.Icon>
                    <Image Source="../icons/MainWindow/document_flat.png" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open containing folder" Click="SelectedXfers_OpenFolder">
                  <MenuItem.Icon>
                    <Image Source="../icons/MainWindow/folder_flat.png" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Copy local file path" Click="SelectedXfers_CopyLocalPath">
                  <MenuItem.Icon>
                    <Image Source="../icons/MainWindow/copy.png" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Copy remote _path" Click="SelectedXfers_CopyRemotePath">
                  <MenuItem.Icon>
                    <Image Source="../icons/MainWindow/copy.png" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator Name="sepDeleteUploaded" />
                <MenuItem Name="cmdDeleteUploaded" Header="_Delete uploaded file(s) from the server..." Click="SelectedXfers_DeleteUploaded">
                  <MenuItem.Icon>
                    <Image Source="../icons/delete16.png" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </FrameworkElement.ContextMenu>
            <ListView.View>
              <GridView>
                <GridView.Columns>
                  <GridViewColumn Header="Local file">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Grid ToolTip="{Binding ToolTip}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Image Width="16" Height="16" Panel.ZIndex="0">
                            <FrameworkElement.Style>
                              <Style TargetType="{x:Type Image}">
                                <Style.Triggers>
                                  <DataTrigger Value="Up" Binding="{Binding Path=Images.Main}">
                                    <Setter Property="Source" Value="../icons/transfers/up.png" />
                                  </DataTrigger>
                                  <DataTrigger Value="Down" Binding="{Binding Path=Images.Main}">
                                    <Setter Property="Source" Value="../icons/transfers/down.png" />
                                  </DataTrigger>
                                  <DataTrigger Value="Done" Binding="{Binding Path=Images.Main}">
                                    <Setter Property="Source" Value="../icons/transfers/check.png" />
                                  </DataTrigger>
                                  <DataTrigger Value="Error" Binding="{Binding Path=Images.Main}">
                                    <Setter Property="Source" Value="../icons/transfers/delete16.png" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                          </Image>
                          <Image Width="9" Height="9" Panel.ZIndex="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <FrameworkElement.Style>
                              <Style TargetType="{x:Type Image}">
                                <Style.Triggers>
                                  <DataTrigger Value="Clock" Binding="{Binding Path=Images.Overlay}">
                                    <Setter Property="Source" Value="../icons/transfers/clock9.png" />
                                  </DataTrigger>
                                  <DataTrigger Value="Pause" Binding="{Binding Path=Images.Overlay}">
                                    <Setter Property="Source" Value="../icons/transfers/pause9.png" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                          </Image>
                          <TextBlock Grid.Column="1" Margin="2 0 0 0" Text="{Binding LocalFile}" />
                        </Grid>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Remote file" DisplayMemberBinding="{Binding RemoteFile}" />
                  <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" />
                  <GridViewColumn Header="Transfer rate" DisplayMemberBinding="{Binding TransferRate}" />
                  <GridViewColumn Header="Status" Width="180">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding StatusText}" ToolTip="{Binding ToolTip}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Progress" Width="100" x:Name="WidthColumn">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Grid HorizontalAlignment="Stretch" Margin="0 0 -10 0" Width="{Binding Path=ActualWidth, ElementName=WidthColumn}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ProgressBar Maximum="1" HorizontalAlignment="Stretch" Height="10" Width="Auto" Margin="2" MinWidth="10" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding ProgressVisibility}" />
                          <Button Style="{StaticResource DynamicButton}" Grid.Column="1" Visibility="{Binding CancelVisibility}" Click="CancelTransfer">
                            <Image Width="16" Height="16" Source="../icons/delete16.png" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView.Columns>
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </ContentControl>
    </Grid>
    <Popup Name="NewConnectionPopup" Placement="Relative" StaysOpen="False" AllowsTransparency="True" Closed="NewConnectionPopup_Closed">
      <Border Style="{DynamicResource PopupBorder}">
        <Grid DataContext="{Binding NewConnectionController}">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Open another session " Margin="0 0 15 0" VerticalAlignment="Center" />
          <TextBlock Text="filter: " Grid.Column="1" VerticalAlignment="Center" />
          <TextBox Grid.Column="2" MinWidth="100" Margin="5" Text="{Binding Path=Filter, UpdateSourceTrigger=PropertyChanged}" />
          <ContentControl Grid.Row="1" Grid.ColumnSpan="3">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type ContentControl}">
                <Setter Property="IsEnabled" Value="False" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Path=ProgressText}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="True" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <ListBox Name="lstConnections" ItemsSource="{Binding Path=FilteredSettings}" SelectionChanged="NewConnectionSelected">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Grid}">
                        <Style.Triggers>
                          <DataTrigger Value="true" Binding="{Binding IsInactive}">
                            <Setter Property="UIElement.Opacity" Value="0.5" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="ConnectionDetail" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image Width="48" Height="48" Grid.RowSpan="4" Margin="0 0 5 0" Panel.ZIndex="0" Source="{Binding Image}" />
                    <TextBlock Grid.Column="2" Grid.Row="1" FontWeight="Bold" Margin="0" Text="{Binding Title}" />
                    <Grid Column="2" Row="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Image Width="16" Height="16">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type Image}">
                            <Style.Triggers>
                              <DataTrigger Value="Lock" Binding="{Binding TypeImage}">
                                <Setter Property="Source" Value="../Icons/lock16.png" />
                              </DataTrigger>
                              <DataTrigger Value="OpenLock" Binding="{Binding TypeImage}">
                                <Setter Property="Source" Value="../Icons/unlock16.png" />
                              </DataTrigger>
                              <DataTrigger Value="SerialPort" Binding="{Binding TypeImage}">
                                <Setter Property="Source" Value="../Icons/com16.png" />
                              </DataTrigger>
                              <DataTrigger Value="USB" Binding="{Binding TypeImage}">
                                <Setter Property="Source" Value="../Icons/usb16.png" />
                              </DataTrigger>
                              <DataTrigger Value="Terminal" Binding="{Binding TypeImage}">
                                <Setter Property="Source" Value="../Icons/term16.png" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </Image>
                      <TextBlock Grid.Column="1" Margin="2 0 0 0" Text="{Binding Detail1}" />
                    </Grid>
                    <TextBlock Grid.Row="3" Grid.Column="2" Opacity="0.7" Text="{Binding Detail2}">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Style.Triggers>
                            <DataTrigger Value="true" Binding="{Binding HasBaudRate}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
          </ContentControl>
          <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="5 0 0 0" Text="{Binding ProgressText}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ProgressText}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
        </Grid>
      </Border>
    </Popup>
    <StatusBar Grid.Row="2" DataContext="{Binding ToolStrip}" Visibility="{Binding StatusBarVisibility}">
      <TextBlock Text="{Binding Path=Status1}" />
      <ProgressBar Width="200" Height="12" Maximum="1" Visibility="{Binding ProgressVisibility}" Value="{Binding Progress}" />
      <StatusBarItem HorizontalContentAlignment="Right" Margin="0 0 20 0">
        <TextBlock Text="{Binding Status2}" />
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>