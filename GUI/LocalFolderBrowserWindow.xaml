<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.LocalFolderBrowserWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="Select a Folder" Width="420" Height="420" MinWidth="360" MinHeight="240" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TreeView Grid.Row="0" Name="FolderTree" MinHeight="160" SelectedItemChanged="FolderTree_SelectedItemChanged" />
    <DockPanel Grid.Row="1" Margin="0 6 0 0">
      <Button DockPanel.Dock="Right" Name="NewFolderButton" Content="New folder" MinWidth="85" Margin="4 0 0 0" Click="NewFolder_Click" />
      <Button DockPanel.Dock="Right" Name="RefreshButton" Content="Refresh" MinWidth="75" Margin="4 0 0 0" Click="Refresh_Click" />
      <TextBlock DockPanel.Dock="Left" Text="Folder:" VerticalAlignment="Center" Margin="0 0 6 0" />
      <TextBox Name="FolderBox" KeyDown="FolderBox_KeyDown" />
    </DockPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
      <Button Name="OkButton" Content="OK" IsDefault="True" MinWidth="75" Margin="0 0 5 0" Click="Ok_Click" />
      <Button Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="75" />
    </StackPanel>
  </Grid>
</Window>
