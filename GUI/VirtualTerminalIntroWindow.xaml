<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.VirtualTerminalIntroWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:SmarTTY.GUI" Style="{DynamicResource SecondaryWindowStyle}" Title="Virtual Terminals" Width="600" SizeToContent="Height" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="10">
    <TextBlock Text="This version of SmarTTY introduces a new Smart Terminal mode. When editing command lines inside Smart Terminal tabs, SmarTTY will let you use mouse and Windows key shortcuts, show command suggestion popups and display the list of files in the current directory in a separate docked pane." TextWrapping="Wrap" />
    <TextBlock Text="Please select the type of a terminal to create for the new session:" Margin="0 5 0 0" />
    <Button Padding="5" Margin="5" Click="Smart_Click">
      <StackPanel Orientation="Horizontal">
        <Image Width="16" Height="16" Source="../icons/event16.png" Margin="0 0 5 0" />
        <TextBlock Text="Start with a Smart Terminal" />
      </StackPanel>
    </Button>
    <Button Padding="5" Margin="5" Click="Normal_Click">
      <StackPanel Orientation="Horizontal">
        <Image Width="16" Height="16" Source="../icons/term16.png" Margin="0 0 5 0" />
        <TextBlock Text="Start with a regular Terminal" />
      </StackPanel>
    </Button>
    <CheckBox Name="cbRemember" Content="Remember the choice for all further sessions" Margin="5" />
  </StackPanel>
</Window>