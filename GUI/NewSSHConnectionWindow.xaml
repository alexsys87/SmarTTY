<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.NewSSHConnectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:SmarTTY.GUI" Style="{DynamicResource SecondaryWindowStyle}" SizeToContent="Height" Width="600" FocusManager.FocusedElement="{Binding ElementName=txtHostName}" Title="{Binding Path=Customization.Caption}">
  <StackPanel>
    <StackPanel Margin="10" Grid.IsSharedSizeScope="True">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <local:EnumValueFetcher x:Key="EnumValueFetcher" />
          <local:EnumValueConverter x:Key="EnumValueConverter" />
          <local:AuthTemplateSelector x:Key="AuthTemplateSelector">
            <local:AuthTemplateSelector.Password>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AuthTypeGroup" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <RadioButton Content="Password:" VerticalAlignment="Center" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}}" />
                  <PasswordBox Grid.Column="1" VerticalAlignment="Center" Margin="5" IsEnabled="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}}" Loaded="PasswordBox_Loaded" PasswordChanged="PasswordBox_PasswordChanged" />
                  <CheckBox Grid.ColumnSpan="2" Grid.Row="1" Margin="20 0 0 2" IsChecked="{Binding Path=DataContext.SetupPublicKey, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:NewSSHConnectionWindow}}}" IsEnabled="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}}">
                    <TextBlock>
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Setter Property="Text" Value="Setup public key authentication and don't ask for password again" />
                          <Style.Triggers>
                            <DataTrigger Value="true" Binding="{Binding Path=DataContext.Customization.AllowSavingPassword, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:NewSSHConnectionWindow}}}">
                              <Setter Property="Text" Value="Setup public key authentication (more secure than saving the password)" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                  </CheckBox>
                </Grid>
              </DataTemplate>
            </local:AuthTemplateSelector.Password>
            <local:AuthTemplateSelector.PublicKey>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <RadioButton Content="Public key in Windows key store (associated with your user account):" VerticalAlignment="Center" Margin="0 0 5 0" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}}" />
                  <ListBox Style="{DynamicResource HorizontalListBox}" VerticalAlignment="Center" ItemsSource="{Binding Path=DataContext.KeyType, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:NewSSHConnectionWindow}}, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding Path=DataContext.KeyType, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:NewSSHConnectionWindow}}}" IsEnabled="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}}" />
                </StackPanel>
              </DataTemplate>
            </local:AuthTemplateSelector.PublicKey>
            <local:AuthTemplateSelector.OpenSSHKey>
              <DataTemplate>
                <StackPanel>
                  <RadioButton Content="OpenSSH key" Grid.ColumnSpan="3" Margin="0 5 0 5" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}}" />
                  <Grid IsEnabled="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition />
                      <RowDefinition />
                      <RowDefinition />
                    </Grid.RowDefinitions>
                    <CheckBox Name="cbOverrideKey" Margin="20 0 0 0" Grid.Row="1" Grid.Column="0" Content="Override default key location:" VerticalAlignment="Center" IsChecked="{Binding Path=DataContext.HasCustomSSHKeyFile, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:NewSSHConnectionWindow}}}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="5" Text="{Binding Path=DataContext.CustomSSHKeyFile, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:NewSSHConnectionWindow}}}" IsEnabled="{Binding IsChecked, ElementName=cbOverrideKey}" />
                    <Button ToolTip="Browse..." Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Style="{DynamicResource DynamicButton}" IsEnabled="{Binding IsChecked, ElementName=cbOverrideKey}" Click="Browse_Click">
                      <Image Width="16" Height="16" Source="../icons/open16.png" />
                    </Button>
                    <CheckBox Name="cbPassphraseKey" Margin="20 0 0 0" Grid.Row="2" Grid.Column="0" Content="Passphrase:" VerticalAlignment="Center" IsChecked="{Binding Path=DataContext.HasPassphrase, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:NewSSHConnectionWindow}}}" />
                    <PasswordBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="5 5 0 5" IsEnabled="{Binding IsChecked, ElementName=cbPassphraseKey}" Loaded="PassphraseBox_Loaded" PasswordChanged="PassphraseBox_PasswordChanged" />
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </local:AuthTemplateSelector.OpenSSHKey>
          </local:AuthTemplateSelector>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type StackPanel}">
          <Setter Property="IsEnabled" Value="False" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ProgressText}" Value="{x:Null}">
              <Setter Property="IsEnabled" Value="True" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <TextBlock FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 5" Text="{Binding Path=Customization.HeaderText}" />
      <Grid Margin="0 0 0 5">
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="UpperLabelColumn" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Width="48" Height="48" Source="../icons/user48.png" Margin="5 5 10 5" Grid.RowSpan="2" />
        <TextBlock Text="Host Name:" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0 0 5 0" />
        <TextBox Name="txtHostName" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="{Binding HostName, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged" />
        <TextBlock Text="User Name:" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="{Binding UserName}" />
      </Grid>
      <Grid>
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Grid}">
            <Style.Triggers>
              <DataTrigger Value="false" Binding="{Binding Path=Customization.ShowAliasField}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="63" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="UpperLabelColumn" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <CheckBox Name="cbAlias" Content="Connection alias:" Grid.ColumnSpan="2" VerticalAlignment="Center" IsChecked="{Binding HasAlias}" />
        <TextBox Grid.Column="2" IsEnabled="{Binding Path=IsChecked, ElementName=cbAlias}" Text="{Binding ConnectionAlias}" />
      </Grid>
      <GroupBox Margin="0 5 0 5">
        <HeaderedContentControl.Header>
          <StackPanel Orientation="Horizontal">
            <Image Width="16" Height="16" Source="../icons/MainWindow/pubkey.png" />
            <TextBlock Text="Authentication method" />
          </StackPanel>
        </HeaderedContentControl.Header>
        <ListBox BorderThickness="0" Grid.IsSharedSizeScope="True" HorizontalContentAlignment="Stretch" ItemsSource="{Binding AuthenticationType, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding AuthenticationType}" Background="{Binding Background, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type StackPanel}}}">
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="{x:Type ListBoxItem}">
              <Setter Property="Focusable" Value="False" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <ContentPresenter ContentTemplateSelector="{StaticResource AuthTemplateSelector}" Focusable="False" HorizontalAlignment="Stretch" Content="{Binding}" />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ItemsControl.ItemContainerStyle>
        </ListBox>
      </GroupBox>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Thickness x:Key="CheckBoxMargin">0 5 0 5</Thickness>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <CheckBox Name="cbProxy" Content="Use HTTP CONNECT proxy:" Margin="{StaticResource CheckBoxMargin}" IsChecked="{Binding UseConnectProxy}" />
        <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Proxy}" IsEnabled="{Binding Path=IsChecked, ElementName=cbProxy}" />
        <CheckBox Content="Enable zlib compression (recommended for slow connections)" Grid.ColumnSpan="2" Grid.Row="1" Margin="{StaticResource CheckBoxMargin}" IsChecked="{Binding UseZlib}" />
        <ContentControl Margin="{StaticResource CheckBoxMargin}" Grid.Row="2">
          <TextBlock Text="Transfer folders using:" Margin="20 0 0 0" />
        </ContentControl>
        <ListBox Style="{DynamicResource HorizontalListBox}" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding TransferMode, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding TransferMode}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EnumValueConverter}}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
        <CheckBox Name="cbKeepAlive" Content="Enable keep-alive packets every:" Grid.Row="3" Margin="{StaticResource CheckBoxMargin}" IsChecked="{Binding HasKeepaliveInterval}" />
        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding Path=IsChecked, ElementName=cbKeepAlive}">
          <TextBox Width="100" Text="{Binding KeepAliveInterval}" />
          <TextBlock Text=" seconds" VerticalAlignment="Center" />
        </StackPanel>
        <CheckBox Content="Forward X11 (graphical programs open their windows here through VcXsrv)" Grid.ColumnSpan="2" Grid.Row="4" Margin="{StaticResource CheckBoxMargin}" IsChecked="{Binding ForwardX11}" ToolTip="Like ssh -X: the server sets DISPLAY for programs started in terminal tabs. Needs xauth and X11Forwarding yes on the server; SmarTTY offers to start or install VcXsrv when the first program connects." />
        <CheckBox Content="Start SOCKS5 proxy on connect (like ssh -D; address and port are set in Tools &gt; SOCKS5 proxy over SSH)" Grid.ColumnSpan="2" Grid.Row="5" Margin="{StaticResource CheckBoxMargin}" IsChecked="{Binding AutoStartSocksProxy}" ToolTip="Opens a SOCKS5 proxy on this computer (127.0.0.1:1080 unless changed in Tools &gt; SOCKS5 proxy over SSH) as soon as the connection is established, so that other programs can reach the network through the SSH server. Every connection that starts it needs its own port: if the port is taken, SmarTTY reports it and the connection works as usual." />
        <CheckBox Content="Save this connection to connections list" Grid.Row="6" Margin="0 10 0 0" IsChecked="{Binding SaveSettings}" Visibility="{Binding Path=Customization.SaveCheckboxVisibility}" />
      </Grid>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Margin="5 0 0 0" Text="{Binding ProgressText}" />
      <ProgressBar IsIndeterminate="True" Grid.Column="1" Margin="5">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ProgressText}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </ProgressBar>
      <Button Width="60" Grid.Column="2" Margin="5" IsDefault="True" Click="OK_Click">
        <AccessText Text="{Binding Path=Customization.ConnectButtonText}" />
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="IsEnabled" Value="False" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ProgressText}" Value="{x:Null}">
                <Setter Property="IsEnabled" Value="True" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Button>
      <Button Width="60" Grid.Column="3" Content="Cancel" Margin="5" Click="Cancel_Click" />
    </Grid>
  </StackPanel>
</Window>