<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.ErrorDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="SmarTTY" Width="620" Height="360" MinWidth="360" MinHeight="200" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Name="HeaderText" Grid.Row="0" Text="An error occurred" FontSize="14" TextWrapping="Wrap" Margin="0 0 0 8" />
    <!-- Read-only, but selectable: the user can select any part of the output and copy it with Ctrl+C. -->
    <TextBox Name="DetailsBox" Grid.Row="1" IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, Courier New" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    <DockPanel Grid.Row="2" LastChildFill="False" Margin="0 10 0 0">
      <TextBlock Name="CopiedText" DockPanel.Dock="Left" Text="Copied to the clipboard" Visibility="Hidden" VerticalAlignment="Center" />
      <Button Content="Close" DockPanel.Dock="Right" IsDefault="True" IsCancel="True" MinWidth="80" Margin="8 0 0 0" Padding="10 2 10 2" />
      <Button Name="CopyButton" Content="Copy all" DockPanel.Dock="Right" MinWidth="80" Padding="10 2 10 2" ToolTip="Copy the whole text to the clipboard" Click="Copy_Click" />
    </DockPanel>
  </Grid>
</Window>
