<?xml version="1.0" encoding="utf-8"?>
<!--
  Dracula palette (draculatheme.com): a dark background with violet, cyan and pink accents. It defines the same keys as Dark/Colors.xaml (see the comment there).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="Theme.WindowBackground" Color="#282A36" />
  <SolidColorBrush x:Key="Theme.SurfaceBackground" Color="#343746" />
  <SolidColorBrush x:Key="Theme.SurfaceAltBackground" Color="#2E3140" />
  <SolidColorBrush x:Key="Theme.ContentBackground" Color="#282A36" />
  <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#343746" />
  <SolidColorBrush x:Key="Theme.InputBackground" Color="#21222C" />
  <SolidColorBrush x:Key="Theme.PopupBackground" Color="#343746" />

  <!-- Buttons and other clickable controls -->
  <SolidColorBrush x:Key="Theme.ControlBackground" Color="#44475A" />
  <SolidColorBrush x:Key="Theme.ControlHoverBackground" Color="#4E5268" />
  <SolidColorBrush x:Key="Theme.ControlPressedBackground" Color="#585C73" />
  <SolidColorBrush x:Key="Theme.ControlDisabledBackground" Color="#2E3040" />

  <!-- List items, menu items, tabs -->
  <SolidColorBrush x:Key="Theme.ItemHoverBackground" Color="#3A3D4D" />
  <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#3E4252" />
  <SolidColorBrush x:Key="Theme.ItemSelectedBackground" Color="#4A4E63" />
  <SolidColorBrush x:Key="Theme.ItemSelectedInactiveBackground" Color="#383B49" />
  <SolidColorBrush x:Key="Theme.ItemSelectedForeground" Color="#F8F8F2" />

  <!-- Accent: default buttons, checked boxes, progress, the active tab marker -->
  <SolidColorBrush x:Key="Theme.Accent" Color="#BD93F9" />
  <SolidColorBrush x:Key="Theme.AccentBackground" Color="#5F3B9B" />
  <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#54348A" />
  <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#482D78" />
  <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFF" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Theme.Border" Color="#4A4D60" />
  <SolidColorBrush x:Key="Theme.BorderStrong" Color="#6E7291" />
  <SolidColorBrush x:Key="Theme.FocusBorder" Color="#BD93F9" />
  <SolidColorBrush x:Key="Theme.Divider" Color="#44475C" />

  <!-- Text -->
  <SolidColorBrush x:Key="Theme.Text" Color="#F8F8F2" />
  <SolidColorBrush x:Key="Theme.TextSecondary" Color="#C8CAD8" />
  <SolidColorBrush x:Key="Theme.TextDisabled" Color="#8C90A8" />
  <SolidColorBrush x:Key="Theme.Link" Color="#8BE9FD" />
  <SolidColorBrush x:Key="Theme.LinkHover" Color="#B6F1FF" />
  <SolidColorBrush x:Key="Theme.Error" Color="#FF7B85" />
  <SolidColorBrush x:Key="Theme.TextSelection" Color="#4C5A8A" />

  <!-- File list: names coloured by access permissions -->
  <SolidColorBrush x:Key="Theme.Permission.ReadOnly" Color="#9AA0B5" />
  <SolidColorBrush x:Key="Theme.Permission.Executable" Color="#50FA7B" />
  <SolidColorBrush x:Key="Theme.Permission.SetId" Color="#FFB86C" />
  <SolidColorBrush x:Key="Theme.Permission.WorldWritable" Color="#FF5555" />

  <!-- Scroll bars -->
  <SolidColorBrush x:Key="Theme.ScrollTrack" Color="Transparent" />
  <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#555A70" />
  <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#6A708A" />
  <SolidColorBrush x:Key="Theme.ScrollThumbPressed" Color="#828AA6" />

  <!-- System colours, for the parts of the stock control templates that still refer to them -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#21222C" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F8F8F2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#343746" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F8F8F2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#8C90A8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4A4E63" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F8F8F2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#383B49" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F8F8F2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#343746" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F8F8F2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#343746" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#F8F8F2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#4A4D60" />
</ResourceDictionary>
