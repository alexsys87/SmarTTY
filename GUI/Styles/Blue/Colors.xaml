<?xml version="1.0" encoding="utf-8"?>
<!--
  Blue palette. A deep navy background with a bright blue accent. It defines the same keys as Dark/Colors.xaml (see the comment there).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="Theme.WindowBackground" Color="#0D1B2A" />
  <SolidColorBrush x:Key="Theme.SurfaceBackground" Color="#14263D" />
  <SolidColorBrush x:Key="Theme.SurfaceAltBackground" Color="#102033" />
  <SolidColorBrush x:Key="Theme.ContentBackground" Color="#0F2036" />
  <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#14263D" />
  <SolidColorBrush x:Key="Theme.InputBackground" Color="#0A1524" />
  <SolidColorBrush x:Key="Theme.PopupBackground" Color="#14263D" />

  <!-- Buttons and other clickable controls -->
  <SolidColorBrush x:Key="Theme.ControlBackground" Color="#1E3A5F" />
  <SolidColorBrush x:Key="Theme.ControlHoverBackground" Color="#27496F" />
  <SolidColorBrush x:Key="Theme.ControlPressedBackground" Color="#2F5680" />
  <SolidColorBrush x:Key="Theme.ControlDisabledBackground" Color="#16283E" />

  <!-- List items, menu items, tabs -->
  <SolidColorBrush x:Key="Theme.ItemHoverBackground" Color="#1B3350" />
  <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#1D3653" />
  <SolidColorBrush x:Key="Theme.ItemSelectedBackground" Color="#2E6AD6" />
  <SolidColorBrush x:Key="Theme.ItemSelectedInactiveBackground" Color="#23384F" />
  <SolidColorBrush x:Key="Theme.ItemSelectedForeground" Color="#FFFFFF" />

  <!-- Accent: default buttons, checked boxes, progress, the active tab marker -->
  <SolidColorBrush x:Key="Theme.Accent" Color="#4C8DFF" />
  <SolidColorBrush x:Key="Theme.AccentBackground" Color="#2E6AD6" />
  <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#2A60C4" />
  <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#1F57C0" />
  <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFF" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Theme.Border" Color="#3A5A80" />
  <SolidColorBrush x:Key="Theme.BorderStrong" Color="#5B82AD" />
  <SolidColorBrush x:Key="Theme.FocusBorder" Color="#4C8DFF" />
  <SolidColorBrush x:Key="Theme.Divider" Color="#22364D" />

  <!-- Text -->
  <SolidColorBrush x:Key="Theme.Text" Color="#E6EEF8" />
  <SolidColorBrush x:Key="Theme.TextSecondary" Color="#A9BDD4" />
  <SolidColorBrush x:Key="Theme.TextDisabled" Color="#7E93AB" />
  <SolidColorBrush x:Key="Theme.Link" Color="#6CB4FF" />
  <SolidColorBrush x:Key="Theme.LinkHover" Color="#A8D3FF" />
  <SolidColorBrush x:Key="Theme.Error" Color="#FF8A80" />
  <SolidColorBrush x:Key="Theme.TextSelection" Color="#3D7BE6" />

  <!-- File list: names coloured by access permissions -->
  <SolidColorBrush x:Key="Theme.Permission.ReadOnly" Color="#8FA8C4" />
  <SolidColorBrush x:Key="Theme.Permission.Executable" Color="#7EE787" />
  <SolidColorBrush x:Key="Theme.Permission.SetId" Color="#FFB454" />
  <SolidColorBrush x:Key="Theme.Permission.WorldWritable" Color="#FF8A80" />

  <!-- Scroll bars -->
  <SolidColorBrush x:Key="Theme.ScrollTrack" Color="Transparent" />
  <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#4A6A8F" />
  <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#5E82AB" />
  <SolidColorBrush x:Key="Theme.ScrollThumbPressed" Color="#7699C2" />

  <!-- System colours, for the parts of the stock control templates that still refer to them -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0A1524" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E6EEF8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#14263D" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E6EEF8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7E93AB" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2E6AD6" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#23384F" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E6EEF8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#14263D" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E6EEF8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#14263D" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#E6EEF8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#3A5A80" />
</ResourceDictionary>
