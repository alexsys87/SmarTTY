<?xml version="1.0" encoding="utf-8"?>
<!--
  Sepia palette: a warm, low-contrast light theme that is easy on the eyes. It defines the same keys as Dark/Colors.xaml (see the comment there).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="Theme.WindowBackground" Color="#F4ECD8" />
  <SolidColorBrush x:Key="Theme.SurfaceBackground" Color="#FBF5E6" />
  <SolidColorBrush x:Key="Theme.SurfaceAltBackground" Color="#EFE6D2" />
  <SolidColorBrush x:Key="Theme.ContentBackground" Color="#FBF5E6" />
  <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#EAE0C8" />
  <SolidColorBrush x:Key="Theme.InputBackground" Color="#FFFDF6" />
  <SolidColorBrush x:Key="Theme.PopupBackground" Color="#FBF5E6" />

  <!-- Buttons and other clickable controls -->
  <SolidColorBrush x:Key="Theme.ControlBackground" Color="#FFFDF6" />
  <SolidColorBrush x:Key="Theme.ControlHoverBackground" Color="#F1E9D6" />
  <SolidColorBrush x:Key="Theme.ControlPressedBackground" Color="#E7DCC3" />
  <SolidColorBrush x:Key="Theme.ControlDisabledBackground" Color="#F3EDDD" />

  <!-- List items, menu items, tabs -->
  <SolidColorBrush x:Key="Theme.ItemHoverBackground" Color="#F0E8D5" />
  <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#E5DBC3" />
  <SolidColorBrush x:Key="Theme.ItemSelectedBackground" Color="#E3D3A8" />
  <SolidColorBrush x:Key="Theme.ItemSelectedInactiveBackground" Color="#EDE4CE" />
  <SolidColorBrush x:Key="Theme.ItemSelectedForeground" Color="#3B2F1E" />

  <!-- Accent: default buttons, checked boxes, progress, the active tab marker -->
  <SolidColorBrush x:Key="Theme.Accent" Color="#8A6D1F" />
  <SolidColorBrush x:Key="Theme.AccentBackground" Color="#8A6D1F" />
  <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#7A5F17" />
  <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#6B5212" />
  <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFF" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Theme.Border" Color="#D6C8A8" />
  <SolidColorBrush x:Key="Theme.BorderStrong" Color="#A89A78" />
  <SolidColorBrush x:Key="Theme.FocusBorder" Color="#8A6D1F" />
  <SolidColorBrush x:Key="Theme.Divider" Color="#E4DAC2" />

  <!-- Text -->
  <SolidColorBrush x:Key="Theme.Text" Color="#3B2F1E" />
  <SolidColorBrush x:Key="Theme.TextSecondary" Color="#5F5138" />
  <SolidColorBrush x:Key="Theme.TextDisabled" Color="#8A7B5E" />
  <SolidColorBrush x:Key="Theme.Link" Color="#7A5A12" />
  <SolidColorBrush x:Key="Theme.LinkHover" Color="#5E4509" />
  <SolidColorBrush x:Key="Theme.Error" Color="#A82C1C" />
  <SolidColorBrush x:Key="Theme.TextSelection" Color="#E3D3A8" />

  <!-- File list: names coloured by access permissions -->
  <SolidColorBrush x:Key="Theme.Permission.ReadOnly" Color="#6E6350" />
  <SolidColorBrush x:Key="Theme.Permission.Executable" Color="#2F6B2A" />
  <SolidColorBrush x:Key="Theme.Permission.SetId" Color="#9A5A00" />
  <SolidColorBrush x:Key="Theme.Permission.WorldWritable" Color="#A82C1C" />

  <!-- Scroll bars -->
  <SolidColorBrush x:Key="Theme.ScrollTrack" Color="Transparent" />
  <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#CDBEA0" />
  <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#B7A681" />
  <SolidColorBrush x:Key="Theme.ScrollThumbPressed" Color="#9E8C66" />

  <!-- System colours, for the parts of the stock control templates that still refer to them -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFDF6" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#3B2F1E" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FBF5E6" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#3B2F1E" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#8A7B5E" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E3D3A8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#3B2F1E" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EDE4CE" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#3B2F1E" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FBF5E6" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#3B2F1E" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FBF5E6" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#3B2F1E" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#D6C8A8" />
</ResourceDictionary>
