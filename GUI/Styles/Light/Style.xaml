<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:gui="clr-namespace:SmarTTY.GUI" xmlns:styles="clr-namespace:SmarTTY.GUI.Styles" xmlns:local="clr-namespace:SmarTTY.GUI.Styles.Light">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="TabControl.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="MainWindowOuterTabControl" TargetType="{x:Type TabControl}" BasedOn="{StaticResource MainWindowTabControl}" />
  <Style x:Key="MainWindowInnerTabControl" TargetType="{x:Type TabControl}" BasedOn="{StaticResource MainWindowTabControl}">
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style x:Key="ThemedTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}" />
  <Style x:Key="HorizontalListBox" TargetType="{x:Type ListBox}">
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SecondaryWindowStyle" TargetType="{x:Type Window}" BasedOn="{StaticResource {x:Type Window}}" />
  <Style x:Key="LightListBoxItem" TargetType="{x:Type ListBoxItem}">
    <Setter Property="AutomationProperties.AutomationId" Value="{Binding}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Border Name="OuterBorder" Padding="3" Margin="1 0 1 0" Background="{Binding Path=Background, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsMouseOver" Value="True" />
                <Condition Property="ListBoxItem.IsSelected" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="OuterBorder" Property="Border.Background" Value="#fdf4bf" />
            </MultiTrigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="OuterBorder" Property="Border.Background" Value="#e5c365" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
  </Style>
  <Style x:Key="{x:Type Popup}" TargetType="{x:Type Popup}">
    <Style.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type Border}" TargetType="{x:Type Border}">
          <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
          <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
          <Setter Property="TextBlock.Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        </Style>
        <Style x:Key="{x:Type ListBox}" TargetType="{x:Type ListBox}">
          <Setter Property="ItemContainerStyle" Value="{StaticResource LightListBoxItem}" />
        </Style>
      </ResourceDictionary>
    </Style.Resources>
  </Style>
  <Style x:Key="DynamicToggleButtonLight" TargetType="{x:Type ToggleButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Height="Auto" Width="Auto" Padding="2 0 2 0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Control}}}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
    <Setter Property="BorderBrush" Value="{Binding Path=Background, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Control}}}" />
    <Setter Property="Margin" Value="1 0 1 0" />
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="UIElement.IsMouseOver" Value="True" />
          <Condition Property="IsPressed" Value="False" />
        </MultiTrigger.Conditions>
        <MultiTrigger.Setters>
          <Setter Property="Background" Value="#fdf4bf" />
          <Setter Property="BorderBrush" Value="#e5c365" />
        </MultiTrigger.Setters>
      </MultiTrigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#fff29d" />
        <Setter Property="BorderBrush" Value="#e5c365" />
      </Trigger>
      <Trigger Property="ToggleButton.IsChecked" Value="True">
        <Setter Property="Background" Value="#fff29d" />
        <Setter Property="BorderBrush" Value="#e5c365" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="UIElement.Opacity" Value="0.5" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="DynamicButtonLight" TargetType="{x:Type Button}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Height="Auto" Width="Auto" Padding="2">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Control}}}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
    <Setter Property="BorderBrush" Value="{Binding Path=Background, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Control}}}" />
    <Setter Property="Margin" Value="1 0 1 0" />
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="UIElement.IsMouseOver" Value="True" />
          <Condition Property="IsPressed" Value="False" />
        </MultiTrigger.Conditions>
        <MultiTrigger.Setters>
          <Setter Property="Background" Value="#fdf4bf" />
          <Setter Property="BorderBrush" Value="#e5c365" />
        </MultiTrigger.Setters>
      </MultiTrigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#fff29d" />
        <Setter Property="BorderBrush" Value="#e5c365" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="UIElement.Opacity" Value="0.5" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ToolBarGridStyle" TargetType="{x:Type Grid}">
    <Style.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource DynamicToggleButtonLight}" />
        <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource DynamicButtonLight}" />
      </ResourceDictionary>
    </Style.Resources>
  </Style>
  <Style x:Key="{x:Type gui:ConnectionSelectionWindow}" TargetType="{x:Type gui:ConnectionSelectionWindow}">
    <Style.Resources>
      <ResourceDictionary>
        <Style x:Key="ConnectionPickerListBox" TargetType="{x:Type ListBox}">
          <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
        </Style>
      </ResourceDictionary>
    </Style.Resources>
  </Style>
  <Style x:Key="DockHeaderStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="#FFA9A9A9" />
  </Style>
  <SolidColorBrush x:Key="{x:Static styles:StyleKeys.HyperlinkColor}">#0066cc</SolidColorBrush>
  <SolidColorBrush x:Key="{x:Static styles:StyleKeys.ActiveHyperlinkColor}">#3399ff</SolidColorBrush>
  <SolidColorBrush x:Key="{x:Static styles:StyleKeys.MainWindowText}" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
  <SolidColorBrush x:Key="{x:Static styles:StyleKeys.DynamicButtonHoverBackground}">#fdf4bf</SolidColorBrush>
  <SolidColorBrush x:Key="{x:Static styles:StyleKeys.DynamicButtonHoverBorder}">#e5c365</SolidColorBrush>
  <SolidColorBrush x:Key="{x:Static styles:StyleKeys.DynamicButtonPressedBackground}">#fff29d</SolidColorBrush>
  <SolidColorBrush x:Key="{x:Static styles:StyleKeys.DynamicButtonPressedBorder}">#e5c365</SolidColorBrush>
</ResourceDictionary>