<?xml version="1.0" encoding="utf-8"?>
<!--
  Light palette. It defines the same keys as Dark/Colors.xaml (see the comment there).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="Theme.WindowBackground" Color="#F3F4F6" />
  <SolidColorBrush x:Key="Theme.SurfaceBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Theme.SurfaceAltBackground" Color="#EBEDF0" />
  <SolidColorBrush x:Key="Theme.ContentBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#E8EAEE" />
  <SolidColorBrush x:Key="Theme.InputBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Theme.PopupBackground" Color="#FFFFFF" />

  <!-- Buttons and other clickable controls -->
  <SolidColorBrush x:Key="Theme.ControlBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Theme.ControlHoverBackground" Color="#EEF1F5" />
  <SolidColorBrush x:Key="Theme.ControlPressedBackground" Color="#E2E6EC" />
  <SolidColorBrush x:Key="Theme.ControlDisabledBackground" Color="#F0F1F3" />

  <!-- List items, menu items, tabs -->
  <SolidColorBrush x:Key="Theme.ItemHoverBackground" Color="#EDF0F4" />
  <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#DCDFE5" />
  <SolidColorBrush x:Key="Theme.ItemSelectedBackground" Color="#CFE0FC" />
  <SolidColorBrush x:Key="Theme.ItemSelectedInactiveBackground" Color="#E3E6EA" />
  <SolidColorBrush x:Key="Theme.ItemSelectedForeground" Color="#0B1A33" />

  <!-- Accent: default buttons, checked boxes, progress, the active tab marker -->
  <SolidColorBrush x:Key="Theme.Accent" Color="#1A5FD6" />
  <SolidColorBrush x:Key="Theme.AccentBackground" Color="#1A5FD6" />
  <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#1F57C0" />
  <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#174FB3" />
  <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFF" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Theme.Border" Color="#C4C9D0" />
  <SolidColorBrush x:Key="Theme.BorderStrong" Color="#8A919B" />
  <SolidColorBrush x:Key="Theme.FocusBorder" Color="#1A5FD6" />
  <SolidColorBrush x:Key="Theme.Divider" Color="#DDE0E5" />

  <!-- Text -->
  <SolidColorBrush x:Key="Theme.Text" Color="#1B1D21" />
  <SolidColorBrush x:Key="Theme.TextSecondary" Color="#4F555D" />
  <SolidColorBrush x:Key="Theme.TextDisabled" Color="#7A8089" />
  <SolidColorBrush x:Key="Theme.Link" Color="#0F57C9" />
  <SolidColorBrush x:Key="Theme.LinkHover" Color="#083E94" />
  <SolidColorBrush x:Key="Theme.Error" Color="#C62828" />
  <SolidColorBrush x:Key="Theme.TextSelection" Color="#3D7BE6" />

  <!-- Scroll bars -->
  <SolidColorBrush x:Key="Theme.ScrollTrack" Color="Transparent" />
  <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#B9BEC6" />
  <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#9AA0A9" />
  <SolidColorBrush x:Key="Theme.ScrollThumbPressed" Color="#7D848E" />

  <!-- System colours, for the parts of the stock control templates that still refer to them -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#1B1D21" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#EBEDF0" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1B1D21" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7A8089" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CFE0FC" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0B1A33" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E3E6EA" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B1D21" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#1B1D21" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#1B1D21" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#C4C9D0" />
</ResourceDictionary>
