<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark palette. Every theme palette defines the same set of keys: the control styles in ../Controls.xaml refer to
  them with DynamicResource only, so switching the theme is just swapping this dictionary (see ThemeManager).
  Text colours are checked against every background they are drawn on (WCAG contrast): primary text >= 7:1,
  secondary text >= 4.5:1, text on the accent colour >= 4.5:1.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="Theme.WindowBackground" Color="#1E1F22" />
  <SolidColorBrush x:Key="Theme.SurfaceBackground" Color="#2B2D30" />
  <SolidColorBrush x:Key="Theme.SurfaceAltBackground" Color="#26282B" />
  <SolidColorBrush x:Key="Theme.ContentBackground" Color="#1E1F22" />
  <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#2B2D30" />
  <SolidColorBrush x:Key="Theme.InputBackground" Color="#16171A" />
  <SolidColorBrush x:Key="Theme.PopupBackground" Color="#2B2D30" />

  <!-- Buttons and other clickable controls -->
  <SolidColorBrush x:Key="Theme.ControlBackground" Color="#35373C" />
  <SolidColorBrush x:Key="Theme.ControlHoverBackground" Color="#404349" />
  <SolidColorBrush x:Key="Theme.ControlPressedBackground" Color="#4A4D54" />
  <SolidColorBrush x:Key="Theme.ControlDisabledBackground" Color="#2A2B2E" />

  <!-- List items, menu items, tabs -->
  <SolidColorBrush x:Key="Theme.ItemHoverBackground" Color="#33363B" />
  <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#36393E" />
  <SolidColorBrush x:Key="Theme.ItemSelectedBackground" Color="#264F86" />
  <SolidColorBrush x:Key="Theme.ItemSelectedInactiveBackground" Color="#3A3D43" />
  <SolidColorBrush x:Key="Theme.ItemSelectedForeground" Color="#FFFFFF" />

  <!-- Accent: default buttons, checked boxes, progress, the active tab marker -->
  <SolidColorBrush x:Key="Theme.Accent" Color="#4C8DFF" />
  <SolidColorBrush x:Key="Theme.AccentBackground" Color="#2E6AD6" />
  <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#2A60C4" />
  <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#1F57C0" />
  <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFF" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Theme.Border" Color="#4A4D53" />
  <SolidColorBrush x:Key="Theme.BorderStrong" Color="#6B7079" />
  <SolidColorBrush x:Key="Theme.FocusBorder" Color="#4C8DFF" />
  <SolidColorBrush x:Key="Theme.Divider" Color="#393B40" />

  <!-- Text -->
  <SolidColorBrush x:Key="Theme.Text" Color="#ECEEF1" />
  <SolidColorBrush x:Key="Theme.TextSecondary" Color="#B5BAC1" />
  <SolidColorBrush x:Key="Theme.TextDisabled" Color="#7A7F87" />
  <SolidColorBrush x:Key="Theme.Link" Color="#6CB4FF" />
  <SolidColorBrush x:Key="Theme.LinkHover" Color="#A8D3FF" />
  <SolidColorBrush x:Key="Theme.Error" Color="#FF7B72" />
  <SolidColorBrush x:Key="Theme.TextSelection" Color="#3D7BE6" />

  <!-- Scroll bars -->
  <SolidColorBrush x:Key="Theme.ScrollTrack" Color="Transparent" />
  <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#55585F" />
  <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#6E727A" />
  <SolidColorBrush x:Key="Theme.ScrollThumbPressed" Color="#8A8F98" />

  <!-- System colours, for the parts of the stock control templates that still refer to them -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#16171A" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#ECEEF1" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2B2D30" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#ECEEF1" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7A7F87" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#264F86" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3A3D43" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#ECEEF1" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2B2D30" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#ECEEF1" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#2B2D30" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#ECEEF1" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#4A4D53" />
</ResourceDictionary>
