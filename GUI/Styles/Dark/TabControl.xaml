<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SmarTTY.GUI.Styles">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="MainWindowTabItem" TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Border Name="MainBorder" BorderThickness="1" Focusable="False" TextBlock.Foreground="{StaticResource ActiveTextColor}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{StaticResource InactiveColor}" />
                <Setter Property="BorderBrush" Value="{StaticResource HighlightColor}" />
                <Style.Triggers>
                  <DataTrigger Value="true" Binding="{Binding Path=DataContext.HideHeaders, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TabControl}}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <Border Name="InnerBorder">
              <ContentPresenter Margin="0" Content="{Binding}" ContentTemplate="{Binding Path=ItemTemplate, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TabControl}}}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type ContentPresenter}">
                    <Style.Triggers>
                      <DataTrigger Value="Left" Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TabControl}}}">
                        <Setter Property="FrameworkElement.LayoutTransform">
                          <Setter.Value>
                            <RotateTransform CenterX="0" CenterY="0" Angle="-90" />
                          </Setter.Value>
                        </Setter>
                      </DataTrigger>
                      <DataTrigger Value="Right" Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TabControl}}}">
                        <Setter Property="FrameworkElement.LayoutTransform">
                          <Setter.Value>
                            <RotateTransform CenterX="0" CenterY="0" Angle="90" />
                          </Setter.Value>
                        </Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </ContentPresenter>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsMouseOver" Value="True" />
                <Condition Property="TabItem.IsSelected" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="MainBorder" Property="Border.Background" Value="{StaticResource HighlightColor}" />
            </MultiTrigger>
            <Trigger Property="TabItem.IsSelected" Value="True">
              <Setter TargetName="MainBorder" Property="Border.Background" Value="{StaticResource ActiveColor}" />
            </Trigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="Bottom" Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TabControl}}}" />
                <Condition Value="True" Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="MainBorder" Property="Margin" Value="0 -2 0 0" />
              <Setter TargetName="InnerBorder" Property="Margin" Value="0 3 0 0" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="Left" Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TabControl}}}" />
                <Condition Value="True" Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="MainBorder" Property="Margin" Value="0 0 -2 0" />
              <Setter TargetName="InnerBorder" Property="Margin" Value="0 0 3 0" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="Right" Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TabControl}}}" />
                <Condition Value="True" Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="MainBorder" Property="Margin" Value="-2 0 0 0" />
              <Setter TargetName="InnerBorder" Property="Margin" Value="3 0 0 0" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="Top" Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TabControl}}}" />
                <Condition Value="True" Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="MainBorder" Property="Margin" Value="0 0 0 -2" />
              <Setter TargetName="InnerBorder" Property="Margin" Value="0 0 0 3" />
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MainWindowTabControl" TargetType="{x:Type TabControl}">
    <Style.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}" BasedOn="{StaticResource MainWindowTabItem}" />
      </ResourceDictionary>
    </Style.Resources>
    <Setter Property="Padding" Value="0" />
    <Setter Property="TabControl.TabStripPlacement" Value="Left" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{StaticResource InactiveColor}" />
  </Style>
</ResourceDictionary>