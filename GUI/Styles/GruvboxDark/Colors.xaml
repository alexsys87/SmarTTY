<?xml version="1.0" encoding="utf-8"?>
<!--
  Gruvbox Dark palette (github.com/morhetz/gruvbox): a warm retro dark background with amber accents. It defines the same keys as Dark/Colors.xaml (see the comment there).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="Theme.WindowBackground" Color="#282828" />
  <SolidColorBrush x:Key="Theme.SurfaceBackground" Color="#32302F" />
  <SolidColorBrush x:Key="Theme.SurfaceAltBackground" Color="#2E2C2B" />
  <SolidColorBrush x:Key="Theme.ContentBackground" Color="#282828" />
  <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#32302F" />
  <SolidColorBrush x:Key="Theme.InputBackground" Color="#1D2021" />
  <SolidColorBrush x:Key="Theme.PopupBackground" Color="#32302F" />

  <!-- Buttons and other clickable controls -->
  <SolidColorBrush x:Key="Theme.ControlBackground" Color="#3C3836" />
  <SolidColorBrush x:Key="Theme.ControlHoverBackground" Color="#504945" />
  <SolidColorBrush x:Key="Theme.ControlPressedBackground" Color="#5C534B" />
  <SolidColorBrush x:Key="Theme.ControlDisabledBackground" Color="#32302F" />

  <!-- List items, menu items, tabs -->
  <SolidColorBrush x:Key="Theme.ItemHoverBackground" Color="#3C3836" />
  <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#423E3B" />
  <SolidColorBrush x:Key="Theme.ItemSelectedBackground" Color="#504945" />
  <SolidColorBrush x:Key="Theme.ItemSelectedInactiveBackground" Color="#3A3634" />
  <SolidColorBrush x:Key="Theme.ItemSelectedForeground" Color="#FBF1C7" />

  <!-- Accent: default buttons, checked boxes, progress, the active tab marker -->
  <SolidColorBrush x:Key="Theme.Accent" Color="#FABD2F" />
  <SolidColorBrush x:Key="Theme.AccentBackground" Color="#D79921" />
  <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#E0A526" />
  <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#C78A14" />
  <SolidColorBrush x:Key="Theme.AccentForeground" Color="#1D2021" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Theme.Border" Color="#504945" />
  <SolidColorBrush x:Key="Theme.BorderStrong" Color="#665C54" />
  <SolidColorBrush x:Key="Theme.FocusBorder" Color="#FABD2F" />
  <SolidColorBrush x:Key="Theme.Divider" Color="#3C3836" />

  <!-- Text -->
  <SolidColorBrush x:Key="Theme.Text" Color="#EBDBB2" />
  <SolidColorBrush x:Key="Theme.TextSecondary" Color="#C9B99A" />
  <SolidColorBrush x:Key="Theme.TextDisabled" Color="#928374" />
  <SolidColorBrush x:Key="Theme.Link" Color="#83A598" />
  <SolidColorBrush x:Key="Theme.LinkHover" Color="#A9C9BC" />
  <SolidColorBrush x:Key="Theme.Error" Color="#FF7A66" />
  <SolidColorBrush x:Key="Theme.TextSelection" Color="#504945" />

  <!-- File list: names coloured by access permissions -->
  <SolidColorBrush x:Key="Theme.Permission.ReadOnly" Color="#A89984" />
  <SolidColorBrush x:Key="Theme.Permission.Executable" Color="#B8BB26" />
  <SolidColorBrush x:Key="Theme.Permission.SetId" Color="#FE8019" />
  <SolidColorBrush x:Key="Theme.Permission.WorldWritable" Color="#FB4934" />

  <!-- Scroll bars -->
  <SolidColorBrush x:Key="Theme.ScrollTrack" Color="Transparent" />
  <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#504945" />
  <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#665C54" />
  <SolidColorBrush x:Key="Theme.ScrollThumbPressed" Color="#7C6F64" />

  <!-- System colours, for the parts of the stock control templates that still refer to them -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1D2021" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#EBDBB2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#32302F" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#EBDBB2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#928374" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#504945" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FBF1C7" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3A3634" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#EBDBB2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#32302F" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#EBDBB2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#32302F" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#EBDBB2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#504945" />
</ResourceDictionary>
