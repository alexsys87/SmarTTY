<?xml version="1.0" encoding="utf-8"?>
<!--
  Monokai palette: the classic dark editor scheme with cyan and magenta accents. It defines the same keys as Dark/Colors.xaml (see the comment there).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="Theme.WindowBackground" Color="#272822" />
  <SolidColorBrush x:Key="Theme.SurfaceBackground" Color="#31322B" />
  <SolidColorBrush x:Key="Theme.SurfaceAltBackground" Color="#2D2E27" />
  <SolidColorBrush x:Key="Theme.ContentBackground" Color="#272822" />
  <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#31322B" />
  <SolidColorBrush x:Key="Theme.InputBackground" Color="#1E1F1A" />
  <SolidColorBrush x:Key="Theme.PopupBackground" Color="#31322B" />

  <!-- Buttons and other clickable controls -->
  <SolidColorBrush x:Key="Theme.ControlBackground" Color="#3E3D32" />
  <SolidColorBrush x:Key="Theme.ControlHoverBackground" Color="#4A493C" />
  <SolidColorBrush x:Key="Theme.ControlPressedBackground" Color="#565445" />
  <SolidColorBrush x:Key="Theme.ControlDisabledBackground" Color="#2F3029" />

  <!-- List items, menu items, tabs -->
  <SolidColorBrush x:Key="Theme.ItemHoverBackground" Color="#37372E" />
  <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#3B3B31" />
  <SolidColorBrush x:Key="Theme.ItemSelectedBackground" Color="#4A493C" />
  <SolidColorBrush x:Key="Theme.ItemSelectedInactiveBackground" Color="#38382F" />
  <SolidColorBrush x:Key="Theme.ItemSelectedForeground" Color="#F8F8F2" />

  <!-- Accent: default buttons, checked boxes, progress, the active tab marker -->
  <SolidColorBrush x:Key="Theme.Accent" Color="#66D9EF" />
  <SolidColorBrush x:Key="Theme.AccentBackground" Color="#1F6E7D" />
  <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#1B6371" />
  <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#165663" />
  <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFF" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Theme.Border" Color="#4A493C" />
  <SolidColorBrush x:Key="Theme.BorderStrong" Color="#6E6D5A" />
  <SolidColorBrush x:Key="Theme.FocusBorder" Color="#66D9EF" />
  <SolidColorBrush x:Key="Theme.Divider" Color="#414137" />

  <!-- Text -->
  <SolidColorBrush x:Key="Theme.Text" Color="#F8F8F2" />
  <SolidColorBrush x:Key="Theme.TextSecondary" Color="#C6C7BE" />
  <SolidColorBrush x:Key="Theme.TextDisabled" Color="#8A8B7E" />
  <SolidColorBrush x:Key="Theme.Link" Color="#66D9EF" />
  <SolidColorBrush x:Key="Theme.LinkHover" Color="#A5E9F5" />
  <SolidColorBrush x:Key="Theme.Error" Color="#FF6188" />
  <SolidColorBrush x:Key="Theme.TextSelection" Color="#4A493C" />

  <!-- File list: names coloured by access permissions -->
  <SolidColorBrush x:Key="Theme.Permission.ReadOnly" Color="#A6A28C" />
  <SolidColorBrush x:Key="Theme.Permission.Executable" Color="#A6E22E" />
  <SolidColorBrush x:Key="Theme.Permission.SetId" Color="#FD971F" />
  <SolidColorBrush x:Key="Theme.Permission.WorldWritable" Color="#F92672" />

  <!-- Scroll bars -->
  <SolidColorBrush x:Key="Theme.ScrollTrack" Color="Transparent" />
  <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#4A493C" />
  <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#5C5A49" />
  <SolidColorBrush x:Key="Theme.ScrollThumbPressed" Color="#706E5A" />

  <!-- System colours, for the parts of the stock control templates that still refer to them -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E1F1A" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F8F8F2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#31322B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F8F8F2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#8A8B7E" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4A493C" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F8F8F2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#38382F" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F8F8F2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#31322B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F8F8F2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#31322B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#F8F8F2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#4A493C" />
</ResourceDictionary>
