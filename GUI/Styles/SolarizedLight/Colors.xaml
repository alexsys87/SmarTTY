<?xml version="1.0" encoding="utf-8"?>
<!--
  Solarized Light palette (Ethan Schoonover, base3 background). It defines the same keys as Dark/Colors.xaml (see the comment there).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="Theme.WindowBackground" Color="#FDF6E3" />
  <SolidColorBrush x:Key="Theme.SurfaceBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Theme.SurfaceAltBackground" Color="#EEE8D5" />
  <SolidColorBrush x:Key="Theme.ContentBackground" Color="#FFFDF5" />
  <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#EEE8D5" />
  <SolidColorBrush x:Key="Theme.InputBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Theme.PopupBackground" Color="#FFFFFF" />

  <!-- Buttons and other clickable controls -->
  <SolidColorBrush x:Key="Theme.ControlBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Theme.ControlHoverBackground" Color="#F0EAD8" />
  <SolidColorBrush x:Key="Theme.ControlPressedBackground" Color="#E4DECB" />
  <SolidColorBrush x:Key="Theme.ControlDisabledBackground" Color="#F2EDE0" />

  <!-- List items, menu items, tabs -->
  <SolidColorBrush x:Key="Theme.ItemHoverBackground" Color="#EFE9D7" />
  <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#E0D9C4" />
  <SolidColorBrush x:Key="Theme.ItemSelectedBackground" Color="#BBD8F2" />
  <SolidColorBrush x:Key="Theme.ItemSelectedInactiveBackground" Color="#E6E0CE" />
  <SolidColorBrush x:Key="Theme.ItemSelectedForeground" Color="#073642" />

  <!-- Accent: default buttons, checked boxes, progress, the active tab marker -->
  <SolidColorBrush x:Key="Theme.Accent" Color="#1A6FB5" />
  <SolidColorBrush x:Key="Theme.AccentBackground" Color="#1A6FB5" />
  <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#1764A3" />
  <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#145892" />
  <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFF" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Theme.Border" Color="#C9C0A5" />
  <SolidColorBrush x:Key="Theme.BorderStrong" Color="#8E866C" />
  <SolidColorBrush x:Key="Theme.FocusBorder" Color="#1A6FB5" />
  <SolidColorBrush x:Key="Theme.Divider" Color="#E2DCC8" />

  <!-- Text -->
  <SolidColorBrush x:Key="Theme.Text" Color="#073642" />
  <SolidColorBrush x:Key="Theme.TextSecondary" Color="#4E5A5E" />
  <SolidColorBrush x:Key="Theme.TextDisabled" Color="#6C7A80" />
  <SolidColorBrush x:Key="Theme.Link" Color="#0F63A8" />
  <SolidColorBrush x:Key="Theme.LinkHover" Color="#0A4C86" />
  <SolidColorBrush x:Key="Theme.Error" Color="#C62828" />
  <SolidColorBrush x:Key="Theme.TextSelection" Color="#7FB2E0" />

  <!-- File list: names coloured by access permissions -->
  <SolidColorBrush x:Key="Theme.Permission.ReadOnly" Color="#5A666B" />
  <SolidColorBrush x:Key="Theme.Permission.Executable" Color="#3D7A16" />
  <SolidColorBrush x:Key="Theme.Permission.SetId" Color="#9A5B00" />
  <SolidColorBrush x:Key="Theme.Permission.WorldWritable" Color="#C62828" />

  <!-- Scroll bars -->
  <SolidColorBrush x:Key="Theme.ScrollTrack" Color="Transparent" />
  <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#C3BBA1" />
  <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#A9A088" />
  <SolidColorBrush x:Key="Theme.ScrollThumbPressed" Color="#8F866E" />

  <!-- System colours, for the parts of the stock control templates that still refer to them -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#073642" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#EEE8D5" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#073642" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#6C7A80" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#BBD8F2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#073642" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E6E0CE" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#073642" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#073642" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#073642" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#C9C0A5" />
</ResourceDictionary>
