<?xml version="1.0" encoding="utf-8"?>
<!--
  Midnight palette. A near-black neutral background for low-light use. It defines the same keys as Dark/Colors.xaml (see the comment there).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="Theme.WindowBackground" Color="#0A0A0B" />
  <SolidColorBrush x:Key="Theme.SurfaceBackground" Color="#131316" />
  <SolidColorBrush x:Key="Theme.SurfaceAltBackground" Color="#101013" />
  <SolidColorBrush x:Key="Theme.ContentBackground" Color="#0E0E11" />
  <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#131316" />
  <SolidColorBrush x:Key="Theme.InputBackground" Color="#08080A" />
  <SolidColorBrush x:Key="Theme.PopupBackground" Color="#131316" />

  <!-- Buttons and other clickable controls -->
  <SolidColorBrush x:Key="Theme.ControlBackground" Color="#1C1C20" />
  <SolidColorBrush x:Key="Theme.ControlHoverBackground" Color="#26262B" />
  <SolidColorBrush x:Key="Theme.ControlPressedBackground" Color="#2F2F35" />
  <SolidColorBrush x:Key="Theme.ControlDisabledBackground" Color="#141417" />

  <!-- List items, menu items, tabs -->
  <SolidColorBrush x:Key="Theme.ItemHoverBackground" Color="#1A1A1F" />
  <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#1D1D22" />
  <SolidColorBrush x:Key="Theme.ItemSelectedBackground" Color="#2E6AD6" />
  <SolidColorBrush x:Key="Theme.ItemSelectedInactiveBackground" Color="#202024" />
  <SolidColorBrush x:Key="Theme.ItemSelectedForeground" Color="#FFFFFF" />

  <!-- Accent: default buttons, checked boxes, progress, the active tab marker -->
  <SolidColorBrush x:Key="Theme.Accent" Color="#4C8DFF" />
  <SolidColorBrush x:Key="Theme.AccentBackground" Color="#2E6AD6" />
  <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#2A60C4" />
  <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#1F57C0" />
  <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFF" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Theme.Border" Color="#33333A" />
  <SolidColorBrush x:Key="Theme.BorderStrong" Color="#55555F" />
  <SolidColorBrush x:Key="Theme.FocusBorder" Color="#4C8DFF" />
  <SolidColorBrush x:Key="Theme.Divider" Color="#232329" />

  <!-- Text -->
  <SolidColorBrush x:Key="Theme.Text" Color="#F2F3F5" />
  <SolidColorBrush x:Key="Theme.TextSecondary" Color="#B8BCC4" />
  <SolidColorBrush x:Key="Theme.TextDisabled" Color="#85898F" />
  <SolidColorBrush x:Key="Theme.Link" Color="#6CB4FF" />
  <SolidColorBrush x:Key="Theme.LinkHover" Color="#A8D3FF" />
  <SolidColorBrush x:Key="Theme.Error" Color="#FF7B72" />
  <SolidColorBrush x:Key="Theme.TextSelection" Color="#3D7BE6" />

  <!-- File list: names coloured by access permissions -->
  <SolidColorBrush x:Key="Theme.Permission.ReadOnly" Color="#9AA0A8" />
  <SolidColorBrush x:Key="Theme.Permission.Executable" Color="#7EE787" />
  <SolidColorBrush x:Key="Theme.Permission.SetId" Color="#FFB454" />
  <SolidColorBrush x:Key="Theme.Permission.WorldWritable" Color="#FF7B72" />

  <!-- Scroll bars -->
  <SolidColorBrush x:Key="Theme.ScrollTrack" Color="Transparent" />
  <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#3D3D45" />
  <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#4E4E58" />
  <SolidColorBrush x:Key="Theme.ScrollThumbPressed" Color="#62626D" />

  <!-- System colours, for the parts of the stock control templates that still refer to them -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#08080A" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F2F3F5" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#131316" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F2F3F5" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#85898F" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2E6AD6" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#202024" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F2F3F5" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#131316" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F2F3F5" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#131316" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#F2F3F5" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#33333A" />
</ResourceDictionary>
