<?xml version="1.0" encoding="utf-8"?>
<!--
  One Dark palette (Atom One Dark): a dark blue-grey background with a soft blue accent. It defines the same keys as Dark/Colors.xaml (see the comment there).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="Theme.WindowBackground" Color="#282C34" />
  <SolidColorBrush x:Key="Theme.SurfaceBackground" Color="#31353F" />
  <SolidColorBrush x:Key="Theme.SurfaceAltBackground" Color="#2C3038" />
  <SolidColorBrush x:Key="Theme.ContentBackground" Color="#282C34" />
  <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#2C313A" />
  <SolidColorBrush x:Key="Theme.InputBackground" Color="#21252B" />
  <SolidColorBrush x:Key="Theme.PopupBackground" Color="#2C313A" />

  <!-- Buttons and other clickable controls -->
  <SolidColorBrush x:Key="Theme.ControlBackground" Color="#3A3F4B" />
  <SolidColorBrush x:Key="Theme.ControlHoverBackground" Color="#454B59" />
  <SolidColorBrush x:Key="Theme.ControlPressedBackground" Color="#515866" />
  <SolidColorBrush x:Key="Theme.ControlDisabledBackground" Color="#2C3038" />

  <!-- List items, menu items, tabs -->
  <SolidColorBrush x:Key="Theme.ItemHoverBackground" Color="#333944" />
  <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#373D49" />
  <SolidColorBrush x:Key="Theme.ItemSelectedBackground" Color="#3E4451" />
  <SolidColorBrush x:Key="Theme.ItemSelectedInactiveBackground" Color="#343A45" />
  <SolidColorBrush x:Key="Theme.ItemSelectedForeground" Color="#FFFFFF" />

  <!-- Accent: default buttons, checked boxes, progress, the active tab marker -->
  <SolidColorBrush x:Key="Theme.Accent" Color="#61AFEF" />
  <SolidColorBrush x:Key="Theme.AccentBackground" Color="#1E5DA6" />
  <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#1A5296" />
  <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#164785" />
  <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFF" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Theme.Border" Color="#3E4451" />
  <SolidColorBrush x:Key="Theme.BorderStrong" Color="#5C6370" />
  <SolidColorBrush x:Key="Theme.FocusBorder" Color="#61AFEF" />
  <SolidColorBrush x:Key="Theme.Divider" Color="#3C4350" />

  <!-- Text -->
  <SolidColorBrush x:Key="Theme.Text" Color="#D7DAE0" />
  <SolidColorBrush x:Key="Theme.TextSecondary" Color="#A6ADBA" />
  <SolidColorBrush x:Key="Theme.TextDisabled" Color="#7F8794" />
  <SolidColorBrush x:Key="Theme.Link" Color="#61AFEF" />
  <SolidColorBrush x:Key="Theme.LinkHover" Color="#9CC9F5" />
  <SolidColorBrush x:Key="Theme.Error" Color="#FF8A93" />
  <SolidColorBrush x:Key="Theme.TextSelection" Color="#3E4451" />

  <!-- File list: names coloured by access permissions -->
  <SolidColorBrush x:Key="Theme.Permission.ReadOnly" Color="#9DA5B4" />
  <SolidColorBrush x:Key="Theme.Permission.Executable" Color="#98C379" />
  <SolidColorBrush x:Key="Theme.Permission.SetId" Color="#D19A66" />
  <SolidColorBrush x:Key="Theme.Permission.WorldWritable" Color="#E06C75" />

  <!-- Scroll bars -->
  <SolidColorBrush x:Key="Theme.ScrollTrack" Color="Transparent" />
  <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#4A5160" />
  <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#5C6474" />
  <SolidColorBrush x:Key="Theme.ScrollThumbPressed" Color="#717A8C" />

  <!-- System colours, for the parts of the stock control templates that still refer to them -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#21252B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#D7DAE0" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#31353F" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#D7DAE0" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7F8794" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3E4451" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#343A45" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#D7DAE0" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2C313A" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#D7DAE0" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#31353F" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#D7DAE0" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#3E4451" />
</ResourceDictionary>
