<?xml version="1.0" encoding="utf-8"?>
<!--
  Nord palette. The arctic blue-grey scheme (nordtheme.com). It defines the same keys as Dark/Colors.xaml (see the comment there).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="Theme.WindowBackground" Color="#2E3440" />
  <SolidColorBrush x:Key="Theme.SurfaceBackground" Color="#3B4252" />
  <SolidColorBrush x:Key="Theme.SurfaceAltBackground" Color="#353B49" />
  <SolidColorBrush x:Key="Theme.ContentBackground" Color="#333A47" />
  <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#3B4252" />
  <SolidColorBrush x:Key="Theme.InputBackground" Color="#272C36" />
  <SolidColorBrush x:Key="Theme.PopupBackground" Color="#3B4252" />

  <!-- Buttons and other clickable controls -->
  <SolidColorBrush x:Key="Theme.ControlBackground" Color="#434C5E" />
  <SolidColorBrush x:Key="Theme.ControlHoverBackground" Color="#4C566A" />
  <SolidColorBrush x:Key="Theme.ControlPressedBackground" Color="#576080" />
  <SolidColorBrush x:Key="Theme.ControlDisabledBackground" Color="#353B49" />

  <!-- List items, menu items, tabs -->
  <SolidColorBrush x:Key="Theme.ItemHoverBackground" Color="#404959" />
  <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#465062" />
  <SolidColorBrush x:Key="Theme.ItemSelectedBackground" Color="#3E6B9E" />
  <SolidColorBrush x:Key="Theme.ItemSelectedInactiveBackground" Color="#404959" />
  <SolidColorBrush x:Key="Theme.ItemSelectedForeground" Color="#ECEFF4" />

  <!-- Accent: default buttons, checked boxes, progress, the active tab marker -->
  <SolidColorBrush x:Key="Theme.Accent" Color="#88C0D0" />
  <SolidColorBrush x:Key="Theme.AccentBackground" Color="#3E6B9E" />
  <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#375F8D" />
  <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#2F547D" />
  <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFF" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Theme.Border" Color="#4C566A" />
  <SolidColorBrush x:Key="Theme.BorderStrong" Color="#6C7A91" />
  <SolidColorBrush x:Key="Theme.FocusBorder" Color="#88C0D0" />
  <SolidColorBrush x:Key="Theme.Divider" Color="#414A5C" />

  <!-- Text -->
  <SolidColorBrush x:Key="Theme.Text" Color="#ECEFF4" />
  <SolidColorBrush x:Key="Theme.TextSecondary" Color="#C7D0DD" />
  <SolidColorBrush x:Key="Theme.TextDisabled" Color="#8C97A8" />
  <SolidColorBrush x:Key="Theme.Link" Color="#88C0D0" />
  <SolidColorBrush x:Key="Theme.LinkHover" Color="#B4DCE6" />
  <SolidColorBrush x:Key="Theme.Error" Color="#FF8A80" />
  <SolidColorBrush x:Key="Theme.TextSelection" Color="#4C7DB5" />

  <!-- File list: names coloured by access permissions -->
  <SolidColorBrush x:Key="Theme.Permission.ReadOnly" Color="#A6B1C2" />
  <SolidColorBrush x:Key="Theme.Permission.Executable" Color="#A3BE8C" />
  <SolidColorBrush x:Key="Theme.Permission.SetId" Color="#EBCB8B" />
  <SolidColorBrush x:Key="Theme.Permission.WorldWritable" Color="#E06C75" />

  <!-- Scroll bars -->
  <SolidColorBrush x:Key="Theme.ScrollTrack" Color="Transparent" />
  <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#5A6478" />
  <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#6C7A91" />
  <SolidColorBrush x:Key="Theme.ScrollThumbPressed" Color="#8090A8" />

  <!-- System colours, for the parts of the stock control templates that still refer to them -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#272C36" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#ECEFF4" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#3B4252" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#ECEFF4" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#8C97A8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3E6B9E" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#ECEFF4" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#404959" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#ECEFF4" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#3B4252" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#ECEFF4" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#3B4252" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#ECEFF4" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#4C566A" />
</ResourceDictionary>
