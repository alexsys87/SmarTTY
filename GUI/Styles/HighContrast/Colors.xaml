<?xml version="1.0" encoding="utf-8"?>
<!--
  High Contrast palette. Black surfaces, maximum-contrast text and a yellow focus ring. It defines the same keys as Dark/Colors.xaml (see the comment there).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="Theme.WindowBackground" Color="#000000" />
  <SolidColorBrush x:Key="Theme.SurfaceBackground" Color="#101010" />
  <SolidColorBrush x:Key="Theme.SurfaceAltBackground" Color="#0A0A0A" />
  <SolidColorBrush x:Key="Theme.ContentBackground" Color="#000000" />
  <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#101010" />
  <SolidColorBrush x:Key="Theme.InputBackground" Color="#000000" />
  <SolidColorBrush x:Key="Theme.PopupBackground" Color="#101010" />

  <!-- Buttons and other clickable controls -->
  <SolidColorBrush x:Key="Theme.ControlBackground" Color="#1A1A1A" />
  <SolidColorBrush x:Key="Theme.ControlHoverBackground" Color="#2A2A2A" />
  <SolidColorBrush x:Key="Theme.ControlPressedBackground" Color="#3A3A3A" />
  <SolidColorBrush x:Key="Theme.ControlDisabledBackground" Color="#141414" />

  <!-- List items, menu items, tabs -->
  <SolidColorBrush x:Key="Theme.ItemHoverBackground" Color="#202020" />
  <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#242424" />
  <SolidColorBrush x:Key="Theme.ItemSelectedBackground" Color="#0057D9" />
  <SolidColorBrush x:Key="Theme.ItemSelectedInactiveBackground" Color="#2A2A2A" />
  <SolidColorBrush x:Key="Theme.ItemSelectedForeground" Color="#FFFFFF" />

  <!-- Accent: default buttons, checked boxes, progress, the active tab marker -->
  <SolidColorBrush x:Key="Theme.Accent" Color="#FFD400" />
  <SolidColorBrush x:Key="Theme.AccentBackground" Color="#0057D9" />
  <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#0049B8" />
  <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#003D99" />
  <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFF" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Theme.Border" Color="#7A7A7A" />
  <SolidColorBrush x:Key="Theme.BorderStrong" Color="#B0B0B0" />
  <SolidColorBrush x:Key="Theme.FocusBorder" Color="#FFD400" />
  <SolidColorBrush x:Key="Theme.Divider" Color="#3A3A3A" />

  <!-- Text -->
  <SolidColorBrush x:Key="Theme.Text" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Theme.TextSecondary" Color="#D6D6D6" />
  <SolidColorBrush x:Key="Theme.TextDisabled" Color="#A6A6A6" />
  <SolidColorBrush x:Key="Theme.Link" Color="#66C2FF" />
  <SolidColorBrush x:Key="Theme.LinkHover" Color="#A5DBFF" />
  <SolidColorBrush x:Key="Theme.Error" Color="#FF8080" />
  <SolidColorBrush x:Key="Theme.TextSelection" Color="#0057D9" />

  <!-- File list: names coloured by access permissions -->
  <SolidColorBrush x:Key="Theme.Permission.ReadOnly" Color="#C8C8C8" />
  <SolidColorBrush x:Key="Theme.Permission.Executable" Color="#5CFF8F" />
  <SolidColorBrush x:Key="Theme.Permission.SetId" Color="#FFD400" />
  <SolidColorBrush x:Key="Theme.Permission.WorldWritable" Color="#FF8080" />

  <!-- Scroll bars -->
  <SolidColorBrush x:Key="Theme.ScrollTrack" Color="Transparent" />
  <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#6A6A6A" />
  <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#8A8A8A" />
  <SolidColorBrush x:Key="Theme.ScrollThumbPressed" Color="#AAAAAA" />

  <!-- System colours, for the parts of the stock control templates that still refer to them -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#000000" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#101010" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#A6A6A6" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0057D9" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2A2A2A" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#101010" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#101010" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#7A7A7A" />
</ResourceDictionary>
