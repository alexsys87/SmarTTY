              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
              </Grid.ColumnDefinitions>
              <Path x:Name="Arrow" Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource Theme.TextSecondary}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
