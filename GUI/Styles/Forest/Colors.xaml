<?xml version="1.0" encoding="utf-8"?>
<!--
  Forest palette. A dark forest palette: deep green surfaces with a bright green accent.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="Theme.WindowBackground" Color="#101A16" />
  <SolidColorBrush x:Key="Theme.SurfaceBackground" Color="#17241E" />
  <SolidColorBrush x:Key="Theme.SurfaceAltBackground" Color="#14201A" />
  <SolidColorBrush x:Key="Theme.ContentBackground" Color="#101A16" />
  <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#17241E" />
  <SolidColorBrush x:Key="Theme.InputBackground" Color="#0B1310" />
  <SolidColorBrush x:Key="Theme.PopupBackground" Color="#17241E" />

  <!-- Buttons and other clickable controls -->
  <SolidColorBrush x:Key="Theme.ControlBackground" Color="#22332B" />
  <SolidColorBrush x:Key="Theme.ControlHoverBackground" Color="#2C4038" />
  <SolidColorBrush x:Key="Theme.ControlPressedBackground" Color="#365045" />
  <SolidColorBrush x:Key="Theme.ControlDisabledBackground" Color="#1A2620" />

  <!-- List items, menu items, tabs -->
  <SolidColorBrush x:Key="Theme.ItemHoverBackground" Color="#1F2E27" />
  <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#24352D" />
  <SolidColorBrush x:Key="Theme.ItemSelectedBackground" Color="#1F5138" />
  <SolidColorBrush x:Key="Theme.ItemSelectedInactiveBackground" Color="#2A3630" />
  <SolidColorBrush x:Key="Theme.ItemSelectedForeground" Color="#FFFFFF" />

  <!-- Accent: default buttons, checked boxes, progress, the active tab marker -->
  <SolidColorBrush x:Key="Theme.Accent" Color="#3FBF7F" />
  <SolidColorBrush x:Key="Theme.AccentBackground" Color="#1F7A4D" />
  <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#1C6E45" />
  <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#175C39" />
  <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFF" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Theme.Border" Color="#3A4A42" />
  <SolidColorBrush x:Key="Theme.BorderStrong" Color="#566B60" />
  <SolidColorBrush x:Key="Theme.FocusBorder" Color="#3FBF7F" />
  <SolidColorBrush x:Key="Theme.Divider" Color="#26332C" />

  <!-- Text -->
  <SolidColorBrush x:Key="Theme.Text" Color="#E4EFE8" />
  <SolidColorBrush x:Key="Theme.TextSecondary" Color="#A9BFB3" />
  <SolidColorBrush x:Key="Theme.TextDisabled" Color="#7E9287" />
  <SolidColorBrush x:Key="Theme.Link" Color="#6FD8A0" />
  <SolidColorBrush x:Key="Theme.LinkHover" Color="#A6EAC6" />
  <SolidColorBrush x:Key="Theme.Error" Color="#FF8A80" />
  <SolidColorBrush x:Key="Theme.TextSelection" Color="#2E8B57" />

  <!-- File list: names coloured by access permissions -->
  <SolidColorBrush x:Key="Theme.Permission.ReadOnly" Color="#94A69B" />
  <SolidColorBrush x:Key="Theme.Permission.Executable" Color="#7EE787" />
  <SolidColorBrush x:Key="Theme.Permission.SetId" Color="#FFB454" />
  <SolidColorBrush x:Key="Theme.Permission.WorldWritable" Color="#FF7B72" />

  <!-- Scroll bars -->
  <SolidColorBrush x:Key="Theme.ScrollTrack" Color="Transparent" />
  <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#4A5A52" />
  <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#5F7268" />
  <SolidColorBrush x:Key="Theme.ScrollThumbPressed" Color="#778C81" />

  <!-- System colours, for the parts of the stock control templates that still refer to them -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0B1310" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E4EFE8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#17241E" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E4EFE8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7E9287" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1F5138" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2A3630" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E4EFE8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#17241E" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E4EFE8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#17241E" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#E4EFE8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#3A4A42" />
</ResourceDictionary>
