<?xml version="1.0" encoding="utf-8"?>
<!--
  Solarized Dark palette (Ethan Schoonover, base03 background). It defines the same keys as Dark/Colors.xaml (see the comment there).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="Theme.WindowBackground" Color="#002B36" />
  <SolidColorBrush x:Key="Theme.SurfaceBackground" Color="#073642" />
  <SolidColorBrush x:Key="Theme.SurfaceAltBackground" Color="#04303C" />
  <SolidColorBrush x:Key="Theme.ContentBackground" Color="#05303B" />
  <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#073642" />
  <SolidColorBrush x:Key="Theme.InputBackground" Color="#00212B" />
  <SolidColorBrush x:Key="Theme.PopupBackground" Color="#073642" />

  <!-- Buttons and other clickable controls -->
  <SolidColorBrush x:Key="Theme.ControlBackground" Color="#0D4250" />
  <SolidColorBrush x:Key="Theme.ControlHoverBackground" Color="#155060" />
  <SolidColorBrush x:Key="Theme.ControlPressedBackground" Color="#1B5E70" />
  <SolidColorBrush x:Key="Theme.ControlDisabledBackground" Color="#06303B" />

  <!-- List items, menu items, tabs -->
  <SolidColorBrush x:Key="Theme.ItemHoverBackground" Color="#0C3D4A" />
  <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#0E4351" />
  <SolidColorBrush x:Key="Theme.ItemSelectedBackground" Color="#1A6FB5" />
  <SolidColorBrush x:Key="Theme.ItemSelectedInactiveBackground" Color="#0C3D4A" />
  <SolidColorBrush x:Key="Theme.ItemSelectedForeground" Color="#FFFFFF" />

  <!-- Accent: default buttons, checked boxes, progress, the active tab marker -->
  <SolidColorBrush x:Key="Theme.Accent" Color="#4FB6E0" />
  <SolidColorBrush x:Key="Theme.AccentBackground" Color="#1A6FB5" />
  <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#1764A3" />
  <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#145892" />
  <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFF" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Theme.Border" Color="#1E5A6B" />
  <SolidColorBrush x:Key="Theme.BorderStrong" Color="#3D7E8F" />
  <SolidColorBrush x:Key="Theme.FocusBorder" Color="#4FB6E0" />
  <SolidColorBrush x:Key="Theme.Divider" Color="#0F4453" />

  <!-- Text -->
  <SolidColorBrush x:Key="Theme.Text" Color="#F2F7F8" />
  <SolidColorBrush x:Key="Theme.TextSecondary" Color="#9CB4B8" />
  <SolidColorBrush x:Key="Theme.TextDisabled" Color="#7C959B" />
  <SolidColorBrush x:Key="Theme.Link" Color="#4FB6E0" />
  <SolidColorBrush x:Key="Theme.LinkHover" Color="#93D6F0" />
  <SolidColorBrush x:Key="Theme.Error" Color="#FF7B72" />
  <SolidColorBrush x:Key="Theme.TextSelection" Color="#2A6FA8" />

  <!-- File list: names coloured by access permissions -->
  <SolidColorBrush x:Key="Theme.Permission.ReadOnly" Color="#9CB4B8" />
  <SolidColorBrush x:Key="Theme.Permission.Executable" Color="#8CC63F" />
  <SolidColorBrush x:Key="Theme.Permission.SetId" Color="#D9A441" />
  <SolidColorBrush x:Key="Theme.Permission.WorldWritable" Color="#E8554B" />

  <!-- Scroll bars -->
  <SolidColorBrush x:Key="Theme.ScrollTrack" Color="Transparent" />
  <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#2A6675" />
  <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#377B8C" />
  <SolidColorBrush x:Key="Theme.ScrollThumbPressed" Color="#4A92A5" />

  <!-- System colours, for the parts of the stock control templates that still refer to them -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#00212B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F2F7F8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#073642" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F2F7F8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7C959B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1A6FB5" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0C3D4A" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F2F7F8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#073642" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F2F7F8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#073642" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#F2F7F8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#1E5A6B" />
</ResourceDictionary>
