<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.SerialPortSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="Serial port settings" Width="391" Height="377" MinWidth="391" MinHeight="377" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <RadioButton Grid.Row="0" Name="DefaultRadio" Content="Use default settings for the selected COM port" Margin="0 0 0 6" />
    <RadioButton Grid.Row="1" Name="ManualRadio" Content="Specify serial port settings manually:" Checked="ManualRadio_CheckedChanged" />
    <Grid Grid.Row="2" Name="SettingsPanel" Margin="19 8 0 0" IsEnabled="False">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Bits per second:" VerticalAlignment="Center" Margin="0 0 6 4" />
      <ComboBox Grid.Row="0" Grid.Column="1" Name="BaudRateBox" IsEditable="True" Margin="0 0 0 4" SelectionChanged="Setting_SelectionChanged" />
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Data bits:" VerticalAlignment="Center" Margin="0 0 6 4" />
      <ComboBox Grid.Row="1" Grid.Column="1" Name="DataBitsBox" Margin="0 0 0 4" SelectionChanged="Setting_SelectionChanged" />
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Parity:" VerticalAlignment="Center" Margin="0 0 6 4" />
      <ComboBox Grid.Row="2" Grid.Column="1" Name="ParityBox" Margin="0 0 0 4" SelectionChanged="Setting_SelectionChanged" />
      <TextBlock Grid.Row="3" Grid.Column="0" Text="Stop bits:" VerticalAlignment="Center" Margin="0 0 6 4" />
      <ComboBox Grid.Row="3" Grid.Column="1" Name="StopBitsBox" Margin="0 0 0 4" SelectionChanged="Setting_SelectionChanged" />
      <TextBlock Grid.Row="4" Grid.Column="0" Text="Flow control:" VerticalAlignment="Center" Margin="0 0 6 4" />
      <ComboBox Grid.Row="4" Grid.Column="1" Name="FlowControlBox" Margin="0 0 0 4" />
      <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0 8 0 0">
        <TextBlock Text="Maximum speed:" VerticalAlignment="Center" />
        <TextBlock Name="SpeedText" Text="unknown" FontWeight="Bold" Margin="6 0 0 0" VerticalAlignment="Center" />
      </StackPanel>
      <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Name="DtrBox" Content="Raise DTR when the port is opened" Margin="0 12 0 0" />
      <CheckBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Name="RtsBox" Content="Raise RTS when the port is opened" Margin="0 4 0 0" />
    </Grid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
      <Button Content="OK" IsDefault="True" MinWidth="80" Margin="0 0 5 0" Click="Ok_Click" />
      <Button Content="Cancel" IsCancel="True" MinWidth="80" />
    </StackPanel>
  </Grid>
</Window>
