<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.DeviceCommandListWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="Commands" Width="460" Height="340" MinWidth="320" MinHeight="240" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Name="DescriptionText" TextWrapping="Wrap" Margin="8 8 8 8" />
    <TextBox Grid.Row="1" Name="CommandsBox" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Courier New" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 8 0 0">
      <Button Content="OK" MinWidth="80" Margin="0 0 5 0" Click="Ok_Click" />
      <Button Content="Cancel" MinWidth="80" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
