<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.PackageDownloadWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="Install package from URL" Width="640" Height="380" MinWidth="440" MinHeight="300" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FocusManager.FocusedElement="{Binding ElementName=UrlBox}">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Name="PromptText" TextWrapping="Wrap" Margin="0 0 0 4" Text="Links to the package files (one per line):" />
    <TextBox Grid.Row="1" Name="UrlBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Courier New" Style="{DynamicResource ThemedTextBox}" ToolTip="http:// or https:// links of package files, one per line; lines that start with # are skipped" />
    <TextBlock Grid.Row="2" Name="HintText" TextWrapping="Wrap" Margin="0 6 0 0" Opacity="0.8" />
    <Grid Grid.Row="3" Name="ProgressPanel" Margin="0 8 0 0" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Name="StatusText" TextTrimming="CharacterEllipsis" Margin="0 0 0 4" />
      <ProgressBar Grid.Row="1" Name="Progress" Minimum="0" Maximum="100" Height="16" />
    </Grid>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
      <Button Name="DownloadButton" Content="_Download and install" Padding="10 2 10 2" MinWidth="90" Margin="0 0 5 0" Click="Download_Click" />
      <Button Name="CancelButton" Content="Cancel" Padding="10 2 10 2" MinWidth="90" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
