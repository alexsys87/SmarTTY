<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.SCPDownloadWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="Download a File with SCP" Width="514" MinWidth="300" MaxWidth="2000" SizeToContent="Height" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Source="pack://application:,,,/icons/dialog-scp-download.png" Width="52" Height="47" VerticalAlignment="Top" Margin="0 0 12 0" />
    <TextBlock Grid.Row="0" Grid.Column="1" Text="Remote file name:" VerticalAlignment="Center" Margin="0 0 8 0" />
    <TextBox Grid.Row="0" Grid.Column="2" Name="RemoteFileBox" MinWidth="200" />
    <Button Grid.Row="0" Grid.Column="3" Name="RemoteBrowseButton" Margin="6 0 0 0" Padding="6 2" ToolTip="Browse the files on the remote host" Click="RemoteBrowse_Click">
      <Image Source="pack://application:,,,/icons/MainWindow/open16.png" Width="16" Height="16" />
    </Button>
    <TextBlock Grid.Row="1" Grid.Column="1" Text="Local directory:" VerticalAlignment="Center" Margin="0 6 8 0" />
    <TextBox Grid.Row="1" Grid.Column="2" Name="LocalDirectoryBox" MinWidth="200" Margin="0 6 0 0" />
    <Button Grid.Row="1" Grid.Column="3" Name="LocalBrowseButton" Margin="6 6 0 0" Padding="6 2" ToolTip="Choose the local folder to download into" Click="LocalBrowse_Click">
      <Image Source="pack://application:,,,/icons/dialog-browse-folder.png" Width="16" Height="16" />
    </Button>
    <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Name="OpenLocalDirBox" Content="Open local directory after downloading" Margin="0 10 0 0" />
    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 14 0 0">
      <Button Content="_Download" IsDefault="True" MinWidth="80" Margin="0 0 5 0" Click="Download_Click" />
      <Button Content="Cancel" IsCancel="True" MinWidth="80" />
    </StackPanel>
  </Grid>
</Window>
