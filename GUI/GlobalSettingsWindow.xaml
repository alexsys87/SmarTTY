<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.GlobalSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:SmarTTY.GUI" xmlns:coll="clr-namespace:System.Collections;assembly=mscorlib" xmlns:sys="clr-namespace:System;assembly=mscorlib" Title="SmarTTY Settings" SizeToContent="Height" Width="800" WindowStartupLocation="CenterOwner" Style="{DynamicResource SecondaryWindowStyle}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TabControl Margin="5 2 5 2">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Thickness x:Key="GridLabelPadding">5</Thickness>
          <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="{StaticResource GridLabelPadding}" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <!-- Each yes/no list overrides these two texts in its own resources; the defaults only keep the template
               resolvable outside such a list (the XAML designer). -->
          <sys:String x:Key="TrueText">Yes</sys:String>
          <sys:String x:Key="FalseText">No</sys:String>
          <coll:ArrayList x:Key="TrueFalse">
            <sys:Boolean>true</sys:Boolean>
            <sys:Boolean>false</sys:Boolean>
          </coll:ArrayList>
          <local:EnumValueFetcher x:Key="EnumValueFetcher" />
          <local:ColorWrapperConverter x:Key="ColorWrapperConverter" />
          <Style x:Key="TrueFalseListBox" TargetType="{x:Type ListBox}" BasedOn="{StaticResource LightHorizontalListBox}">
            <Setter Property="ItemTemplate">
              <Setter.Value>
                <DataTemplate>
                  <Grid>
                    <TextBlock Text="{DynamicResource TrueText}">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Style.Triggers>
                            <DataTrigger Value="false" Binding="{Binding}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                    <TextBlock Text="{DynamicResource FalseText}">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Style.Triggers>
                            <DataTrigger Value="true" Binding="{Binding}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="EnumListBox" TargetType="{x:Type ListBox}" BasedOn="{StaticResource LightHorizontalListBox}">
            <Setter Property="ItemTemplate">
              <Setter.Value>
                <DataTemplate>
                  <TextBlock>
                    <TextBlock.Text>
                      <Binding>
                        <Binding.Converter>
                          <local:EnumValueConverter />
                        </Binding.Converter>
                      </Binding>
                    </TextBlock.Text>
                  </TextBlock>
                </DataTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- Same choices, but wrapped into rows: the theme list is longer than a single line fits. -->
          <Style x:Key="EnumWrapListBox" TargetType="{x:Type ListBox}" BasedOn="{StaticResource EnumListBox}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="ItemsPanel">
              <Setter.Value>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="ColorEditor" TargetType="{x:Type Border}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0 2 0 2" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
            <EventSetter Event="MouseDown" Handler="Border_MouseDown" />
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <TabItem Header="Common Settings">
        <StackPanel>
          <GroupBox Header="File transfer settings" Padding="5">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Default directory for downloads:" />
              <TextBox Grid.Column="1" Text="{Binding DefaultDownloadDirectory}" />
              <Button Grid.Column="2" Margin="5 0 0 0" VerticalAlignment="Center" Click="BrowseDir_Click">
                <Image Width="16" Height="16" Source="../icons/open16.png" />
              </Button>
              <TextBlock Text="Default remote directory for uploads:" Grid.Row="1" />
              <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DefaultUploadDirectory}" />
              <CheckBox Grid.Row="2" Grid.ColumnSpan="3" VerticalContentAlignment="Center" Margin="5 0 0 0" IsChecked="{Binding OpenLocalDirAfterDownload}">
                <TextBlock Text="Open local directory when done downloading" />
              </CheckBox>
              <TextBlock Text="Transfer protocol:" Grid.Row="3" ToolTip="SFTP is used only where the server provides it: on OpenWrt it needs the openssh-sftp-server package, otherwise SCP is used." />
              <ListBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource EnumListBox}" ItemsSource="{Binding Path=TransferProtocol, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding TransferProtocol}" />
              <TextBlock Text="Transfers at the same time (1-8):" Grid.Row="4" />
              <TextBox Grid.Row="4" Grid.Column="1" Width="60" HorizontalAlignment="Left" Text="{Binding MaxParallelTransfers}" />
              <TextBlock Text="Speed limit, KB/s (0 = no limit):" Grid.Row="5" ToolTip="For all transfers of a session together" />
              <TextBox Grid.Row="5" Grid.Column="1" Width="60" HorizontalAlignment="Left" Text="{Binding TransferSpeedLimitKBps}" />
              <CheckBox Grid.Row="6" Grid.ColumnSpan="3" VerticalContentAlignment="Center" Margin="5 0 0 0" IsChecked="{Binding VerifyTransfers}">
                <TextBlock Text="Verify transferred files with a checksum (sha256sum or md5sum on the server)" />
              </CheckBox>
              <CheckBox Grid.Row="7" Grid.ColumnSpan="3" VerticalContentAlignment="Center" Margin="5 0 0 0" IsChecked="{Binding ResumeTransfers}">
                <TextBlock Text="Resume interrupted transfers from where they stopped" />
              </CheckBox>
              <CheckBox Grid.Row="8" Grid.ColumnSpan="3" VerticalContentAlignment="Center" Margin="5 0 0 0" IsChecked="{Binding AtomicUploads}">
                <TextBlock Text="Upload to a temporary file and replace the target only when complete" />
              </CheckBox>
              <CheckBox Grid.Row="9" Grid.ColumnSpan="3" VerticalContentAlignment="Center" Margin="5 0 0 0" IsChecked="{Binding SaveTransferQueue}">
                <TextBlock Text="Keep unfinished transfers and continue them on the next connection to the server" />
              </CheckBox>
            </Grid>
          </GroupBox>
          <GroupBox Header="Keyboard shortcuts" Padding="5">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <CheckBox Content="When Ctrl-Insert is pressed, show a warning about automatic selection copying" Grid.ColumnSpan="2" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding ShowCtrlInsertWarnings}" />
              <CheckBox Content="Close tab on Ctrl+W, new tab on Ctrl+Shift+T" Grid.Row="1" Grid.ColumnSpan="2" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding UseCtrlShortcuts}" />
              <CheckBox Content="Automatically copy selected text to clipboard when selection changes" Grid.Row="2" Grid.ColumnSpan="2" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding CopyOnSelection}" />
              <TextBlock Text="Action for Alt+letter:" Grid.Row="3" />
              <ListBox Grid.Row="3" Grid.Column="1" ItemsSource="{StaticResource TrueFalse}" Style="{StaticResource TrueFalseListBox}" SelectedItem="{Binding SendAltPlusLetterToSession}">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <sys:String x:Key="TrueText">Send to the remote system</sys:String>
                    <sys:String x:Key="FalseText">Select menu items in main window</sys:String>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
              </ListBox>
              <TextBlock Text="When the mouse wheel is scrolled:" Grid.Row="4" />
              <ListBox Grid.Row="4" Grid.Column="1" ItemsSource="{StaticResource TrueFalse}" Style="{StaticResource TrueFalseListBox}" SelectedItem="{Binding EmulateDirectionKeysWithMouseWheel}">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <sys:String x:Key="TrueText">Emulate Up/Down buttons (hold Alt to override)</sys:String>
                    <sys:String x:Key="FalseText">Scroll terminal contents</sys:String>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
              </ListBox>
              <TextBlock Text="Action for Shift+PageUp/Down:" Grid.Row="5" />
              <ListBox Grid.Row="5" Grid.Column="1" ItemsSource="{StaticResource TrueFalse}" Style="{StaticResource TrueFalseListBox}" SelectedItem="{Binding ShiftPageXXToScroll}">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <sys:String x:Key="TrueText">Scroll terminal contents</sys:String>
                    <sys:String x:Key="FalseText">Send keys to remote application</sys:String>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
              </ListBox>
              <TextBlock Text="Action for Ctrl-C/Ctrl-X/Ctrl-V:" Grid.Row="6" />
              <ListBox Grid.Row="6" Grid.Column="1" ItemsSource="{StaticResource TrueFalse}" Style="{StaticResource TrueFalseListBox}" SelectedItem="{Binding InterceptCtrlClipboardShortcuts}">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <sys:String x:Key="TrueText">Copy/Cut/Paste</sys:String>
                    <sys:String x:Key="FalseText">Send keys to remote application</sys:String>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
              </ListBox>
              <TextBlock Text="Shells that count UTF-8 bytes:" Grid.Row="7" ToolTip="SSH terminal tabs: Backspace, Delete and the arrows are repeated once per byte of a non-Latin letter, and the shell&apos;s cursor moves are counted in bytes. Needed for BusyBox ash without UTF-8 support (OpenWrt). Applies to tabs opened afterwards; Smart Terminal and COM/TCP/Telnet have settings of their own." />
              <ListBox Grid.Row="7" Grid.Column="1" Style="{StaticResource EnumListBox}" ItemsSource="{Binding Path=ByteOrientedLineEditing, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding ByteOrientedLineEditing}" />
            </Grid>
          </GroupBox>
        </StackPanel>
      </TabItem>
      <TabItem Header="Paste Settings">
        <StackPanel>
          <GroupBox Header="Paste" Padding="5" DataContext="{Binding Paste}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <CheckBox Content="Remove escape sequences and control characters from pasted text" Grid.ColumnSpan="2" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding RemoveControlCharacters}" ToolTip="Text copied from a web page can hide terminal control sequences or invisible characters that change what is run (paste-jacking)." />
              <CheckBox Content="Replace curly quotes, long dashes and no-break spaces with ASCII characters" Grid.Row="1" Grid.ColumnSpan="2" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding ReplaceTypographicCharacters}" ToolTip="For example the em dash of a copied &quot;—version&quot; becomes &quot;--version&quot;." />
              <CheckBox Content="Remove the line break at the end of the pasted text" Grid.Row="2" Grid.ColumnSpan="2" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding TrimTrailingNewline}" ToolTip="The last pasted line then waits for Enter instead of running at once." />
              <TextBlock Text="Line break of pasted text:" Grid.Row="3" ToolTip="Automatic: Enter (CR) in SSH tabs, the line ending of the connection in COM/TCP/Telnet tabs." />
              <ListBox Grid.Row="3" Grid.Column="1" Style="{StaticResource EnumListBox}" ItemsSource="{Binding Path=LineBreak, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding LineBreak}" />
              <CheckBox Content="Ask before pasting several lines that run at once" Grid.Row="4" Grid.ColumnSpan="2" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding ConfirmMultiline}" ToolTip="Not asked while the program uses bracketed paste (bash, zsh, vim and nano then keep the pasted lines for editing)." />
              <TextBlock Text="Ask from this many lines:" Grid.Row="5" />
              <TextBox Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" MinWidth="80" Text="{Binding ConfirmLineThreshold}" ToolTip="A single line that ends with a line break is asked about as well." />
              <TextBlock Text="Ask from this many characters:" Grid.Row="6" />
              <TextBox Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" MinWidth="80" Text="{Binding ConfirmSizeThreshold}" ToolTip="0 turns the size check off." />
              <CheckBox Content="Warn about dangerous commands (sudo, curl | sh, rm -rf, dd, shutdown, ...)" Grid.Row="7" Grid.ColumnSpan="2" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding WarnDangerous}" ToolTip="Always asks, even when asking about several lines is turned off." />
            </Grid>
          </GroupBox>
          <GroupBox Header="Paste: mouse, keys, history and files" Padding="5" DataContext="{Binding Paste}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Right mouse button:" ToolTip="Shift+right button and the menu key always open the menu. A program that uses the mouse (vim, mc) gets the button itself." />
              <ListBox Grid.Column="1" Style="{StaticResource EnumListBox}" ItemsSource="{Binding Path=RightClick, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding RightClick}" />
              <CheckBox Content="Middle mouse button pastes" Grid.Row="1" Grid.ColumnSpan="2" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding MiddleClickPastes}" ToolTip="Shift+Insert and Ctrl+Shift+V paste as well. Selected text is copied by the &quot;Copy on select&quot; setting of the terminal." />
              <TextBlock Text="Ctrl+Shift+V:" Grid.Row="2" ToolTip="Ctrl+Shift+Insert always opens the menu with the history and the snippets." />
              <ListBox Grid.Row="2" Grid.Column="1" Style="{StaticResource EnumListBox}" ItemsSource="{Binding Path=CtrlShiftV, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding CtrlShiftV}" />
              <CheckBox Content="Remember the pasted texts for the paste menu" Grid.Row="3" Grid.ColumnSpan="2" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding KeepHistory}" ToolTip="The history is kept in memory only, never in a file, and is gone when SmarTTY is closed. Turn it off if you paste passwords." />
              <TextBlock Text="Texts in the history (1 to 50):" Grid.Row="4" />
              <TextBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" MinWidth="80" Text="{Binding HistorySize}" />
              <CheckBox Content="Offer to upload files that are copied in Explorer when pasting" Grid.Row="5" Grid.ColumnSpan="2" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding OfferClipboardFiles}" ToolTip="SSH tabs: upload the files like dropping them on the terminal, or paste their paths." />
              <CheckBox Content="HEX view of COM/TCP tabs: paste text such as DE AD BE EF as bytes" Grid.Row="6" Grid.ColumnSpan="2" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding HexViewPastesBytes}" ToolTip="&quot;Paste as text&quot; and &quot;Paste as HEX bytes&quot; in the terminal menu choose it explicitly." />
              <TextBlock Text="Characters the encoding lacks:" Grid.Row="7" ToolTip="COM, TCP and Telnet tabs with a single-byte encoding (Windows-1251, CP866, KOI8-R ...)." />
              <ListBox Grid.Row="7" Grid.Column="1" Style="{StaticResource EnumListBox}" ItemsSource="{Binding Path=UnmappableCharacters, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding UnmappableCharacters}" />
            </Grid>
          </GroupBox>
        </StackPanel>
      </TabItem>
      <TabItem Header="Visual Settings">
        <StackPanel>
          <GroupBox Header="X Server">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="X Server type:" />
              <ListBox Grid.Column="1" Style="{StaticResource EnumListBox}" ItemsSource="{Binding Path=XServer, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding XServer}" />
              <TextBlock Text="Custom X server:" Grid.Row="1">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="Custom" Binding="{Binding XServer}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomXServerPath}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type TextBox}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="Custom" Binding="{Binding XServer}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBox>
              <TextBlock Text="X server arguments:" Grid.Row="2" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding XServerArguments}" />
              <TextBlock Name="txtVcxsrvStatus" Grid.Row="3" Grid.ColumnSpan="2" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Name="btnInstallVcxsrv" Grid.Row="3" Grid.Column="2" Margin="5 2 0 2" Padding="8 2" VerticalAlignment="Center" Content="Download latest VcXsrv..." ToolTip="Downloads the 64-bit installer of the latest VcXsrv release from github.com/marchaesen/vcxsrv and runs it" Click="InstallVcxsrv_Click" />
              <TextBlock Grid.Row="4" Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0 4 0 0" Text="X11 forwarding is enabled per connection: &quot;Forward X11 (graphical programs)&quot; in the connection settings." />
            </Grid>
          </GroupBox>
          <GroupBox Header="Visual Settings">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Vertical scroll bar visibility:" />
              <ListBox Grid.Column="1" Style="{StaticResource EnumListBox}" ItemsSource="{Binding Path=VerticalScrollbarMode, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding VerticalScrollbarMode}" />
              <TextBlock Text="Horizontal scroll bar visibility:" Grid.Row="1" />
              <ListBox Grid.Column="1" Grid.Row="1" Style="{StaticResource EnumListBox}" ItemsSource="{Binding Path=HorizontalScrollbarMode, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding HorizontalScrollbarMode}" />
              <TextBlock Text="Page header position:" Grid.Row="2" />
              <ListBox Grid.Column="1" Grid.Row="2" Style="{StaticResource EnumListBox}" ItemsSource="{Binding Path=TabHeaderOrientation, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding TabHeaderOrientation}" />
              <TextBlock Text="Session header position:" Grid.Row="3" />
              <ListBox Grid.Column="1" Grid.Row="3" Style="{StaticResource EnumListBox}" ItemsSource="{Binding Path=SessionHeaderOrientation, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding SessionHeaderOrientation}" />
              <TextBlock Text="Application theme:" Grid.Row="4" />
              <ListBox Grid.Column="1" Grid.Row="4" Style="{StaticResource EnumWrapListBox}" ItemsSource="{Binding Path=Theme, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding Theme}" />
            </Grid>
          </GroupBox>
          <GroupBox Header="Other Settings">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Terminal bell sound" Grid.Row="0" />
              <ListBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource EnumListBox}" ItemsSource="{Binding Path=BeepMode, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding BeepMode}" />
              <TextBlock Text="Beep WAV file:" Grid.Row="1">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="WaveFile" Binding="{Binding BeepMode}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BeepFileName}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type TextBox}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="WaveFile" Binding="{Binding BeepMode}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBox>
              <TextBlock Text="Terminal font (monospace)" Grid.Row="2" />
              <TextBox IsReadOnly="True" Grid.Column="1" Grid.Row="2" VerticalContentAlignment="Center" VerticalAlignment="Stretch" Margin="0 2 0 2" Text="{Binding SelectedFont, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:GlobalSettingsWindow}}}" />
              <Button Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="5 0 0 0" ToolTip="Choose a font..." Click="EditFont_Click">
                <Image Width="16" Height="16" Source="../icons/FontHS.png" />
              </Button>
              <TextBlock Text="Default text color:" Grid.Row="3" />
              <Border Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource ColorEditor}" Background="{Binding DefaultTextColor, Converter={StaticResource ColorWrapperConverter}}" />
              <Grid Row="4" ColumnSpan="3" Margin="5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Name="cbCutoff" Content="When a huge text block arrives at once, display only the last" VerticalAlignment="Center" Margin="0 0 5 0" Checked="ApplyCutoffSetting" Unchecked="ApplyCutoffSetting" />
                <TextBox Name="txtCutoffValue" Text="0" Grid.Column="1" MinWidth="100" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="5 0 5 0" IsEnabled="{Binding Path=IsChecked, ElementName=cbCutoff}" TextChanged="ApplyCutoffSetting" />
                <ListBox Name="lbCutoffUnit" Style="{StaticResource LightHorizontalListBox}" Grid.Column="2" SelectedIndex="0" IsEnabled="{Binding Path=IsChecked, ElementName=cbCutoff}" SelectionChanged="ApplyCutoffSetting">
                  <ItemsControl.ItemsSource>
                    <coll:ArrayList>
                      <sys:String>bytes</sys:String>
                      <sys:String>KB</sys:String>
                      <sys:String>MB</sys:String>
                    </coll:ArrayList>
                  </ItemsControl.ItemsSource>
                </ListBox>
              </Grid>
              <CheckBox Grid.Row="5" Grid.ColumnSpan="3" Content="Display unrecognized characters as \{code}" Margin="5" IsChecked="{Binding ShowUnrecognizedCharactersAsHex}" />
              <Button Grid.Row="6" Grid.ColumnSpan="3" Style="{StaticResource HyperlinkButton}" HorizontalAlignment="Left" Margin="5" Click="EditPalette_Click">
                <StackPanel Orientation="Horizontal">
                  <Image Width="16" Height="16" Source="../icons/color16.png" Margin="0 0 5 0" />
                  <TextBlock Text="Customize console colors..." />
                </StackPanel>
              </Button>
            </Grid>
          </GroupBox>
        </StackPanel>
      </TabItem>
      <TabItem Header="Editor Settings">
        <GroupBox Header="Remote file editor settings">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Background color:" Grid.Row="0" />
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ColorEditor}" Background="{Binding Path=EditorWrapper.Colors.BackColor, Converter={StaticResource ColorWrapperConverter}}" />
            <TextBlock Text="Text color:" Grid.Row="0" Grid.Column="2" />
            <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource ColorEditor}" Background="{Binding Path=EditorWrapper.Colors.TextColor, Converter={StaticResource ColorWrapperConverter}}" />
            <TextBlock Text="Line number background:" Grid.Row="1" />
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ColorEditor}" Background="{Binding Path=EditorWrapper.Colors.LineNumberBackground, Converter={StaticResource ColorWrapperConverter}}" />
            <TextBlock Text="Line number text:" Grid.Row="1" Grid.Column="2" />
            <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource ColorEditor}" Background="{Binding Path=EditorWrapper.Colors.LineNumberForeground, Converter={StaticResource ColorWrapperConverter}}" />
            <TextBlock Text="Keywords, tags:" Grid.Row="2" />
            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ColorEditor}" Background="{Binding Path=EditorWrapper.Colors.KeywordColor, Converter={StaticResource ColorWrapperConverter}}" />
            <TextBlock Text="Strings, removed lines:" Grid.Row="2" Grid.Column="2" />
            <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource ColorEditor}" Background="{Binding Path=EditorWrapper.Colors.StringColor, Converter={StaticResource ColorWrapperConverter}}" />
            <TextBlock Text="Comments, added lines:" Grid.Row="3" />
            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource ColorEditor}" Background="{Binding Path=EditorWrapper.Colors.CommentColor, Converter={StaticResource ColorWrapperConverter}}" />
            <TextBlock Text="Numbers:" Grid.Row="3" Grid.Column="2" />
            <Border Grid.Row="3" Grid.Column="3" Style="{StaticResource ColorEditor}" Background="{Binding Path=EditorWrapper.Colors.NumberColor, Converter={StaticResource ColorWrapperConverter}}" />
            <TextBlock Text="Variables, keys:" Grid.Row="4" />
            <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource ColorEditor}" Background="{Binding Path=EditorWrapper.Colors.VariableColor, Converter={StaticResource ColorWrapperConverter}}" />
            <TextBlock Text="Sections, diff hunks:" Grid.Row="4" Grid.Column="2" />
            <Border Grid.Row="4" Grid.Column="3" Style="{StaticResource ColorEditor}" Background="{Binding Path=EditorWrapper.Colors.SectionColor, Converter={StaticResource ColorWrapperConverter}}" />
            <TextBlock Text="Preprocessor, shebang:" Grid.Row="5" />
            <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource ColorEditor}" Background="{Binding Path=EditorWrapper.Colors.PreprocessorColor, Converter={StaticResource ColorWrapperConverter}}" />
            <Button Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="{StaticResource GridLabelPadding}" Padding="8 2" Content="Reset colors to defaults" ToolTip="Restore the default editor colors of the current theme" Click="ResetEditorColors_Click" />
            <TextBlock Text="Tab size:" Grid.Row="6" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding EditorWrapper.TabSize}" />
            <CheckBox Content="Insert spaces instead of tabs" Grid.Row="7" Grid.ColumnSpan="4" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding EditorWrapper.InsertSpaces}" ToolTip="Tab and indentation insert 'Tab size' spaces; Backspace in leading spaces removes one level" />
            <TextBlock Text="Temporary directory for uploaded files:" Grid.Row="8" />
            <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EditorWrapper.TemporaryDirectory}" />
            <CheckBox Content="Enable syntax highlighting" Grid.Row="9" Grid.ColumnSpan="4" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding EditorWrapper.SyntaxHighlighting}" />
            <CheckBox Content="Keep a backup copy (file~) when saving" Grid.Row="10" Grid.ColumnSpan="4" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding EditorWrapper.BackupBeforeSave}" ToolTip="The first save of a file after it was opened copies the old file to the same name with a ~ added, on the server." />
            <CheckBox Content="Show a line under each tab character" Grid.Row="11" Grid.ColumnSpan="4" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding EditorWrapper.ShowTabs}" ToolTip="Underlines tabs so lines indented with tabs are easy to tell from lines indented with spaces" />
            <CheckBox Content="Show all characters, including spaces, tabs and line ends" Grid.Row="12" Grid.ColumnSpan="4" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding EditorWrapper.ShowAllCharacters}" ToolTip="Marks spaces, tabs, line breaks and control characters so invisible differences are easy to see. The same switch is on the editor tool bar." />
            <CheckBox Content="Offer completions while editing (Ctrl+Space opens the list)" Grid.Row="13" Grid.ColumnSpan="4" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding EditorWrapper.Autocompletion}" ToolTip="Suggests the keywords of the language and the words already used in the file." />
            <CheckBox Content="Open the completion list automatically while typing" Grid.Row="14" Grid.ColumnSpan="4" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding EditorWrapper.AutocompletionOnTyping}" ToolTip="Opens the list after two letters of a word were typed." />
            <CheckBox Content="Offer the standard functions of the language (API symbols)" Grid.Row="15" Grid.ColumnSpan="4" Margin="{StaticResource GridLabelPadding}" IsChecked="{Binding EditorWrapper.ApiSymbols}" ToolTip="Adds the standard functions of the language (Python builtins, the C library, the shell builtins, ...) with their description and parameter hint. The set lives in ApiSymbols.xml." />
          </Grid>
        </GroupBox>
      </TabItem>
      <TabItem Header="Smart Terminal Settings">
        <StackPanel>
          <GroupBox Header="Common Settings" DataContext="{Binding VirtualTerminal}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock TextWrapping="Wrap" Text="Smart Terminal provides advanced features like Command Completion, File Panel and Windows-style command line editing by emulating the remote shell during the command line editing phase." Grid.ColumnSpan="2" />
              <TextBlock Text="Default Terminal Type:" Grid.Row="1" />
              <ListBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource LightHorizontalListBox}" ItemsSource="{Binding Path=DefaultMode, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding DefaultMode}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Image Width="16" Height="16" Margin="0 0 2 0">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type Image}">
                            <Style.Triggers>
                              <DataTrigger Value="Enabled" Binding="{Binding}">
                                <Setter Property="Source" Value="../icons/event16.png" />
                              </DataTrigger>
                              <DataTrigger Value="Disabled" Binding="{Binding}">
                                <Setter Property="Source" Value="../icons/term16.png" />
                              </DataTrigger>
                              <DataTrigger Value="Ask" Binding="{Binding}">
                                <Setter Property="Source" Value="../icons/question16.png" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </Image>
                      <TextBlock VerticalAlignment="Center">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                              <DataTrigger Value="Enabled" Binding="{Binding}">
                                <Setter Property="Text" Value="Smart Terminal" />
                              </DataTrigger>
                              <DataTrigger Value="Disabled" Binding="{Binding}">
                                <Setter Property="Text" Value="Normal Terminal" />
                              </DataTrigger>
                              <DataTrigger Value="Ask" Binding="{Binding}">
                                <Setter Property="Text" Value="Ask on first use" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ListBox>
              <TextBlock Text="Shell for launched commands:" Grid.Row="2" ToolTip="The shell that runs the commands of Smart Terminal tabs in the interactive wrapper (with its aliases and functions) and whose history file is used. Detect: per connection, the login shell if it is bash or ash, otherwise bash, ash or sh, whichever is installed; on OpenWrt that is BusyBox ash with the aliases of /etc/shinit and ~/.ash_history. Manual: the shell typed here." />
              <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListBox Style="{StaticResource EnumListBox}" ItemsSource="{Binding Path=ShellMode, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding ShellMode}" />
                <TextBox Grid.Column="1" Text="{Binding DefaultShell}" ToolTip="The shell of the manual mode, e.g. bash, ash, zsh or /bin/bash; BusyBox ash is started without -i, so that it does not print its banner before every command">
                  <FrameworkElement.Style>
                    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type TextBox}">
                      <Setter Property="IsEnabled" Value="False" />
                      <Style.Triggers>
                        <DataTrigger Value="Manual" Binding="{Binding ShellMode}">
                          <Setter Property="IsEnabled" Value="True" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </TextBox>
              </Grid>
              <TextBlock Text="When opening new Smart Terminals:" Grid.Row="3" />
              <ListBox Grid.Row="3" Grid.Column="1" ItemsSource="{StaticResource TrueFalse}" Style="{StaticResource TrueFalseListBox}" SelectedItem="{Binding ShowFileExplorer}">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <sys:String x:Key="TrueText">Show File Viewer panel</sys:String>
                    <sys:String x:Key="FalseText">Collapse File Viewer panel</sys:String>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
              </ListBox>
              <TextBlock Text="File extensions for automatic link highlighting:" Grid.Row="4" />
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AutoLinkExtensions}" />
              <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Margin="5" Content="Wrap launched commands in an interactive shell" IsChecked="{Binding InteractiveModeWrapper}" />
              <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Margin="5" Content="Show the exit code of a command that fails" IsChecked="{Binding ShowExitCodes}" />
              <TextBlock Text="Programs in shells that count UTF-8 bytes:" Grid.Row="7" ToolTip="For commands run from a Smart Terminal tab when the shell edits its input in UTF-8 bytes (BusyBox without UTF-8 support, OpenWrt): Backspace, Delete and the arrows are sent once per byte of a non-Latin letter. The command line itself is always edited by SmarTTY. Applies to tabs opened afterwards." />
              <ListBox Grid.Row="7" Grid.Column="1" Style="{StaticResource EnumListBox}" ItemsSource="{Binding Path=ByteOrientedLineEditing, Converter={StaticResource EnumValueFetcher}}" SelectedItem="{Binding ByteOrientedLineEditing}" />
            </Grid>
          </GroupBox>
          <GroupBox Header="Command Completion" DataContext="{Binding VirtualTerminal}">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
                  <Setter Property="Margin" Value="5 2 2 0" />
                </Style>
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <StackPanel DataContext="{Binding CompletionTriggers}">
              <TextBlock Text="Show command completion popup:" />
              <CheckBox Content="When ctrl-space is pressed" IsChecked="{Binding CtrlSpace}" />
              <CheckBox Content="Each time '/' is typed" IsChecked="{Binding Slash}" />
              <CheckBox Content="Each time a space is typed" IsChecked="{Binding Space}" />
              <CheckBox Content="When a first character in a word is typed" IsChecked="{Binding FirstCharacterInWord}" />
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </TabItem>
    </TabControl>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="1" Margin="0 5 0 5">
      <Button Content="Import settings..." Margin="5 2 5 2" Padding="10 3 10 3" ToolTip="Import settings and saved connections from a .tar.gz archive" Click="ImportSettings_Click" />
      <Button Content="Export settings..." Margin="5 2 5 2" Padding="10 3 10 3" ToolTip="Export settings and saved connections to a .tar.gz archive" Click="ExportSettings_Click" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1" Margin="0 5 0 5">
      <Button Content="_OK" Margin="5 2 5 2" Width="80" Padding="5 3 5 3" IsDefault="True" Click="OK_Click" />
      <Button Content="_Cancel" Margin="5 2 5 2" Width="80" Padding="5 3 5 3" IsCancel="True" Click="Cancel_Click" />
    </StackPanel>
  </Grid>
</Window>