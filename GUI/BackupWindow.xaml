<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.BackupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:t="clr-namespace:SmarTTY.Transport" Title="Backup to tar.gz" SnapsToDevicePixels="True" WindowStartupLocation="CenterOwner" Width="760" Height="680" MinWidth="560" MinHeight="480" Style="{DynamicResource SecondaryWindowStyle}" FocusManager.FocusedElement="{Binding ElementName=FolderTree}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- What the backup does and where the archive goes. -->
    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0 0 0 8">
      Packs the checked files and folders of the server into a tar.gz archive on this computer. tar runs on the server and writes the
      archive to the SSH connection, so nothing is written on the server, not even to /tmp. Only /bin/sh and tar are needed (BusyBox
      of OpenWrt is enough); when tar cannot compress, the archive is compressed on this computer.
    </TextBlock>

    <!-- Quick selections and the size estimate. -->
    <DockPanel Grid.Row="1" Margin="0 0 0 6" LastChildFill="True">
      <Button Name="WholeSystemButton" DockPanel.Dock="Left" Padding="8 2 8 2" Margin="0 0 6 0" Click="WholeSystem_Click" ToolTip="Check the whole root file system: everything but the virtual file systems of the kernel (/proc, /sys), the memory file systems (/tmp, /run, /dev) and the mounted media (/mnt, /media)">
        <StackPanel Orientation="Horizontal">
          <Image Width="16" Height="16" Source="../icons/MainWindow/archive16.png" />
          <TextBlock Margin="4 0 0 0" Text="Whole system" />
        </StackPanel>
      </Button>
      <Button Name="ConfigOnlyButton" DockPanel.Dock="Left" Padding="8 2 8 2" Margin="0 0 6 0" Click="ConfigOnly_Click" ToolTip="Check /etc only: the configuration of the system (on OpenWrt: /etc/config and the rest of the settings)">
        <StackPanel Orientation="Horizontal">
          <Image Width="16" Height="16" Source="../icons/gear16.png" />
          <TextBlock Margin="4 0 0 0" Text="Configuration (/etc)" />
        </StackPanel>
      </Button>
      <Button Name="ClearButton" DockPanel.Dock="Left" Padding="8 2 8 2" Margin="0 0 6 0" Click="Clear_Click" ToolTip="Uncheck everything">
        <StackPanel Orientation="Horizontal">
          <Image Width="16" Height="16" Source="../icons/delete16.png" />
          <TextBlock Margin="4 0 0 0" Text="Clear" />
        </StackPanel>
      </Button>
      <Button Name="EstimateButton" DockPanel.Dock="Left" Padding="8 2 8 2" Margin="0 0 6 0" Click="Estimate_Click" ToolTip="Ask the server how much data is checked (du -sk); with compression on this computer the progress bar then shows the percentage">
        <StackPanel Orientation="Horizontal">
          <Image Width="16" Height="16" Source="../icons/MainWindow/refresh16.png" />
          <TextBlock Margin="4 0 0 0" Text="Estimate size" />
        </StackPanel>
      </Button>
      <TextBlock Name="EstimateText" VerticalAlignment="Center" Margin="6 0 0 0" Foreground="{DynamicResource Theme.TextSecondary}" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <!-- The files and folders of the server; a folder is read when it is first expanded. -->
    <Grid Grid.Row="2">
      <TreeView Name="FolderTree" MinHeight="160">
        <TreeView.ItemContainerStyle>
          <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.Resources>
          <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
          <HierarchicalDataTemplate DataType="{x:Type t:BackupNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0 1 0 1">
              <CheckBox VerticalAlignment="Center" Focusable="False" IsThreeState="False" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}" Visibility="{Binding IsCheckable, Converter={StaticResource BoolToVisibility}}" Margin="0 0 4 0" />
              <Image Width="16" Height="16" Margin="0 0 4 0" VerticalAlignment="Center">
                <Image.Style>
                  <Style TargetType="{x:Type Image}">
                    <Setter Property="Source" Value="../icons/MainWindow/document_flat.png" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                        <Setter Property="Source" Value="../icons/MainWindow/folder_flat.png" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="{x:Static t:RemoteEntryKind.SymbolicLink}">
                        <Setter Property="Source" Value="../icons/export16.png" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                        <Setter Property="Source" Value="../icons/MainWindow/busy.png" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Image.Style>
              </Image>
              <TextBlock VerticalAlignment="Center" Text="{Binding Name}">
                <TextBlock.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsLocked}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Theme.TextDisabled}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
                        <Setter Property="FontStyle" Value="Italic" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock VerticalAlignment="Center" Margin="8 0 0 0" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}" Text="{Binding Note, StringFormat=({0})}" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </HierarchicalDataTemplate>
        </TreeView.Resources>
      </TreeView>
      <!-- Shown over the tree while the server is asked for the first time. -->
      <StackPanel Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="260">
        <ProgressBar Height="14" IsIndeterminate="True" />
        <TextBlock Name="LoadingText" Margin="0 6 0 0" HorizontalAlignment="Center" TextWrapping="Wrap" Text="Reading the folders of the server..." />
      </StackPanel>
    </Grid>

    <!-- Where the archive goes and how it is made. -->
    <Grid Grid.Row="3" Margin="0 10 0 0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Save to:" VerticalAlignment="Center" Margin="0 0 8 0" />
      <TextBox Name="FileBox" Grid.Row="0" Grid.Column="1" Margin="0 2 4 2" VerticalContentAlignment="Center" Style="{DynamicResource ThemedTextBox}" ToolTip="The archive on this computer; it is written as name.part first and gets its name once it is complete" />
      <Button Name="BrowseButton" Grid.Row="0" Grid.Column="2" Content="Browse..." MinWidth="80" Margin="0 2 0 2" Click="Browse_Click" />
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Compression:" VerticalAlignment="Center" Margin="0 0 8 0" />
      <ComboBox Name="CompressionBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0 2 0 2" SelectedIndex="0" ToolTip="Either way the result is the same tar.gz file">
        <ComboBoxItem Content="On the server (tar -z): less data over the network" ToolTip="gzip runs on the server; a slow device (a router) may then be the bottleneck. A tar without gzip support falls back to compression on this computer." />
        <ComboBoxItem Content="On this computer: less load on the device, the progress can be shown in percent" ToolTip="The server sends the plain tar stream, which this computer compresses while saving it" />
      </ComboBox>
      <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Vertical" Margin="0 4 0 0">
        <CheckBox Name="SudoBox" Visibility="Collapsed" Content="Run tar as root with sudo (sudo -n, no password is asked)" ToolTip="The user of this connection is not root: without sudo, the files it cannot read (/etc/shadow, the data of services) are left out of the archive" />
        <CheckBox Name="VerifyBox" IsChecked="True" Margin="0 4 0 0" Content="Check the archive when it is saved (reads it back and counts the files)" ToolTip="Unpacks the archive in memory on this computer, without writing the files, to make sure that it is complete and not damaged" />
        <TextBlock Name="UserText" Margin="0 4 0 0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextSecondary}" />
      </StackPanel>
    </Grid>

    <!-- Progress of the running backup. -->
    <StackPanel Grid.Row="4" Margin="0 10 0 0">
      <ProgressBar Name="Progress" Height="16" Maximum="100" />
      <DockPanel Margin="0 4 0 0">
        <TextBlock Name="RateText" DockPanel.Dock="Right" Margin="8 0 0 0" />
        <TextBlock Name="StatusText" TextTrimming="CharacterEllipsis" Text="Check what to archive and press Start." />
      </DockPanel>
      <TextBlock Name="CurrentFileText" Margin="0 2 0 0" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <!-- What tar said: the files it could not read and the final result. -->
    <TextBox Name="LogBox" Grid.Row="5" Height="96" Margin="0 8 0 0" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Style="{DynamicResource ThemedTextBox}" />

    <TextBlock Grid.Row="6" Margin="0 6 0 0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}">
      To restore, upload the archive to the server and run: tar -xzf backup.tar.gz -C /
    </TextBlock>

    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
      <Button Name="OpenFolderButton" Content="Open folder" MinWidth="90" Margin="0 0 6 0" IsEnabled="False" Click="OpenFolder_Click" ToolTip="Show the saved archive in Explorer" />
      <Button Name="StartButton" Content="_Start backup" MinWidth="100" Margin="0 0 6 0" IsDefault="True" IsEnabled="False" Click="Start_Click" />
      <Button Name="StopButton" Content="S_top" MinWidth="80" Margin="0 0 6 0" IsEnabled="False" Click="Stop_Click" ToolTip="Stop tar on the server and delete the unfinished archive" />
      <Button Name="CloseButton" Content="Close" MinWidth="80" IsCancel="True" Click="Close_Click" />
    </StackPanel>
  </Grid>
</Window>
