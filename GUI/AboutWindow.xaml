<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="About SmarTTY" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Image Grid.Column="0" Source="../icons/about.png" Width="128" Height="128" VerticalAlignment="Top" Margin="0 0 16 0" />
    <StackPanel Grid.Column="1" MinWidth="330">
      <TextBlock Text="SmarTTY" FontSize="20" />
      <TextBlock Name="VersionText" Text="Version 3.3 [05 May 2022]" FontSize="12" Margin="0 2 0 0" />
      <TextBlock Text="A multi-tabbed SSH client with SCP support." FontSize="12" TextWrapping="Wrap" Margin="0 10 0 0" />
      <TextBlock Text="Copyright © 2015-2022 Sysprogs OÜ" Margin="0 10 0 0" />
      <TextBlock Text="All rights reserved" />
      <Button Style="{StaticResource HyperlinkButton}" HorizontalAlignment="Left" Content="http://sysprogs.com/" Padding="0" Margin="0 4 0 0" Click="Homepage_Click" />
      <TextBlock Text="Uses the SSH.NET library for SSH and SCP (MIT license)." FontSize="11" TextWrapping="Wrap" Margin="0 10 0 0" />
      <Button Style="{StaticResource HyperlinkButton}" HorizontalAlignment="Left" Content="https://github.com/sshnet/SSH.NET" Padding="0" Margin="0 2 0 0" Click="SshNet_Click" />
      <TextBlock Text="Uses the Oxygen icon set (LGPL license)." FontSize="11" TextWrapping="Wrap" Margin="0 10 0 0" />
      <Button Style="{StaticResource HyperlinkButton}" HorizontalAlignment="Left" Content="https://invent.kde.org/frameworks/oxygen-icons" Padding="0" Margin="0 2 0 0" Click="Oxygen_Click" />
      <Button Content="Close" IsDefault="True" IsCancel="True" MinWidth="80" HorizontalAlignment="Right" Margin="0 16 0 0" />
    </StackPanel>
  </Grid>
</Window>
