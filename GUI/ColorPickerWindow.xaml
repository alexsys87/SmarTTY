<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.ColorPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="Choose color" Width="500" Height="260" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="Basic colors:" Margin="0 0 0 4" />
    <TextBlock Grid.Row="0" Grid.Column="2" Text="Custom color:" Margin="0 0 0 4" />

    <Border Grid.Row="1" Grid.Column="0" BorderThickness="1" BorderBrush="{DynamicResource Theme.Border}" Background="{DynamicResource Theme.SurfaceBackground}" Padding="2">
      <ItemsControl x:Name="BasicColorList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Height="20" Width="20" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource Theme.BorderStrong}" Background="{Binding Brush}" Cursor="Hand" ToolTip="{Binding Hex}" MouseLeftButtonDown="Swatch_MouseLeftButtonDown" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Grid Grid.Row="1" Grid.Column="2" MinWidth="240" VerticalAlignment="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border x:Name="PreviewSwatch" Grid.Row="0" Grid.RowSpan="4" Width="56" Height="56" VerticalAlignment="Top" BorderThickness="1" BorderBrush="{DynamicResource Theme.BorderStrong}" Margin="0 0 12 0" />

      <Grid Grid.Row="0" Grid.Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="46" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="R" VerticalAlignment="Center" />
        <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0 0 6 0" ValueChanged="Channel_ValueChanged" />
        <TextBox x:Name="RedBox" Grid.Column="2" KeyDown="ChannelBox_KeyDown" LostKeyboardFocus="ChannelBox_LostKeyboardFocus" />
      </Grid>
      <Grid Grid.Row="1" Grid.Column="1" Margin="0 4 0 0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="46" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="G" VerticalAlignment="Center" />
        <Slider x:Name="GreenSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0 0 6 0" ValueChanged="Channel_ValueChanged" />
        <TextBox x:Name="GreenBox" Grid.Column="2" KeyDown="ChannelBox_KeyDown" LostKeyboardFocus="ChannelBox_LostKeyboardFocus" />
      </Grid>
      <Grid Grid.Row="2" Grid.Column="1" Margin="0 4 0 0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="46" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="B" VerticalAlignment="Center" />
        <Slider x:Name="BlueSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0 0 6 0" ValueChanged="Channel_ValueChanged" />
        <TextBox x:Name="BlueBox" Grid.Column="2" KeyDown="ChannelBox_KeyDown" LostKeyboardFocus="ChannelBox_LostKeyboardFocus" />
      </Grid>
      <Grid Grid.Row="3" Grid.Column="1" Margin="0 8 0 0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Hex" VerticalAlignment="Center" />
        <TextBox x:Name="HexBox" Grid.Column="1" KeyDown="HexBox_KeyDown" LostKeyboardFocus="HexBox_LostKeyboardFocus" ToolTip="The colour as #RRGGBB." />
      </Grid>
    </Grid>

    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 14 0 0">
      <Button Content="OK" IsDefault="True" MinWidth="80" Margin="0 0 5 0" Click="Ok_Click" />
      <Button Content="Cancel" IsCancel="True" MinWidth="80" />
    </StackPanel>
  </Grid>
</Window>
