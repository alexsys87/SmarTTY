<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.PackageManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:SmarTTY.GUI" xmlns:coll="clr-namespace:System.Collections;assembly=mscorlib" Title="Manage Linux Packages" SnapsToDevicePixels="True" WindowStartupLocation="CenterOwner" Width="600" Height="400" Style="{DynamicResource SecondaryWindowStyle}" FocusManager.FocusedElement="{Binding ElementName=txtFilter}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ToolBar>
      <TextBlock Text="Show:" VerticalAlignment="Center" Margin="5" />
      <ListBox Style="{DynamicResource HorizontalListBox}" SelectedItem="{Binding TypeFilter}">
        <ItemsControl.ItemsSource>
          <coll:ArrayList>
            <local:PackageTypeFilter>All</local:PackageTypeFilter>
            <local:PackageTypeFilter>Installed</local:PackageTypeFilter>
            <local:PackageTypeFilter>Updates</local:PackageTypeFilter>
          </coll:ArrayList>
        </ItemsControl.ItemsSource>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Style="{StaticResource EnumMemberPresenter}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>
      <Separator />
      <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="5" />
      <TextBox Name="txtFilter" MinWidth="200" VerticalAlignment="Center" Style="{DynamicResource ThemedTextBox}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
    </ToolBar>
    <ListView Name="ItemList" Grid.Row="1" VirtualizingStackPanel.IsVirtualizing="True" ItemsSource="{Binding FilteredPackages}" PreviewKeyDown="ListView_PreviewKeyDown">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ListView.View>
        <GridView>
          <GridView.Columns>
            <GridViewColumn Header="" Width="30">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsChecked}" IsThreeState="{Binding IsThreeState}" Checked="CheckBox_CheckChanged" Unchecked="CheckBox_CheckChanged" Indeterminate="CheckBox_CheckChanged" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Name" Width="220">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Grid.Column="1" Height="16" Text="{Binding Name}" />
                    <Image Width="16" Height="16" Grid.Column="0" Margin="0 0 0 0">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Image}">
                          <Style.Triggers>
                            <DataTrigger Value="Install" Binding="{Binding Action}">
                              <Setter Property="Source" Value="../icons/MainWindow/download.png" />
                            </DataTrigger>
                            <DataTrigger Value="Remove" Binding="{Binding Action}">
                              <Setter Property="Source" Value="../icons/delete16.png" />
                            </DataTrigger>
                            <DataTrigger Value="None" Binding="{Binding Action}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </Image>
                  </Grid>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Version" Width="200" DisplayMemberBinding="{Binding Version}" />
            <GridViewColumn Header="State" Width="100" DisplayMemberBinding="{Binding DescriptiveState}" />
          </GridView.Columns>
        </GridView>
      </ListView.View>
    </ListView>
    <Grid Row="1" ZIndex="1" VerticalAlignment="Center" Margin="25">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Grid}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ProgressText}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <TextBlock Margin="0 0 5 0" Text="{Binding ProgressText}" />
      <ProgressBar IsIndeterminate="True" Grid.Column="1" />
    </Grid>
    <CheckBox Grid.Row="2" Margin="10 5 5 5" IsChecked="{Binding Options.NoPrompt}">
      <TextBlock Text="Install/remove packages without asking for further confirmation" />
    </CheckBox>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Refresh" Padding="10 2 10 2" Margin="10 10 5 10" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}" ToolTip="Update the package lists from the repositories (apt-get update, opkg update, apk update, ...) and reload the list" Click="Refresh_Click" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
      <Button IsDefault="True" Padding="10 2 10 2" Margin="5" IsEnabled="{Binding IsIdle}" Click="OK_Click">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding InstallText}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <StackPanel Orientation="Vertical">
          <TextBlock Text="{Binding InstallText}" />
        </StackPanel>
      </Button>
      <Button Content="Cancel" IsCancel="True" Padding="10 2 10 2" Margin="5" Click="Cancel_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>