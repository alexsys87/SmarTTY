<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.PasteProgressWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="Pasting" Width="380" Height="124" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual" Topmost="True">
  <Border BorderBrush="{DynamicResource Theme.BorderStrong}" BorderThickness="1" Background="{DynamicResource Theme.WindowBackground}">
    <Grid Margin="10 8 10 8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Name="TitleText" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0 0 0 4" />
      <TextBlock Grid.Row="1" Name="StatusText" TextTrimming="CharacterEllipsis" Margin="0 0 0 6" />
      <ProgressBar Grid.Row="2" Name="Progress" Minimum="0" Maximum="100" Height="18" HorizontalAlignment="Stretch" />
      <Button Grid.Row="3" Name="CancelButton" Content="Cancel (Esc)" HorizontalAlignment="Right" MinWidth="100" Margin="0 8 0 0" Click="Cancel_Click" />
    </Grid>
  </Border>
</Window>
