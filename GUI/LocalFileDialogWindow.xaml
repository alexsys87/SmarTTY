<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.LocalFileDialogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="Select a File" Width="640" Height="440" MinWidth="460" MinHeight="320" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0">
      <TextBlock DockPanel.Dock="Left" Text="Look in:" VerticalAlignment="Center" Margin="0 0 6 0" />
      <Button DockPanel.Dock="Right" Name="UpButton" Margin="4 0 0 0" Padding="4 2" ToolTip="Go to the parent folder" Click="Up_Click">
        <Image Source="pack://application:,,,/icons/MainWindow/updir.png" Width="16" Height="16" />
      </Button>
      <Button DockPanel.Dock="Right" Name="RefreshButton" Margin="4 0 0 0" Padding="4 2" ToolTip="Refresh the list" Click="Refresh_Click">
        <Image Source="pack://application:,,,/icons/MainWindow/refresh16.png" Width="16" Height="16" />
      </Button>
      <ComboBox Name="DirectoryCombo" IsEditable="True" MinWidth="120" SelectionChanged="DirectoryCombo_SelectionChanged" KeyDown="DirectoryCombo_KeyDown" />
    </DockPanel>
    <ListView Grid.Row="1" Name="FileList" MinHeight="120" Margin="0 6 0 0" SelectionMode="Single" SelectionChanged="FileList_SelectionChanged" MouseDoubleClick="FileList_MouseDoubleClick" KeyDown="FileList_KeyDown">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Name" Width="320">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Image Width="16" Height="16" Margin="0 0 6 0">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Image}">
                        <Setter Property="Source" Value="pack://application:,,,/icons/MainWindow/document_flat.png" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                            <Setter Property="Source" Value="pack://application:,,,/icons/MainWindow/folder_flat.png" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Image>
                  <TextBlock Text="{Binding Name}" />
                </StackPanel>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}" />
          <GridViewColumn Header="Modified" Width="130" DisplayMemberBinding="{Binding ModifiedText}" />
        </GridView>
      </ListView.View>
    </ListView>
    <DockPanel Grid.Row="2" Margin="0 6 0 0">
      <TextBlock DockPanel.Dock="Left" Text="File name:" VerticalAlignment="Center" Margin="0 0 6 0" />
      <ComboBox DockPanel.Dock="Right" Name="FilterCombo" MinWidth="160" Margin="6 0 0 0" SelectionChanged="FilterCombo_SelectionChanged" />
      <TextBox Name="FileNameBox" KeyDown="FileNameBox_KeyDown" />
    </DockPanel>
    <TextBlock Grid.Row="3" Name="ErrorText" Foreground="{DynamicResource Theme.Error}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0 6 0 0" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
      <Button Name="AcceptButton" Content="_Open" IsDefault="True" MinWidth="75" Margin="0 0 5 0" Click="Accept_Click" />
      <Button Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="75" />
    </StackPanel>
  </Grid>
</Window>
