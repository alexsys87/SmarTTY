<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SmarTTY.GUI.FileListControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SmarTTY.GUI" IsVisibleChanged="UserControl_IsVisibleChanged">
  <UserControl.Resources>
    <!-- Names and permissions coloured by access permissions; a selected row keeps the foreground of the selection -->
    <Style x:Key="PermissionText" TargetType="{x:Type TextBlock}">
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Highlight}" Value="ReadOnly" />
            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="False" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Foreground" Value="{DynamicResource Theme.Permission.ReadOnly}" />
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Highlight}" Value="Executable" />
            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="False" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Foreground" Value="{DynamicResource Theme.Permission.Executable}" />
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Highlight}" Value="SetId" />
            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="False" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Foreground" Value="{DynamicResource Theme.Permission.SetId}" />
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Highlight}" Value="WorldWritable" />
            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="False" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Foreground" Value="{DynamicResource Theme.Permission.WorldWritable}" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ToolBar Name="toolBar" SizeChanged="ToolBar_SizeChanged">
      <Button ToolTip="Download file" ToolBar.OverflowMode="Never" Click="DownloadFile_Click">
        <Image Width="16" Height="16" Source="../icons/MainWindow/download.png" />
      </Button>
      <Button ToolTip="Open in editor" ToolBar.OverflowMode="Never" Click="OpenFile_Click">
        <Image Width="16" Height="16" Source="../icons/open16.png" />
      </Button>
      <Button ToolTip="Refresh file list" ToolBar.OverflowMode="Never" Click="Refresh_Click">
        <Image Width="16" Height="16" Source="../icons/MainWindow/refresh16.png" />
      </Button>
      <Separator />
      <TextBlock Text="Filter:" VerticalAlignment="Center" ToolBar.OverflowMode="Never" />
      <TextBox Name="txtFilter" Width="100" Margin="5 0 0 0" Style="{DynamicResource ThemedTextBox}" ToolBar.OverflowMode="Never" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
    </ToolBar>
    <ContentControl Grid.Row="1" IsEnabledChanged="ContentControl_IsEnabledChanged">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type ContentControl}">
          <Setter Property="IsEnabled" Value="False" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ProgressText}" Value="{x:Null}">
              <Setter Property="IsEnabled" Value="True" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <ListView Name="TransferList" ItemsSource="{Binding FilteredItems}" SelectionMode="Extended" AllowDrop="True" DragEnter="TransferList_DragOver" DragOver="TransferList_DragOver" Drop="TransferList_Drop" PreviewMouseLeftButtonDown="TransferList_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="TransferList_PreviewMouseLeftButtonUp" PreviewMouseMove="TransferList_PreviewMouseMove" KeyDown="ListView_KeyDown" MouseDoubleClick="TransferList_MouseDoubleClick" SelectionChanged="TransferList_SelectionChanged" ContextMenuOpening="TransferList_ContextMenuOpening">
        <FrameworkElement.ContextMenu>
          <ContextMenu Name="xferMenu" Opened="XferMenu_Opened">
            <MenuItem Name="cmdEdit" Header="Edit..." Click="OpenFile_Click">
              <MenuItem.Icon>
                <Image Source="../icons/edit16.png" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Name="cmdDownload" Header="Download..." Click="DownloadFile_Click">
              <MenuItem.Icon>
                <Image Source="../icons/MainWindow/download.png" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Name="cmdRun" Header="Run" ToolTip="Runs the selected shell script in the terminal, from the folder it is in" Click="Run_Click">
              <MenuItem.Icon>
                <Image Source="../icons/PlayHS.png" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Name="cmdNavigate" Header="Go to subdirectory.." Click="Navigate_Click">
              <MenuItem.Icon>
                <Image Source="../icons/MainWindow/go16.png" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Name="cmdDownloadArchive" Header="Download folder as .tar.gz..." Click="DownloadArchive_Click" ToolTip="Packs the selected folder with tar and gzip on the server and downloads the archive">
              <MenuItem.Icon>
                <Image Source="../icons/MainWindow/archive16.png" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Name="cmdExtract" Header="Extract here" ToolTip="Unpacks the selected .tar.gz, .tgz or .tar archive into this folder (existing files of the same name are overwritten)" Click="Extract_Click">
              <MenuItem.Icon>
                <Image Source="../icons/menu/extract.png" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Name="cmdInstallIpk" Header="Install package (opkg)" ToolTip="Installs the selected .ipk packages on this OpenWrt device with opkg; the command runs in the terminal" Click="InstallPackage_Click" Visibility="Collapsed">
              <MenuItem.Icon>
                <Image Source="../icons/menu/package-install.png" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Name="cmdInstallApk" Header="Install package (apk)" ToolTip="Installs the selected .apk packages on this OpenWrt device with apk add; the command runs in the terminal" Click="InstallPackage_Click" Visibility="Collapsed">
              <MenuItem.Icon>
                <Image Source="../icons/menu/package-install.png" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Name="cmdCut" Header="Cut" InputGestureText="Ctrl+X" Click="Cut_Click">
              <MenuItem.Icon>
                <Image Source="../icons/menu/cut.png" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Name="cmdCopy" Header="Copy" InputGestureText="Ctrl+C" Click="Copy_Click">
              <MenuItem.Icon>
                <Image Source="../icons/MainWindow/copy.png" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Name="cmdPaste" Header="Paste" InputGestureText="Ctrl+V" Click="Paste_Click">
              <MenuItem.Icon>
                <Image Source="../icons/MainWindow/paste.png" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Name="cmdRename" Header="Rename..." InputGestureText="F2" Click="Rename_Click">
              <MenuItem.Icon>
                <Image Source="../icons/menu/rename.png" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Name="cmdDelete" Header="Delete..." InputGestureText="Del" Click="Delete_Click">
              <MenuItem.Icon>
                <Image Source="../icons/delete16.png" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Name="cmdMakeExecutable" Header="Make executable" ToolTip="Runs chmod +x on the selected files and folders" Click="MakeExecutable_Click">
              <MenuItem.Icon>
                <Image Source="../icons/menu/executable.png" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Name="cmdPermissions" Header="Permissions..." ToolTip="Sets the access permissions (chmod) of the selected files and folders, also for what is inside the folders" Click="Permissions_Click">
              <MenuItem.Icon>
                <Image Source="../icons/menu/permissions.png" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Name="cmdNewFolder" Header="New folder..." InputGestureText="Ctrl+Shift+N" Click="NewFolder_Click">
              <MenuItem.Icon>
                <Image Source="../icons/menu/newfolder.png" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Name="cmdNewFile" Header="New empty file..." Click="NewFile_Click">
              <MenuItem.Icon>
                <Image Source="../icons/menu/newfile.png" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </FrameworkElement.ContextMenu>
        <ListView.View>
          <GridView>
            <GridView.Columns>
              <GridViewColumn Header="File name">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Image Width="16" Height="16" Panel.ZIndex="0">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type Image}">
                            <Style.Triggers>
                              <DataTrigger Value="File" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/MainWindow/document_flat.png" />
                              </DataTrigger>
                              <DataTrigger Value="Folder" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/MainWindow/folder_flat.png" />
                              </DataTrigger>
                              <DataTrigger Value="PackageIpk" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/MainWindow/package_ipk.png" />
                              </DataTrigger>
                              <DataTrigger Value="PackageApk" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/MainWindow/package_apk.png" />
                              </DataTrigger>
                              <DataTrigger Value="PackageDeb" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/package_deb.png" />
                              </DataTrigger>
                              <DataTrigger Value="PackageRpm" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/package_rpm.png" />
                              </DataTrigger>
                              <DataTrigger Value="Archive" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/archive.png" />
                              </DataTrigger>
                              <DataTrigger Value="Image" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/image.png" />
                              </DataTrigger>
                              <DataTrigger Value="Audio" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/audio.png" />
                              </DataTrigger>
                              <DataTrigger Value="Video" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/video.png" />
                              </DataTrigger>
                              <DataTrigger Value="Text" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/text.png" />
                              </DataTrigger>
                              <DataTrigger Value="Document" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/document.png" />
                              </DataTrigger>
                              <DataTrigger Value="Pdf" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/pdf.png" />
                              </DataTrigger>
                              <DataTrigger Value="Spreadsheet" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/spreadsheet.png" />
                              </DataTrigger>
                              <DataTrigger Value="Presentation" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/presentation.png" />
                              </DataTrigger>
                              <DataTrigger Value="Config" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/config.png" />
                              </DataTrigger>
                              <DataTrigger Value="Log" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/log.png" />
                              </DataTrigger>
                              <DataTrigger Value="Shell" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/shell.png" />
                              </DataTrigger>
                              <DataTrigger Value="Python" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/python.png" />
                              </DataTrigger>
                              <DataTrigger Value="CSource" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/csource.png" />
                              </DataTrigger>
                              <DataTrigger Value="Code" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/code.png" />
                              </DataTrigger>
                              <DataTrigger Value="Web" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/web.png" />
                              </DataTrigger>
                              <DataTrigger Value="Data" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/data.png" />
                              </DataTrigger>
                              <DataTrigger Value="Database" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/database.png" />
                              </DataTrigger>
                              <DataTrigger Value="Binary" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/binary.png" />
                              </DataTrigger>
                              <DataTrigger Value="DiskImage" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/diskimage.png" />
                              </DataTrigger>
                              <DataTrigger Value="Certificate" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/certificate.png" />
                              </DataTrigger>
                              <DataTrigger Value="Font" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/font.png" />
                              </DataTrigger>
                              <DataTrigger Value="Backup" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/backup.png" />
                              </DataTrigger>
                              <DataTrigger Value="Patch" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/patch.png" />
                              </DataTrigger>
                              <DataTrigger Value="JavaScript" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/javascript.png" />
                              </DataTrigger>
                              <DataTrigger Value="TypeScript" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/typescript.png" />
                              </DataTrigger>
                              <DataTrigger Value="Php" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/php.png" />
                              </DataTrigger>
                              <DataTrigger Value="Perl" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/perl.png" />
                              </DataTrigger>
                              <DataTrigger Value="Ruby" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/ruby.png" />
                              </DataTrigger>
                              <DataTrigger Value="Go" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/go.png" />
                              </DataTrigger>
                              <DataTrigger Value="Rust" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/rust.png" />
                              </DataTrigger>
                              <DataTrigger Value="Java" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/java.png" />
                              </DataTrigger>
                              <DataTrigger Value="Lua" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/lua.png" />
                              </DataTrigger>
                              <DataTrigger Value="Make" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/make.png" />
                              </DataTrigger>
                              <DataTrigger Value="Markdown" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/markdown.png" />
                              </DataTrigger>
                              <DataTrigger Value="Css" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/css.png" />
                              </DataTrigger>
                              <DataTrigger Value="Library" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/library.png" />
                              </DataTrigger>
                              <DataTrigger Value="Firmware" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/firmware.png" />
                              </DataTrigger>
                              <DataTrigger Value="Executable" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/executable.png" />
                              </DataTrigger>
                              <DataTrigger Value="Service" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/service.png" />
                              </DataTrigger>
                              <DataTrigger Value="Git" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/git.png" />
                              </DataTrigger>
                              <DataTrigger Value="Docker" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/docker.png" />
                              </DataTrigger>
                              <DataTrigger Value="Mail" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/mail.png" />
                              </DataTrigger>
                              <DataTrigger Value="Man" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/man.png" />
                              </DataTrigger>
                              <DataTrigger Value="ArchiveTar" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/archive_tar.png" />
                              </DataTrigger>
                              <DataTrigger Value="ArchiveGzip" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/archive_gzip.png" />
                              </DataTrigger>
                              <DataTrigger Value="ArchiveZip" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/archive_zip.png" />
                              </DataTrigger>
                              <DataTrigger Value="Archive7z" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/archive_7z.png" />
                              </DataTrigger>
                              <DataTrigger Value="ArchiveRar" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/archive_rar.png" />
                              </DataTrigger>
                              <DataTrigger Value="ArchiveXz" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/archive_xz.png" />
                              </DataTrigger>
                              <DataTrigger Value="ArchiveBzip2" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/archive_bzip2.png" />
                              </DataTrigger>
                              <DataTrigger Value="ArchiveZstd" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/archive_zstd.png" />
                              </DataTrigger>
                              <DataTrigger Value="Bin" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/bin.png" />
                              </DataTrigger>
                              <DataTrigger Value="Libtool" Binding="{Binding Path=Icon}">
                                <Setter Property="Source" Value="../icons/filetypes/libtool.png" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </Image>
                      <TextBlock Grid.Column="1" Margin="2 0 0 0" Text="{Binding Name}" ToolTip="{Binding PermissionsToolTip}" Style="{StaticResource PermissionText}" />
                    </Grid>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" />
              <GridViewColumn Header="Permissions">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding PermissionsText}" FontFamily="Consolas, Courier New" Style="{StaticResource PermissionText}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView.Columns>
          </GridView>
        </ListView.View>
      </ListView>
    </ContentControl>
    <Grid Row="2">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Grid}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ProgressText}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ProgressBar IsIndeterminate="True" />
      <TextBlock Grid.Column="1" Margin="5 0 0 0" Text="{Binding ProgressText}" />
    </Grid>
  </Grid>
</UserControl>