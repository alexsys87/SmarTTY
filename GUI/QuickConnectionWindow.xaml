<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.QuickConnectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:SmarTTY.GUI" WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight" SnapsToDevicePixels="True" Title="Quick SSH Connection" Style="{DynamicResource SecondaryWindowStyle}" FocusManager.FocusedElement="{Binding ElementName=txtMachine}">
  <StackPanel Orientation="Vertical" Margin="10">
    <TextBlock Name="lblHeader" Text="Connect to a machine via SSH without remembering settings:" />
    <Grid Margin="5">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Machine:" VerticalAlignment="Center" Margin="0 0 5 0" />
      <TextBox Name="txtMachine" Grid.Column="1" Margin="2" MinWidth="220" Tag="username@hostname" />
      <TextBlock Name="lblPassword" Text="Password:" Grid.Row="1" VerticalAlignment="Center" Margin="0 0 5 0" />
      <PasswordBox Name="txtPassword" Grid.Column="1" Grid.Row="1" Margin="2" />
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Grid.Column="3" Grid.Row="2" Margin="5 0 5 0" IsDefault="True" MinWidth="75" MinHeight="26" AutomationProperties.AutomationId="OK" Click="OK_Click">
        <AccessText Text="_OK" />
      </Button>
      <Button Grid.Column="4" Grid.Row="2" Margin="5 0 5 0" IsCancel="True" MinWidth="75" MinHeight="26" AutomationProperties.AutomationId="Cancel" Click="Cancel_Click">
        <AccessText Text="_Cancel" />
      </Button>
    </StackPanel>
  </StackPanel>
</Window>