<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.QuickConnectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:SmarTTY.GUI" WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight" SnapsToDevicePixels="True" Title="Quick SSH Connection" FocusManager.FocusedElement="{Binding ElementName=txtMachine}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <VisualBrush x:Key="MachineHint" Stretch="None" AlignmentX="Left">
        <VisualBrush.Visual>
          <TextBlock FontStyle="Italic" Opacity="0.5" Text="username@hostname" Margin="2 1 0 0" Padding="5,0,1000,0" VerticalAlignment="Center" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        </VisualBrush.Visual>
      </VisualBrush>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Orientation="Vertical" Margin="10">
    <TextBlock Text="Connect to a machine via SSH without remembering settings:" />
    <Grid Margin="5">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Machine:" VerticalAlignment="Center" Margin="0 0 5 0" />
      <TextBox Name="txtMachine" Grid.Column="1" Margin="2">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type TextBox}">
            <Style.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Text" Value="" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource MachineHint}" />
              </MultiTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBox>
      <TextBlock Text="Password:" Grid.Row="1" VerticalAlignment="Center" Margin="0 0 5 0" />
      <PasswordBox Name="txtPassword" Grid.Column="1" Grid.Row="1" Margin="2" />
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Grid.Column="3" Grid.Row="2" Margin="5 0 5 0" IsDefault="True" MinWidth="75" MinHeight="26" AutomationProperties.AutomationId="OK" Click="OK_Click">
        <AccessText Text="_OK" />
      </Button>
      <Button Grid.Column="4" Grid.Row="2" Margin="5 0 5 0" IsCancel="True" MinWidth="75" MinHeight="26" AutomationProperties.AutomationId="Cancel" Click="Cancel_Click">
        <AccessText Text="_Cancel" />
      </Button>
    </StackPanel>
  </StackPanel>
</Window>