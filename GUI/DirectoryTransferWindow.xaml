<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.DirectoryTransferWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource SecondaryWindowStyle}" Title="Download a directory" Width="514" MinWidth="380" MaxWidth="2000" SizeToContent="Height" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="105.474" />
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Name="TransferImage" Width="52" Height="47" VerticalAlignment="Top" Margin="0 0 6 0" />
        <TextBlock Grid.Column="1" Name="TopLabel" Text="Remote directory:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox Grid.Row="0" Grid.Column="2" Name="TopBox" MinWidth="200" Grid.ColumnSpan="3" Margin="0,0,35,0" />
        <Button Grid.Row="0" Grid.Column="4" Name="TopBrowseButton" Margin="6,0,0,0" Padding="6 2" ToolTip="Browse the folders on the remote host" Click="TopBrowse_Click" Grid.ColumnSpan="2">
            <Image Source="pack://application:,,,/icons/dialog-browse-folder.png" Width="16" Height="16" />
        </Button>
        <TextBlock Grid.Row="1" Grid.Column="1" Name="BottomLabel" Text="Local directory:" VerticalAlignment="Top" Margin="0,10,8,0" />
        <TextBox Grid.Row="1" Grid.Column="2" Name="BottomBox" MinWidth="200" Margin="0,6,35,0" Grid.ColumnSpan="3" />
        <Button Grid.Row="1" Grid.Column="4" Name="BottomBrowseButton" Margin="6 6 0 0" Padding="6 2" ToolTip="Browse the local folders" Click="BottomBrowse_Click" Grid.ColumnSpan="1">
            <Image Source="pack://application:,,,/icons/dialog-browse-folder.png" Width="16" Height="16" />
        </Button>
        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0 6 0 0">
            <RadioButton Name="TarRadio" Content="Use on-the-fly TAR" IsChecked="True" Margin="0 0 16 0" />
            <RadioButton Name="ScpRadio" Content="Invoke SCP file-by-file (slow)" />
        </StackPanel>
        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Name="StatusText" Text="Inactive" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" VerticalAlignment="Top" />
        <TextBlock Grid.Row="3" Grid.Column="4" Name="StatsText" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" Margin="0,8,0,0" VerticalAlignment="Top" />
        <ProgressBar Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Name="TransferProgress" Height="22" Minimum="0" Maximum="1000" Visibility="Collapsed" VerticalAlignment="Center" />
        <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0" Grid.ColumnSpan="3">
            <Button Name="StartButton" Content="_Download" MinWidth="75" Margin="0 0 5 0" Click="Start_Click" />
            <Button Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="75" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
