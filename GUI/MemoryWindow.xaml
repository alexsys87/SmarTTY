<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.MemoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Memory (devmem)" SnapsToDevicePixels="True" WindowStartupLocation="CenterOwner" Width="1180" Height="800" MinWidth="760" MinHeight="560" Style="{DynamicResource SecondaryWindowStyle}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <SolidColorBrush x:Key="ChangedBrush" Color="#66FFC107" />
    <!-- The frame of a cell of the table: amber while the value has changed lately (the rows themselves are drawn by the theme). -->
    <Style x:Key="CellBorder" TargetType="{x:Type Border}">
      <Setter Property="Margin" Value="-6 -3 -6 -3" />
      <Setter Property="Padding" Value="6 3 6 3" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
          <Setter Property="Background" Value="{StaticResource ChangedBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The tool and the user, and the warning about addresses where nothing answers. -->
    <StackPanel Grid.Row="0" Margin="0 0 0 6">
      <TextBlock Name="HostText" TextWrapping="Wrap" Text="Asking the server..." />
      <TextBlock Margin="0 2 0 0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.Error}">
        Read only addresses where something answers: on a Zynq, an access to a PL address without an AXI slave (or with the PL not
        configured, its clock stopped or held in reset) never completes and hangs the whole system. The automatic refresh reads the
        checked registers again and again.
      </TextBlock>
    </StackPanel>

    <!-- What to show: an address range or one register. -->
    <WrapPanel Grid.Row="1" Margin="0 0 0 4">
      <TextBlock Text="Address:" VerticalAlignment="Center" Margin="0 0 4 0" />
      <TextBox Name="AddressBox" Width="130" Margin="0 2 8 2" FontFamily="Consolas" VerticalContentAlignment="Center" Style="{DynamicResource ThemedTextBox}" Text="0x43C00000" ToolTip="Physical address in hex (0x43C00000, 43C0_0000) or decimal with # (#1024)" />
      <TextBlock Text="Registers:" VerticalAlignment="Center" Margin="0 0 4 0" />
      <TextBox Name="CountBox" Width="60" Margin="0 2 8 2" VerticalContentAlignment="Center" Style="{DynamicResource ThemedTextBox}" Text="16" ToolTip="How many registers from the address (at most 4096)" />
      <TextBlock Text="Width:" VerticalAlignment="Center" Margin="0 0 4 0" />
      <ComboBox Name="WidthBox" Width="80" Margin="0 2 8 2" ToolTip="The access width: devmem reads and writes 8, 16, 32 or 64 bits at once (devmem2: 8, 16, 32)" />
      <Button Name="ShowRegionButton" Padding="8 2 8 2" Margin="0 2 6 2" Click="ShowRegion_Click" ToolTip="Replace the list with these registers and read them once">
        <StackPanel Orientation="Horizontal">
          <Image Width="16" Height="16" Source="../icons/MainWindow/go16.png" />
          <TextBlock Margin="4 0 0 0" Text="Show" />
        </StackPanel>
      </Button>
      <Button Name="AppendButton" Padding="8 2 8 2" Margin="0 2 14 2" Click="Append_Click" ToolTip="Add these registers to the end of the list and read them once">
        <StackPanel Orientation="Horizontal">
          <Image Width="16" Height="16" Source="../icons/MainWindow/add16.png" />
          <TextBlock Margin="4 0 0 0" Text="Add to list" />
        </StackPanel>
      </Button>
      <TextBlock Text="Region:" VerticalAlignment="Center" Margin="0 0 4 0" />
      <ComboBox Name="RegionBox" Width="380" Margin="0 2 4 2" SelectionChanged="Region_SelectionChanged" ToolTip="Puts the start of a region into the address field (nothing is read): the regions of /proc/iomem of the server (the devices of the device tree, /amba_pl for the PL) and the address map of the Zynq-7000" />
      <Button Name="IomemButton" Padding="6 2 6 2" Margin="0 2 0 2" Click="Iomem_Click" ToolTip="Read /proc/iomem of the server again">
        <Image Width="16" Height="16" Source="../icons/MainWindow/refresh16.png" />
      </Button>
    </WrapPanel>

    <!-- Reading, the automatic refresh, the columns. -->
    <WrapPanel Grid.Row="2" Margin="0 0 0 6">
      <Button Name="ReadButton" Padding="8 2 8 2" Margin="0 2 8 2" Click="Read_Click" ToolTip="Read every register of the list now (F5)">
        <StackPanel Orientation="Horizontal">
          <Image Width="16" Height="16" Source="../icons/MainWindow/refresh16.png" />
          <TextBlock Margin="4 0 0 0" Text="Read all" />
        </StackPanel>
      </Button>
      <CheckBox Name="AutoBox" VerticalAlignment="Center" Margin="0 2 4 2" Content="Read the checked rows every" Checked="Auto_Changed" Unchecked="Auto_Changed" />
      <TextBox Name="IntervalBox" Width="55" Margin="0 2 4 2" VerticalContentAlignment="Center" Style="{DynamicResource ThemedTextBox}" Text="1000" ToolTip="Milliseconds between two readings (at least 100)" LostFocus="Interval_LostFocus" />
      <TextBlock Text="ms; changes highlighted for" VerticalAlignment="Center" Margin="0 0 4 0" />
      <TextBox Name="HighlightBox" Width="45" Margin="0 2 4 2" VerticalContentAlignment="Center" Style="{DynamicResource ThemedTextBox}" Text="3" ToolTip="Seconds a changed value stays highlighted" />
      <TextBlock Text="s" VerticalAlignment="Center" Margin="0 0 10 0" />
      <Button Content="Check all" Padding="6 2 6 2" Margin="0 2 4 2" Click="WatchAll_Click" ToolTip="Read every row in the automatic refresh" />
      <Button Content="Check none" Padding="6 2 6 2" Margin="0 2 4 2" Click="WatchNone_Click" />
      <Button Content="Reset changes" Padding="6 2 6 2" Margin="0 2 10 2" Click="ResetChanges_Click" ToolTip="Set the change counters back to 0 and forget the previous values" />
      <TextBlock Text="Columns:" VerticalAlignment="Center" Margin="0 0 4 0" />
      <CheckBox Name="ColHex" Content="Hex" VerticalAlignment="Center" Margin="0 2 6 2" IsChecked="True" Checked="Columns_Changed" Unchecked="Columns_Changed" />
      <CheckBox Name="ColUnsigned" Content="Decimal" VerticalAlignment="Center" Margin="0 2 6 2" IsChecked="True" Checked="Columns_Changed" Unchecked="Columns_Changed" />
      <CheckBox Name="ColSigned" Content="Signed" VerticalAlignment="Center" Margin="0 2 6 2" Checked="Columns_Changed" Unchecked="Columns_Changed" />
      <CheckBox Name="ColBinary" Content="Binary" VerticalAlignment="Center" Margin="0 2 6 2" IsChecked="True" Checked="Columns_Changed" Unchecked="Columns_Changed" />
      <CheckBox Name="ColAscii" Content="ASCII" VerticalAlignment="Center" Margin="0 2 6 2" IsChecked="True" Checked="Columns_Changed" Unchecked="Columns_Changed" />
      <CheckBox Name="ColFloat" Content="Float" VerticalAlignment="Center" Margin="0 2 6 2" Checked="Columns_Changed" Unchecked="Columns_Changed" />
      <CheckBox Name="ColChanges" Content="Changes" VerticalAlignment="Center" Margin="0 2 6 2" IsChecked="True" Checked="Columns_Changed" Unchecked="Columns_Changed" />
    </WrapPanel>

    <!-- The registers. -->
    <ListView Name="RowList" Grid.Row="3" SelectionMode="Extended" FontFamily="Consolas" VirtualizingStackPanel.IsVirtualizing="True" SelectionChanged="RowList_SelectionChanged" KeyDown="RowList_KeyDown">
      <ListView.ItemContainerStyle>
        <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Theme.Error}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Read the selected rows" Click="ReadSelected_Click" />
          <MenuItem Header="Copy the selected rows" Click="Copy_Click" />
          <MenuItem Header="Copy the value (hex)" Click="CopyValue_Click" />
          <Separator />
          <MenuItem Header="Check the selected rows for the refresh" Click="WatchSelected_Click" />
          <MenuItem Header="Uncheck the selected rows" Click="UnwatchSelected_Click" />
          <Separator />
          <MenuItem Header="Remove the selected rows" Click="Remove_Click" />
        </ContextMenu>
      </ListView.ContextMenu>
      <ListView.View>
        <GridView x:Name="RowGrid" />
      </ListView.View>
    </ListView>

    <!-- Writing the selected register. -->
    <GroupBox Name="WriteGroup" Grid.Row="4" Header="Write the selected register" Margin="0 6 0 0" IsEnabled="False">
      <Grid Margin="6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0 0 16 0">
          <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
            <TextBlock Text="Value:" Width="50" VerticalAlignment="Center" />
            <TextBox Name="ValueBox" Width="190" FontFamily="Consolas" VerticalContentAlignment="Center" Style="{DynamicResource ThemedTextBox}" KeyDown="ValueBox_KeyDown" ToolTip="0x1F, 0b1010, 31 or -1 (two's complement); Enter writes it" />
            <Button Name="WriteButton" Content="_Write" MinWidth="70" Margin="4 0 0 0" Click="Write_Click" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
            <TextBlock Text="Bits:" Width="50" VerticalAlignment="Center" />
            <TextBox Name="FieldBox" Width="60" FontFamily="Consolas" VerticalContentAlignment="Center" Style="{DynamicResource ThemedTextBox}" Text="[7:4]" ToolTip="The bit field: [7:4], 7:4 or a single bit number" />
            <TextBlock Text="=" VerticalAlignment="Center" Margin="4 0 4 0" />
            <TextBox Name="FieldValueBox" Width="110" FontFamily="Consolas" VerticalContentAlignment="Center" Style="{DynamicResource ThemedTextBox}" ToolTip="The value of the field: 0x5, 0b101 or 5" />
            <Button Name="WriteFieldButton" Content="Write field" MinWidth="70" Margin="4 0 0 0" Click="WriteField_Click" ToolTip="Read the register, replace the field and write it back (the other bits stay)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
            <TextBlock Text="Mask:" Width="50" VerticalAlignment="Center" />
            <TextBox Name="MaskBox" Width="110" FontFamily="Consolas" VerticalContentAlignment="Center" Style="{DynamicResource ThemedTextBox}" ToolTip="The bits to change: 0x0F, 0b1000" />
            <Button Content="Set" MinWidth="44" Margin="4 0 0 0" Click="SetMask_Click" ToolTip="value | mask" />
            <Button Content="Clear" MinWidth="44" Margin="4 0 0 0" Click="ClearMask_Click" ToolTip="value &amp; ~mask" />
            <Button Content="Toggle" MinWidth="44" Margin="4 0 0 0" Click="ToggleMask_Click" ToolTip="value ^ mask" />
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <CheckBox Name="ConfirmBox" Content="Ask before each write" IsChecked="True" VerticalAlignment="Center" Margin="0 0 12 0" />
            <Button Name="UndoButton" Content="Undo last write" MinWidth="100" IsEnabled="False" Click="Undo_Click" ToolTip="Write back the value the register had before the last write" />
          </StackPanel>
        </StackPanel>
        <!-- One button per bit, the most significant one first: a click reads the register, flips the bit and writes it. -->
        <StackPanel Grid.Column="1">
          <TextBlock Name="BitsTitle" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}" Text="Click a bit to flip it (read, change, write):" Margin="0 0 0 2" />
          <WrapPanel Name="BitPanel" />
          <TextBlock Name="FieldInfoText" Margin="0 4 0 0" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource Theme.TextSecondary}" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <!-- The writes and the errors. -->
    <TextBox Name="LogBox" Grid.Row="5" Height="80" Margin="0 6 0 0" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Style="{DynamicResource ThemedTextBox}" />

    <DockPanel Grid.Row="6" Margin="0 8 0 0" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Open list..." MinWidth="85" Margin="0 0 6 0" Click="OpenList_Click" ToolTip="Open a list of registers saved before (.xml)" />
        <Button Content="Save list..." MinWidth="85" Margin="0 0 6 0" Click="SaveList_Click" ToolTip="Save the registers with their names and the settings of the window" />
        <Button Content="Export CSV..." MinWidth="85" Margin="0 0 6 0" Click="ExportCsv_Click" />
        <Button Content="Close" MinWidth="80" IsCancel="True" Click="Close_Click" />
      </StackPanel>
      <TextBlock Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>
  </Grid>
</Window>
