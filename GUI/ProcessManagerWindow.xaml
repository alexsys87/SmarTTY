<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SmarTTY.GUI.ProcessManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Process manager" SnapsToDevicePixels="True" WindowStartupLocation="CenterOwner" Width="860" Height="520" MinWidth="560" MinHeight="300" Style="{DynamicResource SecondaryWindowStyle}" FocusManager.FocusedElement="{Binding ElementName=ProcessList}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ToolBar>
      <Button Name="RefreshButton" Padding="8 2 8 2" ToolTip="Read the list of processes again (F5)" Click="Refresh_Click">
        <StackPanel Orientation="Horizontal">
          <Image Width="16" Height="16" Source="../icons/MainWindow/refresh16.png" />
          <TextBlock Margin="4 0 0 0" Text="Refresh" />
        </StackPanel>
      </Button>
      <CheckBox Name="AutoRefreshBox" Margin="8 0 4 0" VerticalAlignment="Center" IsChecked="True" ToolTip="Read the list again every few seconds" Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed">
        <TextBlock Text="Every 3 s" />
      </CheckBox>
      <Separator />
      <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="5" />
      <TextBox Name="FilterBox" MinWidth="170" VerticalAlignment="Center" Style="{DynamicResource ThemedTextBox}" ToolTip="Part of the process number, the user, the name or the command line" TextChanged="Filter_TextChanged" />
      <Separator />
      <Button Name="EndButton" Padding="8 2 8 2" IsEnabled="False" ToolTip="Ask the selected process to end (SIGTERM, kill -15): the program can still save its work (Del)" Click="End_Click">
        <StackPanel Orientation="Horizontal">
          <Image Width="16" Height="16" Source="../icons/delete16.png" />
          <TextBlock Margin="4 0 0 0" Text="End process" />
        </StackPanel>
      </Button>
      <Button Name="KillButton" Padding="8 2 8 2" IsEnabled="False" ToolTip="Stop the selected process at once (SIGKILL, kill -9): use it when ending does not help (Shift+Del)" Click="Kill_Click">
        <TextBlock Text="Force kill" />
      </Button>
    </ToolBar>
    <!-- The load of the whole server: each meter has the value on the right of its name, the bar, and a line of detail. -->
    <Border Grid.Row="1" Padding="10 8 10 8" Background="{DynamicResource Theme.SurfaceBackground}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0 0 0 1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0 0 12 0" ToolTip="How busy all processor cores together were since the previous reading">
          <DockPanel>
            <TextBlock Name="CpuValueText" DockPanel.Dock="Right" FontWeight="SemiBold" Text="..." />
            <TextBlock Text="CPU" FontWeight="SemiBold" />
          </DockPanel>
          <ProgressBar Name="CpuMeter" Height="14" Margin="0 4 0 0" Maximum="100" />
          <TextBlock Name="CpuDetailText" Margin="0 3 0 0" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0 0 12 0" ToolTip="Memory in use (without the cache that programs can take back) of all the memory of the server">
          <DockPanel>
            <TextBlock Name="MemoryValueText" DockPanel.Dock="Right" FontWeight="SemiBold" Text="..." />
            <TextBlock Text="Memory" FontWeight="SemiBold" />
          </DockPanel>
          <ProgressBar Name="MemoryMeter" Height="14" Margin="0 4 0 0" Maximum="100" />
          <TextBlock Name="MemoryDetailText" Margin="0 3 0 0" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="0 0 12 0" ToolTip="How much of the time the busiest disk had requests to work on since the previous reading (like util in iostat)">
          <DockPanel>
            <TextBlock Name="DiskValueText" DockPanel.Dock="Right" FontWeight="SemiBold" Text="..." />
            <TextBlock Text="Disk activity" FontWeight="SemiBold" />
          </DockPanel>
          <ProgressBar Name="DiskMeter" Height="14" Margin="0 4 0 0" Maximum="100" />
          <TextBlock Name="DiskDetailText" Margin="0 3 0 0" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="3" ToolTip="Used space of the file system that holds /">
          <DockPanel>
            <TextBlock Name="StorageValueText" DockPanel.Dock="Right" FontWeight="SemiBold" Text="..." />
            <TextBlock Text="Disk space" FontWeight="SemiBold" />
          </DockPanel>
          <ProgressBar Name="StorageMeter" Height="14" Margin="0 4 0 0" Maximum="100" />
          <TextBlock Name="StorageDetailText" Margin="0 3 0 0" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>
    <ListView Name="ProcessList" Grid.Row="2" SelectionMode="Single" VirtualizingStackPanel.IsVirtualizing="True" GridViewColumnHeader.Click="Header_Click" SelectionChanged="ProcessList_SelectionChanged" PreviewKeyDown="ProcessList_PreviewKeyDown">
      <FrameworkElement.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened">
          <MenuItem Name="EndMenuItem" Header="End process" Click="End_Click">
            <MenuItem.Icon>
              <Image Source="../icons/delete16.png" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Name="KillMenuItem" Header="Force kill" Click="Kill_Click" />
          <Separator />
          <MenuItem Name="CopyMenuItem" Header="Copy command line" Click="CopyCommand_Click">
            <MenuItem.Icon>
              <Image Source="../icons/MainWindow/copy.png" />
            </MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </FrameworkElement.ContextMenu>
      <ListView.View>
        <GridView>
          <GridView.Columns>
            <GridViewColumn Header="PID" Width="64">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock TextAlignment="Right" Text="{Binding Pid}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="User" Width="90" DisplayMemberBinding="{Binding User}" />
            <GridViewColumn Header="CPU %" Width="110">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Grid MinHeight="16" ToolTip="{Binding CpuToolTip}">
                    <ProgressBar Maximum="100" Height="16" BorderThickness="0" Opacity="0.7" Value="{Binding CpuBar, Mode=OneWay}" Foreground="{Binding CpuBrush, Mode=OneWay}" />
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding CpuText}" />
                  </Grid>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Memory" Width="110">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Grid MinHeight="16" ToolTip="{Binding MemoryToolTip}">
                    <ProgressBar Maximum="100" Height="16" BorderThickness="0" Opacity="0.7" Value="{Binding MemoryPercent, Mode=OneWay}" Foreground="{Binding MemoryBrush, Mode=OneWay}" />
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding MemoryText}" />
                  </Grid>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="State" Width="64">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding State}" ToolTip="{Binding StateDescription}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Name" Width="130" DisplayMemberBinding="{Binding Name}" />
            <GridViewColumn Header="Command" Width="420">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Command}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView.Columns>
        </GridView>
      </ListView.View>
    </ListView>
    <TextBlock Name="StatusText" Grid.Row="3" Margin="8 4 8 4" TextTrimming="CharacterEllipsis" />
  </Grid>
</Window>
