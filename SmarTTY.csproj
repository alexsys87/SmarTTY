<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SmarTTY</AssemblyName>
    <RootNamespace>SmarTTY</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS0197;CS1690;CS0108;CS0109</NoWarn>
    <!-- Visual Studio 2026 (18.5+) design-time builds report a spurious "MC1000: Unknown build error,
         'Value does not fall within the expected range.'" at Microsoft.WinFX.targets(211). The regular
         build is unaffected (https://developercommunity.visualstudio.com/t/11078247). Suppress only that
         task warning while IntelliSense compiles markup; real XAML errors still fail the build. -->
    <MSBuildWarningsAsMessages Condition="'$(BuildingInsideVisualStudio)' == 'true' and ('$(DesignTimeBuild)' == 'true' or '$(BuildingProject)' != 'true')">$(MSBuildWarningsAsMessages);MC1000</MSBuildWarningsAsMessages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Declares per-monitor DPI awareness (see the comment in the file). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Standalone regression harnesses are not part of the Windows application. -->
    <Compile Remove="tests\**\*.cs" />
    <Reference Include="System.Core" />
    <!-- X509Certificate2UI: the certificate picker of the telnet client certificate. -->
    <Reference Include="System.Security" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <!-- SSH.NET channel internals are used via reflection (Ssh/SshNetChannel.cs): check them when updating. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <!--
    Single-executable build: `msbuild -p:SingleExe=true` weaves the managed dependencies (SSH.NET and
    its transitive assemblies) into SmarTTY.exe through Costura.Fody, so the output has no sibling DLLs.
    A regular build stays multi-file, as documented in README.md.
  -->
  <ItemGroup Condition="'$(SingleExe)' == 'true'">
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="VisualTTY\XTermKeys.xml" LogicalName="VisualTTY.XTermKeys.xml" />
    <!-- Window icons of the WinForms dialogs, loaded by Forms/FormIcons.cs. -->
    <EmbeddedResource Include="icons\forms\*.ico" LogicalName="SmarTTY.FormIcons.%(Filename).ico" />
    <EmbeddedResource Include="app.ico" LogicalName="SmarTTY.FormIcons.app.ico" />
    <!-- Images that the WinForms code uses (menu items, context menus, picture boxes, what the editors draw), loaded by Controls/Icons.cs. -->
    <EmbeddedResource Include="icons\MainWindow\upload.png" LogicalName="SmarTTY.Icons.upload.png" />
    <EmbeddedResource Include="icons\MainWindow\download.png" LogicalName="SmarTTY.Icons.download.png" />
