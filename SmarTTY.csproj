<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SmarTTY</AssemblyName>
    <RootNamespace>SmarTTY</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Keeps the output in bin\<Configuration>\net10.0-windows\ without a win-x64 subfolder. -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- The SDK adds the runtime identifier to the publish folder anyway; the single-exe build is published to bin\<Configuration>\net10.0-windows\publish\. -->
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\publish\</PublishDir>
    <!-- Lets the project build on Linux (CI checks, no run). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS0197;CS1690;CS0108;CS0109</NoWarn>
    <!-- Visual Studio 2026 (18.5+) design-time builds report a spurious "MC1000: Unknown build error,
         'Value does not fall within the expected range.'" at Microsoft.WinFX.targets(211). The regular
         build is unaffected (https://developercommunity.visualstudio.com/t/11078247). Suppress only that
         task warning while IntelliSense compiles markup; real XAML errors still fail the build. -->
    <MSBuildWarningsAsMessages Condition="'$(BuildingInsideVisualStudio)' == 'true' and ('$(DesignTimeBuild)' == 'true' or '$(BuildingProject)' != 'true')">$(MSBuildWarningsAsMessages);MC1000</MSBuildWarningsAsMessages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Declares per-monitor DPI awareness (see the comment in the file). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003: the manifest keeps declaring PerMonitorV2, because the process is started as WPF and the manifest is
         what sets its DPI mode (see app.manifest); Application.SetHighDpiMode would be too late. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Standalone regression harnesses are not part of the Windows application. -->
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- SSH.NET channel internals are used via reflection (Ssh/SshNetChannel.cs): check them when updating. -->
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
    <!-- SerialPort is not part of the .NET runtime (Native/SerialPortStream.cs, GUI/RawConnectionSettingsWindow.xaml.cs). -->
    <PackageReference Include="System.IO.Ports" Version="11.0.0" />
    <!-- ProtectedData (IO/DpapiDraftProtector.cs). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>

  <!--
    Single-executable build: `dotnet publish -p:SingleExe=true` produces one self-contained SmarTTY.exe that has the
    runtime and all dependencies inside. A regular build is framework-dependent and multi-file, as documented in README.md.
  -->
  <PropertyGroup Condition="'$(SingleExe)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- WPF ships native DLLs (wpfgfx, PresentationNative, ...); without this they stay next to the exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="VisualTTY\XTermKeys.xml" LogicalName="VisualTTY.XTermKeys.xml" />
    <!-- The built-in command completions (CommandCompletions.xml next to the exe takes priority), see CommandCompletionDatabase. -->
    <EmbeddedResource Include="VisualTTY\CommandCompletions.xml" LogicalName="VisualTTY.CommandCompletions.xml" />
    <EmbeddedResource Include="Completion\ApiSymbols.xml" LogicalName="SmarTTY.Completion.ApiSymbols.xml" />
    <!-- Images of the WPF menus and tool bars of the tabs, loaded by GUI/WpfMenus.cs (the WinForms Controls/Icons.cs until stage 4). -->
    <EmbeddedResource Include="icons\MainWindow\upload.png" LogicalName="SmarTTY.Icons.upload.png" />
    <EmbeddedResource Include="icons\MainWindow\download.png" LogicalName="SmarTTY.Icons.download.png" />
    <EmbeddedResource Include="icons\term16.png" LogicalName="SmarTTY.Icons.terminal.png" />
    <EmbeddedResource Include="icons\gear16.png" LogicalName="SmarTTY.Icons.settings.png" />
    <EmbeddedResource Include="icons\edit16.png" LogicalName="SmarTTY.Icons.edit.png" />
    <EmbeddedResource Include="icons\delete16.png" LogicalName="SmarTTY.Icons.delete.png" />
    <EmbeddedResource Include="icons\net16.png" LogicalName="SmarTTY.Icons.network.png" />
    <EmbeddedResource Include="icons\MainWindow\refresh16.png" LogicalName="SmarTTY.Icons.refresh.png" />
    <EmbeddedResource Include="icons\question16.png" LogicalName="SmarTTY.Icons.question.png" />
    <EmbeddedResource Include="icons\MainWindow\go16.png" LogicalName="SmarTTY.Icons.go.png" />
    <EmbeddedResource Include="icons\event16.png" LogicalName="SmarTTY.Icons.event.png" />
    <EmbeddedResource Include="icons\MainWindow\copy.png" LogicalName="SmarTTY.Icons.copy.png" />
    <EmbeddedResource Include="icons\MainWindow\paste.png" LogicalName="SmarTTY.Icons.paste.png" />
    <EmbeddedResource Include="icons\MainWindow\add16.png" LogicalName="SmarTTY.Icons.add.png" />
    <EmbeddedResource Include="icons\transfers\removeall.png" LogicalName="SmarTTY.Icons.clear.png" />
    <!-- Existing images that the file editor tool bar and context menu reuse. -->
    <EmbeddedResource Include="icons\MainWindow\save16.png" LogicalName="SmarTTY.Icons.save.png" />
    <EmbeddedResource Include="icons\menu\cut.png" LogicalName="SmarTTY.Icons.cut.png" />
    <EmbeddedResource Include="icons\MainWindow\FindHS.png" LogicalName="SmarTTY.Icons.find.png" />
    <EmbeddedResource Include="icons\editor\*.png" LogicalName="SmarTTY.Icons.%(Filename).png" />
    <EmbeddedResource Include="icons\keys\locked.png" LogicalName="SmarTTY.Icons.key-locked.png" />
    <EmbeddedResource Include="icons\keys\unlocked.png" LogicalName="SmarTTY.Icons.key-unlocked.png" />
    <!-- Images of the device terminal tool bar. -->
    <EmbeddedResource Include="icons\terminal-disconnect.png" LogicalName="SmarTTY.Icons.terminal-disconnect.png" />
    <EmbeddedResource Include="icons\terminal-reconnect.png" LogicalName="SmarTTY.Icons.terminal-reconnect.png" />
    <EmbeddedResource Include="icons\terminal-send.png" LogicalName="SmarTTY.Icons.terminal-send.png" />
    <EmbeddedResource Include="icons\terminal-clear.png" LogicalName="SmarTTY.Icons.terminal-clear.png" />
    <EmbeddedResource Include="icons\terminal-transfer.png" LogicalName="SmarTTY.Icons.terminal-transfer.png" />
    <EmbeddedResource Include="icons\terminal-save.png" LogicalName="SmarTTY.Icons.terminal-save.png" />
    <EmbeddedResource Include="icons\terminal-settings.png" LogicalName="SmarTTY.Icons.terminal-settings.png" />
    <!-- The picture of the "connection closed" prompt, the same one as in the prompt of an SSH session. -->
    <EmbeddedResource Include="icons\MainWindow\busy.png" LogicalName="SmarTTY.Icons.busy.png" />
    <Resource Include="icons\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Controls\RemoteFileEditor.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Ssh\Connection\SshConnector.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Terminal\TerminalEventDispatcher.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Ssh\Connection\SshConnector.Designer.cs">
      <DependentUpon>SshConnector.cs</DependentUpon>
    </Compile>
    <Compile Update="Terminal\TerminalEventDispatcher.Designer.cs">
      <DependentUpon>TerminalEventDispatcher.cs</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
