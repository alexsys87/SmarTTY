<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Drives the real hex editor control (Controls/HexEditorControl.cs) through its keys and its public methods and compares what it does (the caret,
    the selection, the bytes, the undo history, the events) with HexEditorControlGolden.txt, which the code wrote before its editing logic moved to
    TextEditing/HexEditingModel.cs (the file is never written again). It is a .NET Framework 4.8 WinForms program, so on Linux it is built with the
    .NET SDK and run by Mono under a virtual X display:

      dotnet build tests/HexEditorControlTests -c Release
      xvfb-run -a mono tests/HexEditorControlTests/bin/Release/net48/HexEditorControlTests.exe
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS0197;CS1690;CS0108;CS0109;CS0618</NoWarn>
    <RootNamespace>SmarTTY</RootNamespace>
    <SmarTTYProjectFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../SmarTTY.csproj'))</SmarTTYProjectFile>
    <SmarTTYProjectText>$([System.IO.File]::ReadAllText('$(SmarTTYProjectFile)'))</SmarTTYProjectText>
    <SmarTTY_SshNetVersion>$([System.Text.RegularExpressions.Regex]::Match('$(SmarTTYProjectText)', 'Include="SSH\.NET"\s+Version="([^"]+)"').Groups[1].Value)</SmarTTY_SshNetVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <None Include="HexEditorControlGolden.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('HexEditorControlGolden.txt')" />
    <!-- Used by the themed controls (RemoteFileEditorPanel, ThemedToolStripRenderer); plain code, unlike the rest of GUI/. -->
    <Compile Include="../../GUI/Styles/ThemeManager.cs" />
    <!-- Used by VisualTTY/AppEnvironment.cs; plain code, unlike the rest of GUI/. -->
    <Compile Include="../../GUI/Backend/IFileListHost.cs" />
    <Compile Include="../../**/*.cs" Exclude="../../GUI/**;../../App.xaml.cs;../../tests/**;../../obj/**;../../bin/**;../../Properties/AssemblyInfo.cs" />
    <PackageReference Include="SSH.NET" Version="$(SmarTTY_SshNetVersion)" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
