<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Checks the colour schemes of the terminal the settings offer (VisualTTY/TerminalColorPresets): every scheme is complete and opaque,
    the names are unique and found again, the default scheme is the colours SmarTTY always had (the PuTTY palette of ConsolePalette and the
    defaults of the terminal view), and a palette is written to the XML of the settings and read back unchanged.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../VisualTTY/TerminalColorPresets.cs" Link="TerminalColorPresets.cs" />
    <Compile Include="../../VisualTTY/ConsolePalette.cs" Link="ConsolePalette.cs" />
    <Compile Include="../../Utilities/WindowChromeRules.cs" Link="WindowChromeRules.cs" />
    <Compile Include="../../Utilities/EnumDisplayText.cs" Link="EnumDisplayText.cs" />
    <Compile Include="../../Utilities/XmlStorage.cs" Link="XmlStorage.cs" />
    <Compile Include="../../VisualTTY/DeviceTerminal/RawConnectionSettings.cs" Link="RawConnectionSettings.cs" />
    <Compile Include="../../VisualTTY/DeviceTerminal/DeviceTerminalSettings.cs" Link="DeviceTerminalSettings.cs" />
    <Compile Include="../../TextEditing/RgbColor.cs" Link="RgbColor.cs" />
    <Compile Include="../../VisualTTY/DeviceTerminal/TerminalEncodings.cs" Link="TerminalEncodings.cs" />
    <Compile Include="../ConnectionLookupTests/Stubs.cs" Link="Stubs.cs" />
  </ItemGroup>
</Project>
