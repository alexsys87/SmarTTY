<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The snippet editor rules (Utilities/SnippetRules.cs) the themed window is built on: the line-break
         normalisation, the name trimming and the acceptance rule. They have no UI dependency, so this harness
         can link and exercise them. -->
    <Compile Include="../../Utilities/SnippetRules.cs" Link="SnippetRules.cs" />
  </ItemGroup>
</Project>
