<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the real remote file editor (Controls/RemoteFileEditor.cs) against the test SSH servers of tests/SshNetIntegrationTests (OpenSSH and
    Dropbear with BusyBox ash): the file is loaded, changed, saved and read back from the server, and the questions the editor asks are
    answered by the checks. It is a .NET Framework 4.8 WinForms program, so on Linux it is built with the .NET SDK and run by Mono under a
    virtual X display (Mono also needs its code page tables for the encodings: libmono-i18n4.0-all):

      dotnet build tests/RemoteFileEditorIntegrationTests -c Release
      xvfb-run -a mono tests/RemoteFileEditorIntegrationTests/bin/Release/net48/RemoteFileEditorIntegrationTests.exe

    On a machine without IPv6 (a container) Mono cannot open its dual-mode sockets: gcc -shared -fPIC -o shim.so mono-ipv4-shim.c -ldl
    and LD_PRELOAD=shim.so make it use IPv4. The WPF part of the application (GUI/) is not compiled in.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS0197;CS1690;CS0108;CS0109;CS0618</NoWarn>
    <RootNamespace>SmarTTY</RootNamespace>
    <SmarTTYProjectFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../SmarTTY.csproj'))</SmarTTYProjectFile>
    <SmarTTYProjectText>$([System.IO.File]::ReadAllText('$(SmarTTYProjectFile)'))</SmarTTYProjectText>
    <SmarTTY_SshNetVersion>$([System.Text.RegularExpressions.Regex]::Match('$(SmarTTYProjectText)', 'Include="SSH\.NET"\s+Version="([^"]+)"').Groups[1].Value)</SmarTTY_SshNetVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="TestTextView.cs" />
    <!-- The hex view the stand gives the editor: the one the replay of the hex control stand runs on (the WinForms control is gone, 3E-5). -->
    <Compile Include="../HexEditorModelSnapshots/HexReplayView.cs" Link="HexReplayView.cs" />
    <Compile Include="../HexEditorModelSnapshots/HexReplayInspector.cs" Link="HexReplayInspector.cs" />
    <!-- Used by VisualTTY/AppEnvironment.cs; plain code, unlike the rest of GUI/. -->
    <Compile Include="../../GUI/Backend/IFileListHost.cs" />
    <Compile Include="../../**/*.cs" Exclude="../../GUI/**;../../App.xaml.cs;../../tests/**;../../obj/**;../../bin/**;../../Properties/AssemblyInfo.cs" />
    <PackageReference Include="SSH.NET" Version="$(SmarTTY_SshNetVersion)" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
