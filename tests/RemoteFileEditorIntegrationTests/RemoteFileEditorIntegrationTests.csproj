<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the real remote file editor (Controls/RemoteFileEditor.cs) against the test SSH servers of tests/SshNetIntegrationTests (OpenSSH and
    Dropbear with BusyBox ash): the file is loaded, changed, saved and read back from the server, and the questions the editor asks are
    answered by the checks. It is a console program on the .NET of the application, built and run on any machine with dotnet run (project
    tests/RemoteFileEditorIntegrationTests, configuration Release) once the servers are up. It compiles all the code of the application but
    the WPF part (GUI/, App.xaml.cs), so that code must build without Windows; the one Windows-only class the editor uses, the DPAPI
    protector of the drafts, is replaced by TestDraftProtector.cs. It ran on Mono as a .NET Framework 4.8 WinForms program until then.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS0197;CS1690;CS0108;CS0109;CS0618</NoWarn>
    <RootNamespace>SmarTTY</RootNamespace>
    <SmarTTYProjectFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../SmarTTY.csproj'))</SmarTTYProjectFile>
    <SmarTTYProjectText>$([System.IO.File]::ReadAllText('$(SmarTTYProjectFile)'))</SmarTTYProjectText>
    <SmarTTY_SshNetVersion>$([System.Text.RegularExpressions.Regex]::Match('$(SmarTTYProjectText)', 'Include="SSH\.NET"\s+Version="([^"]+)"').Groups[1].Value)</SmarTTY_SshNetVersion>
    <SmarTTY_PortsVersion>$([System.Text.RegularExpressions.Regex]::Match('$(SmarTTYProjectText)', 'Include="System\.IO\.Ports"\s+Version="([^"]+)"').Groups[1].Value)</SmarTTY_PortsVersion>
    <SmarTTY_ProtectedDataVersion>$([System.Text.RegularExpressions.Regex]::Match('$(SmarTTYProjectText)', 'Include="System\.Security\.Cryptography\.ProtectedData"\s+Version="([^"]+)"').Groups[1].Value)</SmarTTY_ProtectedDataVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="TestTextView.cs" />
    <Compile Include="TestUiThread.cs" />
    <Compile Include="TestDraftProtector.cs" />
    <!-- The hex view the stand gives the editor: the one the replay of the hex control stand runs on (the WinForms control is gone, 3E-5). -->
    <Compile Include="../HexEditorModelSnapshots/HexReplayView.cs" Link="HexReplayView.cs" />
    <Compile Include="../HexEditorModelSnapshots/HexReplayInspector.cs" Link="HexReplayInspector.cs" />
    <!-- Used by VisualTTY/AppEnvironment.cs; plain code, unlike the rest of GUI/. -->
    <Compile Include="../../GUI/Backend/IFileListHost.cs" />
    <Compile Include="../../**/*.cs" Exclude="../../GUI/**;../../App.xaml.cs;../../IO/DpapiDraftProtector.cs;../../tests/**;../../obj/**;../../bin/**;../../Properties/AssemblyInfo.cs" />
    <PackageReference Include="SSH.NET" Version="$(SmarTTY_SshNetVersion)" />
    <PackageReference Include="System.IO.Ports" Version="$(SmarTTY_PortsVersion)" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="$(SmarTTY_ProtectedDataVersion)" />
  </ItemGroup>

</Project>
