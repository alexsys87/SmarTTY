<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The paste confirmation rules (Utilities/PasteConfirmRules.cs) the themed window is built on: the caption,
         the warning line and which answer Enter reaches. They have no UI dependency, so this harness can link and
         exercise them. -->
    <Compile Include="../../Utilities/PasteConfirmRules.cs" Link="PasteConfirmRules.cs" />
  </ItemGroup>
</Project>
