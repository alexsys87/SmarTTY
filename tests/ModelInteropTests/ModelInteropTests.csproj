<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Checks the model types against the WinForms and GDI+ types they copy: every member of the Keys enumeration (as KeysGolden.txt
    has them, recorded from the WinForms of .NET Framework while this stand ran on Mono) has a member of VirtualKey with the same
    name and value and vice versa, a key stroke reads its key code and modifiers as the key events did, and the colour numbers that
    stand for the named GDI+ colours in the defaults of the settings (stage 5C) are those colours (System.Drawing.Color of .NET).
    It reads those source files. Run it with dotnet run (project tests/ModelInteropTests, configuration Release).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../TextEditing/RgbColor.cs" Link="RgbColor.cs" />
    <Compile Include="../../TextEditing/GridPoint.cs" Link="GridPoint.cs" />
    <Compile Include="../../TextEditing/VirtualKey.cs" Link="VirtualKey.cs" />
    <Compile Include="../../TextEditing/KeyStroke.cs" Link="KeyStroke.cs" />
    <Compile Include="../../TextEditing/HighlightStyle.cs" Link="HighlightStyle.cs" />
    <Compile Include="../../CodeEditing/KeyBindingMap.cs" Link="KeyBindingMap.cs" />
    <Compile Include="../../CodeEditing/EditorCommands.cs" Link="EditorCommands.cs" />
    <Compile Include="../../CodeEditing/IEditorCommandTarget.cs" Link="IEditorCommandTarget.cs" />
  </ItemGroup>

</Project>
