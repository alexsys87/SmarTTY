<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The progress window rules (Utilities/PasteProgressRules.cs) the themed window is built on: the bar value and
         where the window sits over the terminal. They have no UI dependency, so this harness can link and exercise
         them. -->
    <Compile Include="../../Utilities/PasteProgressRules.cs" Link="PasteProgressRules.cs" />
  </ItemGroup>
</Project>
