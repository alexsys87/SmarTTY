<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../TextEditing/ILineCollection.cs" Link="ILineCollection.cs" />
    <Compile Include="../../TextEditing/ITextSource.cs" Link="ITextSource.cs" />
    <Compile Include="../../TextEditing/TextDocument.cs" Link="TextDocument.cs" />
    <Compile Include="../../TextEditing/MutableTextDocument.cs" Link="MutableTextDocument.cs" />
    <Compile Include="../../TextEditing/EditableTextDocument.cs" Link="EditableTextDocument.cs" />
    <Compile Include="../../CodeEditing/TokenCache.cs" Link="TokenCache.cs" />
    <Compile Include="../../CodeEditing/SyntaxHighlighting.cs" Link="SyntaxHighlighting.cs" />
    <Compile Include="../../CodeEditing/SyntaxHighlighting.AdminFormats.cs" Link="SyntaxHighlighting.AdminFormats.cs" />
    <Compile Include="../../CodeEditing/SyntaxHighlighting.LinuxFormats.cs" Link="SyntaxHighlighting.LinuxFormats.cs" />
    <Compile Include="../../CodeEditing/CommentStyle.cs" Link="CommentStyle.cs" />
    <Compile Include="../../CodeEditing/LineWrapper.cs" Link="LineWrapper.cs" />
    <Compile Include="../../CodeEditing/FoldedLineInfo.cs" Link="FoldedLineInfo.cs" />
    <Compile Include="../../CodeEditing/FoldingManager.cs" Link="FoldingManager.cs" />
    <Compile Include="../../CodeEditing/ITextFolds.cs" Link="ITextFolds.cs" />
    <None Include="FoldingGolden.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
