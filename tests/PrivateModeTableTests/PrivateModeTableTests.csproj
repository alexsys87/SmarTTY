<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Terminal/PrivateModeTable.cs" Link="PrivateModeTable.cs" />
    <!-- The emulator is read as text: it must reach the modes only through the table. -->
    <AssemblyMetadata Include="EmulatorSource" Value="$(MSBuildProjectDirectory)/../../Controls/TerminalEmulatorControl.cs" />
    <!-- ...and so is the emulator that carries out the escape sequences (since stage 1B, B4c-1) -->
    <AssemblyMetadata Include="ParserSource" Value="$(MSBuildProjectDirectory)/../../Terminal/Emulation/TerminalEmulator.cs" />
    <!-- ...and so is the class that holds the modes (the reset clears the table there since stage 1B, B4b). -->
    <AssemblyMetadata Include="ModesSource" Value="$(MSBuildProjectDirectory)/../../Terminal/Emulation/TerminalModes.cs" />
  </ItemGroup>
</Project>
