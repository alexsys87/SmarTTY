<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Terminal/PrivateModeTable.cs" Link="PrivateModeTable.cs" />
    <!-- The emulator is read as text: it must reach the modes only through the table. -->
    <AssemblyMetadata Include="EmulatorSource" Value="$(MSBuildProjectDirectory)/../../Controls/TerminalEmulatorControl.cs" />
  </ItemGroup>
</Project>
