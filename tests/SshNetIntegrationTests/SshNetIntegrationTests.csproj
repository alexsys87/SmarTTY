<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>SmarTTY.Ssh.Tests</RootNamespace>
    <AssemblyName>SshNetIntegrationTests</AssemblyName>
    <!-- RsaSshKey.cs uses the Windows CSP, OpenSshKeyPair.cs CNG and DpapiPrivateKeyFile.cs DPAPI; the linked production
         sources also compile on non-Windows test runners. -->
    <NoWarn>$(NoWarn);CA1416;CS0649</NoWarn>
    <!--
      SmarTTY.csproj is the single place that declares the SSH.NET version, so the tests always
      run against the same library as the application instead of a copy that can drift.
    -->
    <SmarTTYProjectFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../SmarTTY.csproj'))</SmarTTYProjectFile>
    <SmarTTYProjectText>$([System.IO.File]::ReadAllText('$(SmarTTYProjectFile)'))</SmarTTYProjectText>
    <SmarTTY_SshNetVersion>$([System.Text.RegularExpressions.Regex]::Match('$(SmarTTYProjectText)', 'Include="SSH\.NET"\s+Version="([^"]+)"').Groups[1].Value)</SmarTTY_SshNetVersion>
  </PropertyGroup>

  <Target Name="EnsureSshNetVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(SmarTTY_SshNetVersion)' == ''" Text="Could not read the SSH.NET version from $(SmarTTYProjectFile)." />
  </Target>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="$(SmarTTY_SshNetVersion)" />
    <!-- Ssh/DpapiPrivateKeyFile.cs uses the Windows data protection, part of .NET Framework but a package on .NET 8. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The production SSH layer is linked directly, as in tests/CommandCompletionDatabaseTests. -->
    <Compile Include="../../Ssh/*.cs" LinkBase="Ssh" />
    <Compile Include="../../IO/DfOutputParser.cs" Link="IO/DfOutputParser.cs" />
    <Compile Include="../../IO/RemotePathUtils.cs" Link="IO/RemotePathUtils.cs" />
    <Compile Include="../../IO/PathUtils.cs" Link="IO/PathUtils.cs" />
    <Compile Include="../../IO/RemoteFileOperations.cs" Link="IO/RemoteFileOperations.cs" />
    <Compile Include="../../IO/RemoteScript.cs" Link="IO/RemoteScript.cs" />
    <Compile Include="../../IO/RemoteProcessList.cs" Link="IO/RemoteProcessList.cs" />
    <Compile Include="../../Terminal/TerminalDirectoryWatcher.cs" Link="Terminal/TerminalDirectoryWatcher.cs" />
    <Compile Include="../../Terminal/ByteColumns.cs" Link="Terminal/ByteColumns.cs" />
    <Compile Include="../../Transport/FileTransferManager.cs" Link="Transport/FileTransferManager.cs" />
    <Compile Include="../../Transport/RemoteFileTools.cs" Link="Transport/RemoteFileTools.cs" />
    <Compile Include="../../Transport/WindowsRemoteFileTools.cs" Link="Transport/WindowsRemoteFileTools.cs" />
    <Compile Include="../../Transport/WindowsRemoteFileEditing.cs" Link="Transport/WindowsRemoteFileEditing.cs" />
    <Compile Include="../../Transport/RateLimiter.cs" Link="Transport/RateLimiter.cs" />
    <Compile Include="../../Transport/TransferQueueStore.cs" Link="Transport/TransferQueueStore.cs" />
    <Compile Include="../../Utilities/EnumDisplayText.cs" Link="Utilities/EnumDisplayText.cs" />
    <Compile Include="../../Utilities/DataExtensions.cs" Link="Utilities/DataExtensions.cs" />
    <Compile Include="../../Utilities/StringUtils.cs" Link="Utilities/StringUtils.cs" />
    <Compile Include="../../Native/ReparsePoints.cs" Link="Native/ReparsePoints.cs" />
    <Compile Include="../../Sync/*.cs" LinkBase="Sync" />
    <Compile Include="../../Ssh/QuickSync/*.cs" LinkBase="Ssh/QuickSync" />
    <Compile Include="../../Terminal/LineSplitter.cs" Link="LineSplitter.cs" />
    <Compile Include="../../Terminal/Utf8StreamDecoder.cs" Link="Terminal/Utf8StreamDecoder.cs" />
    <Compile Include="../../Terminal/TextStreamDecoder.cs" Link="Terminal/TextStreamDecoder.cs" />
  </ItemGroup>

</Project>
