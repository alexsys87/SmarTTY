<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Checks the rules of the window chrome that need no window: the opacity of the windows and the title bar colours (Utilities/WindowChromeRules),
    the list of remembered window sizes (VisualTTY/WindowSizeList) and that it is written to XML and read from it, an old file without it included.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Utilities/WindowChromeRules.cs" Link="WindowChromeRules.cs" />
    <Compile Include="../../VisualTTY/WindowSizeList.cs" Link="WindowSizeList.cs" />
  </ItemGroup>
</Project>
