<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Utilities/LocalLinkPolicy.cs" Link="LocalLinkPolicy.cs" />
    <!-- The default list of link extensions is read from its source, so that the check follows the list. -->
    <AssemblyMetadata Include="SettingsSource" Value="$(MSBuildProjectDirectory)/../../VisualTTY/VirtualTerminalSettings.cs" />
  </ItemGroup>
</Project>
